@@ -738,6 +738,13 @@
         }
     }
 
+    // JitZkHandlerConv: the epilog of a method that is not a handler restores s1-s8, where the
+    // arguments of a handler travel (as in fgCanFastTailCall).
+    if (((call->gtCallMoreFlags & GTF_CALL_M_ZK_HANDLER) != 0) && !m_compiler->compZkHandlerConv)
+    {
+        return;
+    }
+
     for (unsigned lclNum = 0; lclNum < m_compiler->lvaCount; lclNum++)
     {
         const LclVarDsc* const varDsc = m_compiler->lvaGetDesc(lclNum);
@@ -1315,7 +1322,8 @@
         {
             // Stack locals are pointer-aligned; the field offset decides.
             const unsigned slotLog2 = (unsigned)BitOperations::Log2((unsigned)TARGET_POINTER_SIZE);
-            unsigned       offs     = node->AsLclFld()->GetLclOffs();
+            const LclVarDsc* varDsc = m_compiler->lvaGetDesc(node->AsLclFld());
+            unsigned offs = node->AsLclFld()->GetLclOffs() + (varDsc->lvIsStructField ? varDsc->lvFldOffset : 0);
             return (offs == 0) ? slotLog2 : min((unsigned)BitOperations::TrailingZeroCount(offs), slotLog2);
         }
 
@@ -1422,7 +1430,7 @@
 //    multiple of the access size makes the access misaligned for any aligned base - a field
 //    of a byte-aligned struct read whole, a small field read through a wider load.
 //
-static bool IsOffsetMisaligned(GenTree* addr, unsigned align)
+static bool IsOffsetMisaligned(Compiler* comp, GenTree* addr, unsigned align)
 {
     if (align <= 1)
     {
@@ -1440,7 +1448,8 @@
     }
     else if (addr->OperIs(GT_LCL_ADDR))
     {
-        offset = addr->AsLclFld()->GetLclOffs();
+        const LclVarDsc* varDsc = comp->lvaGetDesc(addr->AsLclFld());
+        offset = addr->AsLclFld()->GetLclOffs() + (varDsc->lvIsStructField ? varDsc->lvFldOffset : 0);
     }
 
     return (offset & (ssize_t)(align - 1)) != 0;
@@ -2648,7 +2657,7 @@
         blkNode->gtFlags |= GTF_IND_UNALIGNED;
     }
 
-    if (RiscV64TrustedAlign() && IsOffsetMisaligned(addr, RiscV64BlockAlignment(size)))
+    if (RiscV64TrustedAlign() && IsOffsetMisaligned(m_compiler, addr, RiscV64BlockAlignment(size)))
     {
         blkNode->gtFlags |= GTF_IND_UNALIGNED;
     }
@@ -3270,7 +3279,7 @@
         }
     }
     else if (RiscV64TrustedAlign() && indirNode->OperIs(GT_IND, GT_STOREIND) &&
-             IsOffsetMisaligned(indirNode->Addr(), genTypeSize(indirNode->TypeGet())))
+             IsOffsetMisaligned(m_compiler, indirNode->Addr(), genTypeSize(indirNode->TypeGet())))
