diff --git a/src/coreclr/jit/targetriscv64.cpp b/src/coreclr/jit/targetriscv64.cpp
--- a/src/coreclr/jit/targetriscv64.cpp
+++ b/src/coreclr/jit/targetriscv64.cpp
@@ -146,13 +146,15 @@
     else
     {
         // Integer calling convention
-        auto passOnStack = [this, type](unsigned offset, unsigned size) -> ABIPassingSegment {
+        auto passOnStack = [this, type, comp, structLayout](unsigned offset, unsigned size) -> ABIPassingSegment {
             assert(size > 0);
             assert(size <= 2 * TARGET_POINTER_SIZE);
             assert((m_stackArgSize % TARGET_POINTER_SIZE) == 0);
 #ifndef TARGET_64BIT
-            // ilp32: a 2*XLEN scalar passed wholly on the stack is aligned to its size.
-            if ((offset == 0) && (size == 2 * TARGET_POINTER_SIZE) && !varTypeIsStruct(type))
+            // ilp32: a 2*XLEN scalar passed wholly on the stack is aligned to its size, and so is a
+            // struct with a field of that alignment.
+            if ((offset == 0) && (size == 2 * TARGET_POINTER_SIZE) &&
+                (!varTypeIsStruct(type) || (structLayout->GetAlignmentRequirement(comp) > TARGET_POINTER_SIZE)))
             {
                 m_stackArgSize = roundUp(m_stackArgSize, 2 * TARGET_POINTER_SIZE);
             }
