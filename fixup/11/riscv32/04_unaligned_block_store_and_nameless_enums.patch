+        // A build without the reflection execution domain (bflat --no-reflection) has no enum metadata: describe the
+        // enum by its underlying type alone, so formatting falls back to the numeric value instead of failing fast.
+        private static EnumInfo GetNamelessEnumInfo(RuntimeType enumType) => InternalGetCorElementType(enumType) switch
+        {
+            CorElementType.ELEMENT_TYPE_I1 => new EnumInfo<byte>(typeof(sbyte), [], [], false),
+            CorElementType.ELEMENT_TYPE_U1 => new EnumInfo<byte>(typeof(byte), [], [], false),
+            CorElementType.ELEMENT_TYPE_BOOLEAN => new EnumInfo<byte>(typeof(bool), [], [], false),
+            CorElementType.ELEMENT_TYPE_I2 => new EnumInfo<ushort>(typeof(short), [], [], false),
+            CorElementType.ELEMENT_TYPE_U2 => new EnumInfo<ushort>(typeof(ushort), [], [], false),
+            CorElementType.ELEMENT_TYPE_CHAR => new EnumInfo<ushort>(typeof(char), [], [], false),
+            CorElementType.ELEMENT_TYPE_I4 => new EnumInfo<uint>(typeof(int), [], [], false),
+            CorElementType.ELEMENT_TYPE_U4 => new EnumInfo<uint>(typeof(uint), [], [], false),
+            CorElementType.ELEMENT_TYPE_I8 => new EnumInfo<ulong>(typeof(long), [], [], false),
+            CorElementType.ELEMENT_TYPE_U8 => new EnumInfo<ulong>(typeof(ulong), [], [], false),
+            CorElementType.ELEMENT_TYPE_I => IntPtr.Size == 8 ? new EnumInfo<ulong>(typeof(nint), [], [], false) : new EnumInfo<uint>(typeof(nint), [], [], false),
+            _ => IntPtr.Size == 8 ? new EnumInfo<ulong>(typeof(nuint), [], [], false) : new EnumInfo<uint>(typeof(nuint), [], [], false),
+        };
