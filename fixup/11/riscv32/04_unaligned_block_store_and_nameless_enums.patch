diff --git a/src/coreclr/jit/lower.cpp b/src/coreclr/jit/lower.cpp
index ac40fdfd8f0..5974aa14e12 100644
--- a/src/coreclr/jit/lower.cpp
+++ b/src/coreclr/jit/lower.cpp
@@ -13152,7 +13152,11 @@ bool Lowering::TryTransformStoreObjAsStoreInd(GenTreeBlk* blkNode)
     }
 
     JITDUMP("Replacing STORE_BLK with STOREIND for [%06u]\n", blkNode->gtTreeID);
+    // ChangeOper keeps only the common flags, and an unaligned block store must stay unaligned: a target without
+    // unaligned access (JitNoUnalignedAccess) expands the scalar store as it does the load it copies.
+    const GenTreeFlags unaligned = blkNode->gtFlags & GTF_IND_UNALIGNED;
     blkNode->ChangeOper(GT_STOREIND);
+    blkNode->gtFlags |= unaligned;
     blkNode->ChangeType(regType);
 
 #if defined(TARGET_XARCH)
