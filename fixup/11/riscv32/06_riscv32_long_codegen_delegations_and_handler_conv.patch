+#ifdef TARGET_RISCV32
+//------------------------------------------------------------------------
+// SplitAddressForHalves: For an address `base + constant`, makes the base a local and returns the
+// constant, so the low half keeps the address and the high half can take the base at constant + 4:
+// both offsets then fold into the loads or stores rather than the address being computed into a
+// register first.
+//
+// Arguments:
+//    indir - the GT_IND or GT_STOREIND whose address is split
+//    offset - receives the constant
+//
+// Return Value:
+//    The base local node, or nullptr when the address is not of that shape.
+//
+GenTree* DecomposeLongs::SplitAddressForHalves(GenTree* indir, int* offset)
+{
+    GenTree*  addr = indir->AsIndir()->Addr();
+    GenTree** baseEdge;
+    ssize_t   constant;
+    if (addr->OperIs(GT_LCL_VAR))
+    {
+        // Already a local: the halves read it at offsets 0 and 4, with no copy.
+        *offset = 0;
+        return addr;
+    }
+    if (addr->OperIs(GT_ADD) && addr->gtGetOp2()->IsCnsIntOrI() &&
+        !addr->gtGetOp2()->AsIntCon()->ImmedValNeedsReloc(m_compiler))
+    {
+        baseEdge = &addr->AsOp()->gtOp1;
+        constant = addr->gtGetOp2()->AsIntCon()->IconValue();
+    }
+    else if (addr->OperIs(GT_LEA) && !addr->AsAddrMode()->HasIndex() && addr->AsAddrMode()->HasBase())
+    {
+        baseEdge = &addr->AsAddrMode()->Base();
+        constant = addr->AsAddrMode()->Offset();
+    }
+    else
+    {
+        return nullptr;
+    }
+
+    if (!emitter::isValidSimm12(constant) || !emitter::isValidSimm12(constant + genTypeSize(TYP_INT)) ||
+        (varTypeIsGC(*baseEdge) != varTypeIsGC(addr)))
+    {
+        return nullptr;
+    }
+
+    if (!(*baseEdge)->OperIs(GT_LCL_VAR))
+    {
+        LIR::Use baseUse(Range(), baseEdge, addr);
+        baseUse.ReplaceWithLclVar(m_compiler);
+    }
+    *offset = (int)constant;
+    return *baseEdge;
+}
+#endif // TARGET_RISCV32
