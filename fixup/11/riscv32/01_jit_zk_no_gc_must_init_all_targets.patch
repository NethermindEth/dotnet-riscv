@@ -580,6 +575,12 @@ RELEASE_CONFIG_INTEGER(JitZkNoGcMustInit, "JitZkNoGcMustInit", 0)
 RELEASE_CONFIG_STRING(JitZkCsrPInvokes, "JitZkCsrPInvokes")
 #endif
 
+// zkVM: non-zero zero-initializes a local or spill temp that contains GC references only when a
+// local without them would be: localsinit, a read before the first write, newobj/initobj/inlinee
+// zeroing. The other prolog zeroing of GC slots exists so that a GC never scans garbage and is
+// dropped. Valid only on a runtime that never scans stacks (a non-collecting GC). Default 0.
+RELEASE_CONFIG_INTEGER(JitZkNoGcMustInit, "JitZkNoGcMustInit", 0)
+
 RELEASE_CONFIG_INTEGER(EnableEmbeddedBroadcast,     "EnableEmbeddedBroadcast",   1) // Allows embedded broadcasts to be disabled
