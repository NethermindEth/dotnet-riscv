+// than going through a temp, which keeps the GC tracking of the register exact for a GC that scans
+// stacks. Valid only with JitZkNoGcMustInit's runtime, which never does. Default 0.
+RELEASE_CONFIG_INTEGER(JitZkNoCastAwayGcTemp, "JitZkNoCastAwayGcTemp", 0)
+
+// zkVM: forward substitution also clones a value shaped as JitZkInlineCloneCheapArgs takes into every use
