+//------------------------------------------------------------------------
+// impIsCheapLocalExpr: is `tree` at most two unaliased, non-struct locals combined with constants by adds,
+//    subtractions, products with a constant and integral casts, within `budget` nodes? See
+//    JitZkInlineCloneCheapArgs. None of these nodes has a side effect of its own.
+//
+// Arguments:
+//    tree   - the tree
+//    locals - the number of locals found so far; increased by those of the tree
+//    budget - the number of nodes left; reduced by the nodes of the tree
+//
+bool Compiler::impIsCheapLocalExpr(GenTree* tree, unsigned* locals, unsigned* budget)
+{
+    if (*budget == 0)
+    {
+        return false;
+    }
+    (*budget)--;
+
+    switch (tree->OperGet())
+    {
+        case GT_LCL_VAR:
+        {
+            const LclVarDsc* varDsc = lvaGetDesc(tree->AsLclVar());
+            if ((*locals == 2) || varTypeIsStruct(varDsc) || varTypeIsFloating(varDsc) || varDsc->lvHasLdAddrOp ||
+                varDsc->IsAddressExposed())
+            {
+                return false;
+            }
+            (*locals)++;
+            return true;
+        }
+
+        case GT_CNS_INT:
+            return !tree->IsIconHandle();
+
+        case GT_ADD:
+        case GT_SUB:
+        case GT_MUL:
+            if (tree->gtOverflow() || varTypeIsFloating(tree) ||
+                (tree->OperIs(GT_MUL) && !tree->gtGetOp1()->IsCnsIntOrI() && !tree->gtGetOp2()->IsCnsIntOrI()))
+            {
+                return false;
+            }
+            return impIsCheapLocalExpr(tree->gtGetOp1(), locals, budget) &&
+                   impIsCheapLocalExpr(tree->gtGetOp2(), locals, budget);
+
+        case GT_CAST:
+            if (tree->gtOverflow() || !varTypeIsIntegralOrI(tree) ||
+                !(varTypeIsIntegralOrI(tree->AsCast()->CastOp()) || tree->AsCast()->CastOp()->TypeIs(TYP_BYREF)) ||
+                (genTypeSize(tree) != genTypeSize(genActualType(tree->AsCast()->CastOp()))))
+            {
+                return false;
+            }
+            return impIsCheapLocalExpr(tree->AsCast()->CastOp(), locals, budget);
+
+        default:
+            return false;
+    }
+}
