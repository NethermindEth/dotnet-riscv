+#ifdef TARGET_RISCV
+//------------------------------------------------------------------------
+// fgForwardSubCheapToBlockUses: JitZkForwardSubCheap - clone the value `stmt` stores to a local into
+//   every use of that local, when the value is cheap (see impIsCheapLocalExpr) and every use follows
+//   in `block`.
+//
+// Arguments:
+//    block - the block of the statement
+//    stmt  - the statement, a store to a local
+//
+// Return Value:
+//    true if the uses were substituted; the caller removes the statement.
+//
+// Notes:
+//    The local must not be live out of the block or stored again in it, and no statement between the
+//    store and the last use may store to a local of the value. The locals of the value may now be used
+//    past a node early liveness marked as their last use, so those marks are cleared over the range.
+//
+bool Compiler::fgForwardSubCheapToBlockUses(BasicBlock* block, Statement* stmt)
+{
+    GenTree* const defNode = stmt->GetRootNode();
+    if (!defNode->OperIs(GT_STORE_LCL_VAR))
+    {
+        return false;
+    }
+
+    unsigned const   lclNum = defNode->AsLclVarCommon()->GetLclNum();
+    LclVarDsc* const varDsc = lvaGetDesc(lclNum);
+    if (varDsc->lvPinned || varDsc->IsAddressExposed() || varDsc->lvPromoted || varDsc->lvIsStructField ||
+        varTypeIsStruct(varDsc) || varTypeIsSmall(varDsc) || !varDsc->lvTracked || lvaIsImplicitByRefLocal(lclNum) ||
+        VarSetOps::IsMember(this, block->bbLiveOut, varDsc->lvVarIndex))
+    {
+        return false;
+    }
+
+    GenTree* const value  = defNode->AsLclVarCommon()->Data();
+    unsigned       locals = 0;
+    unsigned       budget = 10;
+    if ((genActualType(defNode->TypeGet()) != genActualType(value->TypeGet())) ||
+        !impIsCheapLocalExpr(value, &locals, &budget) || (locals == 0))
+    {
+        return false;
+    }
+
+    unsigned valueLcls[2];
+    unsigned valueLclCount = 0;
+    for (GenTreeLclVarCommon* lcl : stmt->LocalsTreeList())
+    {
+        if (lcl == defNode)
+        {
+            continue;
+        }
+        LclVarDsc* const lclDsc = lvaGetDesc(lcl);
+        if ((lcl->GetLclNum() == lclNum) || lclDsc->lvIsStructField || lclDsc->lvPromoted || (valueLclCount == 2))
+        {
+            return false;
+        }
+        valueLcls[valueLclCount++] = lcl->GetLclNum();
+    }
+
+    auto isValueLcl = [&](unsigned num) {
+        return ((valueLclCount > 0) && (valueLcls[0] == num)) || ((valueLclCount > 1) && (valueLcls[1] == num));
+    };
+
+    const unsigned maxUses     = 8;
+    unsigned       uses        = 0;
+    bool           invalidated = false;
+    Statement*     lastUseStmt = nullptr;
+    for (Statement* next = stmt->GetNextStmt(); next != nullptr; next = next->GetNextStmt())
+    {
+        bool usesLcl     = false;
+        bool storesValue = false;
+        for (GenTreeLclVarCommon* lcl : next->LocalsTreeList())
+        {
+            if (lcl->GetLclNum() == lclNum)
+            {
+                if (!lcl->OperIs(GT_LCL_VAR))
+                {
+                    return false;
+                }
+                usesLcl = true;
+                uses++;
+            }
+            else if (isValueLcl(lcl->GetLclNum()) && lcl->OperIsLocalStore())
+            {
+                storesValue = true;
+            }
+        }
+        if (usesLcl)
+        {
+            if (invalidated || storesValue || (uses > maxUses))
+            {
+                return false;
+            }
+            lastUseStmt = next;
+        }
+        invalidated |= storesValue;
+    }
+
+    if (lastUseStmt == nullptr)
+    {
+        return false;
+    }
+
+    struct UseVisitor : public GenTreeVisitor<UseVisitor>
+    {
+        enum
+        {
+            DoPreOrder = true,
+        };
+
+        unsigned m_lclNum;
+        bool     m_bail = false;
+
+        UseVisitor(Compiler* comp, unsigned lclNum)
+            : GenTreeVisitor<UseVisitor>(comp)
+            , m_lclNum(lclNum)
+        {
+        }
+
+        fgWalkResult PreOrderVisit(GenTree** use, GenTree* user)
+        {
+            GenTree* const node = *use;
+            if (node->OperIs(GT_LCL_VAR) && (node->AsLclVarCommon()->GetLclNum() == m_lclNum) && (user != nullptr) &&
+                user->IsCall() && (user->AsCall()->gtCallType == CT_INDIRECT) &&
+                (user->AsCall()->gtControlExpr == node))
+            {
+                m_bail = true;
+                return fgWalkResult::WALK_ABORT;
+            }
+            return fgWalkResult::WALK_CONTINUE;
+        }
+    };
+
+    struct ReplaceVisitor : public GenTreeVisitor<ReplaceVisitor>
+    {
+        enum
+        {
+            DoPreOrder = true,
+        };
+
+        unsigned m_lclNum;
+        GenTree* m_value;
+
+        ReplaceVisitor(Compiler* comp, unsigned lclNum, GenTree* value)
+            : GenTreeVisitor<ReplaceVisitor>(comp)
+            , m_lclNum(lclNum)
+            , m_value(value)
+        {
+        }
+
+        fgWalkResult PreOrderVisit(GenTree** use, GenTree* user)
+        {
+            GenTree* const node = *use;
+            if (node->OperIs(GT_LCL_VAR) && (node->AsLclVarCommon()->GetLclNum() == m_lclNum))
+            {
+                *use = m_compiler->gtCloneExpr(m_value);
+                return fgWalkResult::WALK_SKIP_SUBTREES;
+            }
+            return fgWalkResult::WALK_CONTINUE;
+        }
+    };
+
+    for (Statement* next = stmt->GetNextStmt();; next = next->GetNextStmt())
+    {
+        UseVisitor check(this, lclNum);
+        check.WalkTree(next->GetRootNodePointer(), nullptr);
+        if (check.m_bail)
+        {
+            return false;
+        }
+        if (next == lastUseStmt)
+        {
+            break;
+        }
+    }
+
+    JITDUMP(" [%06u] (V%02u) cloned into %u uses through " FMT_STMT " (JitZkForwardSubCheap)\n",
+            dspTreeID(defNode), lclNum, uses, lastUseStmt->GetID());
+
+    for (Statement* next = stmt->GetNextStmt();; next = next->GetNextStmt())
+    {
+        ReplaceVisitor replace(this, lclNum, value);
+        replace.WalkTree(next->GetRootNodePointer(), nullptr);
+        fgSequenceLocals(next);
+        for (GenTreeLclVarCommon* lcl : next->LocalsTreeList())
+        {
+            if (isValueLcl(lcl->GetLclNum()))
+            {
+                lcl->gtFlags &= ~GTF_VAR_DEATH;
+            }
+        }
+        gtUpdateStmtSideEffects(next);
+        DISPSTMT(next);
+        if (next == lastUseStmt)
+        {
+            break;
+        }
+    }
+
+    return true;
+}
