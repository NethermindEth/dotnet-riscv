+//------------------------------------------------------------------------
+// impNewObjInPlaceLocal: under JitZkNewObjInPlace, the IL local a struct newobj can be constructed in.
+//
+// Arguments:
+//    clsHnd   - the struct the newobj constructs
+//    nextAddr - IL after the newobj
+//    codeEndp - end of the block's IL
+//    block    - the block being imported
+//
+// Returns:
+//    The local the next instruction stores the struct to, when constructing it there instead of in a temp is
+//    unobservable; else BAD_VAR_NUM.
+//
+// Notes:
+//    The local must already have its address taken somewhere in the method, so it is not promoted either way. The
+//    constructor sees the local through 'this' only: no earlier IL takes its address (and no loop brings later IL
+//    before it), and no value on the stack, the constructor's arguments included, reads it. A method with handlers
+//    is left alone, as a constructor that throws would leave the local half written where a handler can read it.
+//
+unsigned Compiler::impNewObjInPlaceLocal(CORINFO_CLASS_HANDLE clsHnd,
+                                         const BYTE*          nextAddr,
+                                         const BYTE*          codeEndp,
+                                         BasicBlock*          block)
+{
+    if ((JitConfig.JitZkNewObjInPlace() == 0) || compIsForInlining() || opts.compDbgCode ||
+        (info.compXcptnsCount != 0) || impBlockIsInALoop(block) || (nextAddr >= codeEndp))
+    {
+        return BAD_VAR_NUM;
+    }
+
+    unsigned     ilLcl;
+    const OPCODE next = (OPCODE)nextAddr[0];
+    if ((next >= CEE_STLOC_0) && (next <= CEE_STLOC_3))
+    {
+        ilLcl = next - CEE_STLOC_0;
+    }
+    else if ((next == CEE_STLOC_S) && (nextAddr + 1 < codeEndp))
+    {
+        ilLcl = nextAddr[1];
+    }
+    else if ((next == CEE_PREFIX1) && (nextAddr + 3 < codeEndp) && (nextAddr[1] == (CEE_STLOC - 256)))
+    {
+        ilLcl = getU2LittleEndian(nextAddr + 2);
+    }
+    else
+    {
+        return BAD_VAR_NUM;
+    }
+
+    if (ilLcl >= info.compMethodInfo->locals.numArgs)
+    {
+        return BAD_VAR_NUM;
+    }
+
+    const unsigned   lclNum = info.compArgsCount + ilLcl;
+    LclVarDsc* const varDsc = lvaGetDesc(lclNum);
+    if (!varDsc->TypeIs(TYP_STRUCT) || !varDsc->lvHasLdAddrOp || varDsc->lvPinned ||
+        (varDsc->GetLayout()->GetClassHandle() != clsHnd))
+    {
+        return BAD_VAR_NUM;
+    }
+
+    for (unsigned i = 0; i < stackState.esStackDepth; i++)
+    {
+        if (gtHasRef(stackState.esStack[i].val, lclNum))
+        {
+            return BAD_VAR_NUM;
+        }
+    }
+
+    // The newobj opcode and its token precede nextAddr.
+    const BYTE* const newObjAddr = nextAddr - 1 - sizeof(mdToken);
+    for (const BYTE* addr = info.compCode; addr < newObjAddr;)
+    {
+        OPCODE opcode = (OPCODE)*addr++;
+        if (opcode == CEE_PREFIX1)
+        {
+            opcode = (OPCODE)(256 + *addr++);
+        }
+
+        if (((opcode == CEE_LDLOCA_S) && (addr[0] == ilLcl)) ||
+            ((opcode == CEE_LDLOCA) && (getU2LittleEndian(addr) == ilLcl)))
+        {
+            return BAD_VAR_NUM;
+        }
+
+        addr += (opcode == CEE_SWITCH) ? (1 + getU4LittleEndian(addr)) * sizeof(DWORD) : opcodeSizes[opcode];
+    }
+
+    JITDUMP("Constructing newobj in place in V%02u\n", lclNum);
+    return lclNum;
+}
