+//------------------------------------------------------------------------
+// IsCheapLocalAdd: is `tree` an unaliased local plus or minus a constant that fits an add immediate,
+//    possibly through a cast that keeps its size? See JitZkNoCheapAddCSE.
+//
+bool CSE_HeuristicCommon::IsCheapLocalAdd(GenTree* tree)
+{
+    if (tree->OperIs(GT_CAST))
+    {
+        GenTree* op = tree->AsCast()->CastOp();
+        if (tree->gtOverflow() || (genTypeSize(tree) != genTypeSize(genActualType(op))))
+        {
+            return false;
+        }
+        tree = op;
+    }
+    if (!tree->OperIs(GT_ADD, GT_SUB) || tree->gtOverflow() ||
+        (!varTypeIsIntegralOrI(genActualType(tree)) && !tree->TypeIs(TYP_BYREF)))
+    {
+        return false;
+    }
+    GenTree* lcl = tree->gtGetOp1();
+    GenTree* cns = tree->gtGetOp2();
+    if (lcl->IsCnsIntOrI() && tree->OperIs(GT_ADD))
+    {
+        std::swap(lcl, cns);
+    }
+    return lcl->OperIs(GT_LCL_VAR) && !m_compiler->lvaGetDesc(lcl->AsLclVar())->IsAddressExposed() &&
+           cns->IsCnsIntOrI() && !cns->IsIconHandle() && emitter::isValidSimm12(cns->AsIntCon()->IconValue());
+}
+#endif
