diff --git a/eng/native/configurecompiler.cmake b/eng/native/configurecompiler.cmake
index 8475e3529..d1e1db1a0 100644
--- a/eng/native/configurecompiler.cmake
+++ b/eng/native/configurecompiler.cmake
@@ -984,6 +984,14 @@ if(CLR_CMAKE_HOST_UNIX_RISCV64 OR CLR_CMAKE_HOST_UNIX_RISCV32)
   add_link_options(-march=${CLR_CMAKE_RISCV64_MARCH})
   add_link_options(-mabi=${CLR_CMAKE_RISCV64_MABI})
 
+  # riscv32 has no compressed instructions, so code must stay 4-byte aligned. With linker
+  # relaxation the assembler leaves the alignment of each function to R_RISCV_ALIGN padding
+  # that only a relaxing final link trims, and the `ld -r` of Runtime.PrivateLibunwind.o
+  # keeps it untrimmed: a function there started 2 bytes past a word boundary.
+  if(CLR_CMAKE_HOST_UNIX_RISCV32)
+    add_compile_options(-mno-relax)
+  endif()
+
   # musl built for lp64 installs its loader as ld-musl-riscv64-sf.so.1, and clang
   # only derives that name from -mabi from LLVM 23 on; older drivers give an lp64
   # executable the lp64d loader, which a soft-float userspace does not have.
