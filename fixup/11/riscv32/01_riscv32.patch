+.macro GetThreadA2
+    addi  sp, sp, -16
+    sw    a0, 0(sp)
+    sw    a1, 4(sp)
+    call  C_FUNC(RhpGetThread)
+    mv    a2, a0
+    lw    a0, 0(sp)
+    lw    a1, 4(sp)
+    addi  sp, sp, 16
+.endm
+
+// Clears (ClearFlag != 0) or sets the given bits of Thread::m_ThreadStateFlags.
+// No A extension: a plain read-modify-write.
+.macro UPDATE_THREAD_STATE_FLAGS threadReg, maskReg, trashReg, ClearFlag
+#ifdef __riscv_atomic
+    addi  \trashReg, \threadReg, OFFSETOF__Thread__m_ThreadStateFlags
+    .if \ClearFlag
+        amoand.w  zero, \maskReg, (\trashReg)
+    .else
+        amoor.w   zero, \maskReg, (\trashReg)
+    .endif
+#else
+    lw    \trashReg, OFFSETOF__Thread__m_ThreadStateFlags(\threadReg)
+    .if \ClearFlag
+        and   \trashReg, \trashReg, \maskReg
+    .else
+        or    \trashReg, \trashReg, \maskReg
+    .endif
+    sw    \trashReg, OFFSETOF__Thread__m_ThreadStateFlags(\threadReg)
+#endif
+.endm
+
+#define rsp_offsetof_ExInfo  0
+#define rsp_offsetof_Context STACKSIZEOF_ExInfo
+
+//
+// RhpThrowHwEx
+//
+// INPUT:  a0[31:0]:  exception code of fault
+//         a1:  faulting IP
+//
+// OUTPUT:
+//
+
+    NESTED_ENTRY RhpThrowHwEx, _TEXT, NoHandler
+
+        ALLOC_THROW_FRAME HARDWARE_EXCEPTION
+
+        GetThreadA2
+
+        // Compute address for ExInfo*
+        addi   a1, sp, rsp_offsetof_ExInfo              // a1 <- ExInfo*
+        sw     zero, OFFSETOF__ExInfo__m_exception(a1)  // pExInfo->m_exception = null
+        li     a3, 1
+        sb     a3, OFFSETOF__ExInfo__m_passNumber(a1)   // pExInfo->m_passNumber = 1
+        li     a3, -1
+        sw     a3, OFFSETOF__ExInfo__m_idxCurClause(a1) // pExInfo->m_idxCurClause = MaxTryRegionIdx
+        li     a3, 2
+        sb     a3, OFFSETOF__ExInfo__m_kind(a1)         // pExInfo->m_kind = ExKind.HardwareFault
+
+        // Link the ExInfo into the thread's ExInfo chain
+        lw     a3, OFFSETOF__Thread__m_pExInfoStackHead(a2)
+        sw     a3, OFFSETOF__ExInfo__m_pPrevExInfo(a1)       // pExInfo->m_pPrevExInfo = m_pExInfoStackHead
+        sw     a1, OFFSETOF__Thread__m_pExInfoStackHead(a2)  // m_pExInfoStackHead = pExInfo
+
+        // Set the exception context field on the ExInfo
+        addi   a2, sp, rsp_offsetof_Context                  // a2 <- PAL_LIMITED_CONTEXT*
+        sw     a2, OFFSETOF__ExInfo__m_pExContext(a1)        // pExInfo->m_pExContext = pContext
+
+        // a0[31:0]: exception code
+        // a1: ExInfo*
+        call  C_FUNC(RhThrowHwEx)
+
+    ALTERNATE_ENTRY RhpThrowHwEx2
+
+        // No return
+        EMIT_BREAKPOINT
+
+    NESTED_END RhpThrowHwEx, _TEXT
+
+//
+// RhpThrowExact
+//
+// SUMMARY: Similar to RhpThrowEx, except that it sets the rethrow flag
+//
+// INPUT:  a0:  exception object
+//
+
+    LEAF_ENTRY RhpThrowExact, _TEXT
+
+        li  a4, 4                                       // a4 = ExKind.RethrowFlag
+        j   C_FUNC(RhpThrowImpl)
+
+    LEAF_END RhpThrowExact, _TEXT
+
+//
+// RhpThrowEx
+//
+// INPUT:  a0:  exception object
+//
+
+    LEAF_ENTRY RhpThrowEx, _TEXT
+
+        li  a4, 1                                       // a4 = ExKind.Throw
+        j   C_FUNC(RhpThrowImpl)
+
+    LEAF_END RhpThrowEx, _TEXT
+
+    NESTED_ENTRY RhpThrowImpl, _TEXT, NoHandler
+
+        ALLOC_THROW_FRAME SOFTWARE_EXCEPTION
+        mv  s1, a4                                      // Save ExKind
+
+        GetThreadA2
+
+        lw   a1, OFFSETOF__Thread__m_pvHijackedReturnAddress(a2)
+        beq  a1, zero, LOCAL_LABEL(NotHijacked)
+
+        lw   a3, OFFSETOF__Thread__m_ppvHijackedReturnAddressLocation(a2)
+
+        // Recompute SP at callsite
+        addi  t3, sp, (STACKSIZEOF_ExInfo + THROW_FRAME_CONTEXT_SIZE)
+        bltu  a3, t3, LOCAL_LABEL(TailCallWasHijacked) // if (m_ppvHijackedReturnAddressLocation < SP at callsite)
+
+        // Normal case where a valid return address location is hijacked
+        sw    a1, 0(a3)
+        j     LOCAL_LABEL(ClearThreadState)
+
+LOCAL_LABEL(TailCallWasHijacked):
+
+        // Abnormal case where the return address location is now invalid because we ended up here via a tail
+        // call. In this case, our hijacked return address should be the correct caller of this method.
+
+        // Stick the previous return address in RA as well as in the right spots in our PAL_LIMITED_CONTEXT.
+        mv  ra, a1
+
+        sw  ra, (rsp_offsetof_Context + OFFSETOF__PAL_LIMITED_CONTEXT__RA)(sp)
+        sw  ra, (rsp_offsetof_Context + OFFSETOF__PAL_LIMITED_CONTEXT__IP)(sp)
+
+LOCAL_LABEL(ClearThreadState):
+
+        // Clear the Thread's hijack state
+        sw  zero, OFFSETOF__Thread__m_ppvHijackedReturnAddressLocation(a2)
+        sw  zero, OFFSETOF__Thread__m_pvHijackedReturnAddress(a2)
+
+LOCAL_LABEL(NotHijacked):
+
+        // Compute the offset for ExInfo
+        addi   a1, sp, rsp_offsetof_ExInfo              // a1 <- ExInfo*
+        sw     zero, OFFSETOF__ExInfo__m_exception(a1)  // pExInfo->m_exception = null
+        li     a3, 1
+        sb     a3, OFFSETOF__ExInfo__m_passNumber(a1)   // pExInfo->m_passNumber = 1
+        li     a3, -1
+        sw     a3, OFFSETOF__ExInfo__m_idxCurClause(a1) // pExInfo->m_idxCurClause = MaxTryRegionIdx
+        sb     s1, OFFSETOF__ExInfo__m_kind(a1)         // pExInfo->m_kind = ExKind
+
+        // Link the ExInfo into the thread's ExInfo chain
+        lw  a3, OFFSETOF__Thread__m_pExInfoStackHead(a2)
+        sw  a3, OFFSETOF__ExInfo__m_pPrevExInfo(a1)      // pExInfo->m_pPrevExInfo = m_pExInfoStackHead
+        sw  a1, OFFSETOF__Thread__m_pExInfoStackHead(a2) // m_pExInfoStackHead = pExInfo
+
+        // Set the exception context field on the ExInfo
+        addi  a2, sp, rsp_offsetof_Context           // a2 <- PAL_LIMITED_CONTEXT*
+        sw    a2, OFFSETOF__ExInfo__m_pExContext(a1) // pExInfo->m_pExContext = pContext
+
+        // a0: exception object
+        // a1: ExInfo*
+        call C_FUNC(RhThrowEx)
+
+    ALTERNATE_ENTRY RhpThrowImpl2
+
+        // No return
+        EMIT_BREAKPOINT
+
+    NESTED_END RhpThrowImpl, _TEXT
+
+//
+// void FASTCALL RhpRethrow()
+//
+// SUMMARY: Similar to RhpThrowEx, except that it passes along the currently active ExInfo
+//
+
+    NESTED_ENTRY RhpRethrow, _TEXT, NoHandler
+
+        ALLOC_THROW_FRAME SOFTWARE_EXCEPTION
+
+        GetThreadA2
+
+        addi  a1, sp, rsp_offsetof_ExInfo               // a1 <- ExInfo*
+        sw  zero, OFFSETOF__ExInfo__m_exception(a1)     // pExInfo->m_exception = null
+        sb  zero, OFFSETOF__ExInfo__m_kind(a1)          // init to a deterministic value (ExKind.None)
+        li  a3, 1
+        sb  a3, OFFSETOF__ExInfo__m_passNumber(a1)      // pExInfo->m_passNumber = 1
+        li  a3, -1
+        sw  a3, OFFSETOF__ExInfo__m_idxCurClause(a1)    // pExInfo->m_idxCurClause = MaxTryRegionIdx
+
+        // link the ExInfo into the thread's ExInfo chain
+        lw  a3, OFFSETOF__Thread__m_pExInfoStackHead(a2)
+        mv  a0, a3                                      // a0 <- current ExInfo
+        sw  a3, OFFSETOF__ExInfo__m_pPrevExInfo(a1)     // pExInfo->m_pPrevExInfo = m_pExInfoStackHead
+        sw  a1, OFFSETOF__Thread__m_pExInfoStackHead(a2) // m_pExInfoStackHead = pExInfo
+
+        // set the exception context field on the ExInfo
+        addi  a2, sp, rsp_offsetof_Context              // a2 <- PAL_LIMITED_CONTEXT*
+        sw  a2, OFFSETOF__ExInfo__m_pExContext(a1)      // pExInfo->m_pExContext = pContext
+
+        // a0 contains the currently active ExInfo
+        // a1 contains the address of the new ExInfo
+        call  C_FUNC(RhRethrow)
+
+    ALTERNATE_ENTRY RhpRethrow2
+
+        // no return
+        EMIT_BREAKPOINT
+    NESTED_END RhpRethrow, _TEXT
+
+//
+// void* FASTCALL RhpCallCatchFunclet(OBJECTREF exceptionObj, void* pHandlerIP, REGDISPLAY* pRegDisplay,
+//                                    ExInfo* pExInfo)
+//
+// INPUT:  a0:  exception object
+//         a1:  handler funclet address
+//         a2:  REGDISPLAY*
+//         a3:  ExInfo*
+//
+
+    NESTED_ENTRY RhpCallCatchFunclet, _TEXT, NoHandler
+
+        // Allocate space for the call funclet frame: a0-a3, Thread*, 2 padding slots
+        ALLOC_CALL_FUNCLET_FRAME 0x1c
+
+#define rsp_offset_a0 0x00
+#define rsp_offset_a1 0x04
+#define rsp_offset_a2 0x08
+#define rsp_offset_a3 0x0c
+#define rsp_CatchFunclet_offset_thread 0x10
+
+        sw  a0, rsp_offset_a0(sp)
+        sw  a1, rsp_offset_a1(sp)
+        sw  a2, rsp_offset_a2(sp)
+        sw  a3, rsp_offset_a3(sp)
+
+        // Clear the DoNotTriggerGc flag, trashes a4-a6
+        call  C_FUNC(RhpGetThread)
+        sw  a0, rsp_CatchFunclet_offset_thread(sp)
+        mv  a5, a0
+        lw  a0, rsp_offset_a0(sp)
+        lw  a1, rsp_offset_a1(sp)
+        lw  a2, rsp_offset_a2(sp)
+        lw  a3, rsp_offset_a3(sp)
+
+        li  a6, ~TSF_DoNotTriggerGc
+        UPDATE_THREAD_STATE_FLAGS a5, a6, a4, 1
+
+        // Set preserved regs to the values expected by the funclet
+        RESTORE_PRESERVED_REGISTERS a2
+
+        // Trash the values at the old homes to make sure nobody uses them
+        TRASH_PRESERVED_REGISTERS_STORAGE a2
+
+        // Call the funclet
+        // a0 still contains the exception object
+        jalr  a1
+
+    ALTERNATE_ENTRY RhpCallCatchFunclet2
+
+        // a0 contains resume IP
+
+        lw  a2, rsp_offset_a2(sp) // a2 <- REGDISPLAY*
+
+#ifdef _DEBUG
+        // Call into some C++ code to validate the pop of the ExInfo. We only do this in debug because we
+        // have to spill all the preserved registers and then refill them after the call.
+
+        sw  a0, rsp_offset_a0(sp)
+
+        SAVE_PRESERVED_REGISTERS a2
+
+        lw  a0, rsp_CatchFunclet_offset_thread(sp) // a0 <- Thread*
+        lw  a1, rsp_offset_a3(sp)                  // a1 <- current ExInfo*
+        lw  a2, OFFSETOF__REGDISPLAY__SP(a2)       // a2 <- resume SP value
+        call  C_FUNC(RhpValidateExInfoPop)
+
+        lw  a2, rsp_offset_a2(sp)                  // a2 <- REGDISPLAY*
+
+        RESTORE_PRESERVED_REGISTERS a2
+
+        lw  a0, rsp_offset_a0(sp)                  // Reload resume IP
+#endif
+
+        lw  a1, rsp_CatchFunclet_offset_thread(sp)
+
+        // We must unhijack the thread at this point because the section of stack where the hijack is applied
+        // may go dead. If it does, then the next time we try to unhijack the thread, it will corrupt the stack.
+        INLINE_THREAD_UNHIJACK a1, a3, t3  // Thread in a1, trashes a3 and t3
+
+        lw  a3, rsp_offset_a3(sp)                         // a3 <- current ExInfo*
+        lw  a2, OFFSETOF__REGDISPLAY__SP(a2)              // a2 <- resume SP value
+
+LOCAL_LABEL(PopExInfoLoop):
+        lw   a3, OFFSETOF__ExInfo__m_pPrevExInfo(a3)      // a3 <- next ExInfo
+        beq  a3, zero, LOCAL_LABEL(DonePopping)           // if (pExInfo == null) { we're done }
+        bltu a3, a2, LOCAL_LABEL(PopExInfoLoop)           // if (pExInfo < resume SP} { keep going }
+
+LOCAL_LABEL(DonePopping):
+        sw  a3, OFFSETOF__Thread__m_pExInfoStackHead(a1)  // Store the new head on the Thread
+
+        // Reset SP and jump to continuation address
+        mv  sp, a2
+        jalr  zero, 0(a0)  // Jump to the continuation address
+
+#undef rsp_offset_a0
+#undef rsp_offset_a1
+#undef rsp_offset_a2
+#undef rsp_offset_a3
+#undef rsp_CatchFunclet_offset_thread
+
+    NESTED_END RhpCallCatchFunclet, _TEXT
+
+//
+// void FASTCALL RhpCallFinallyFunclet(void* pHandlerIP, REGDISPLAY* pRegDisplay)
+//
+// INPUT:  a0:  handler funclet address
+//         a1:  REGDISPLAY*
+//
+
+    NESTED_ENTRY RhpCallFinallyFunclet, _TEXT, NoHandler
+
+        // Allocate space for the call funclet frame: a0, a1, Thread*, 4 padding slots
+        ALLOC_CALL_FUNCLET_FRAME 0x1c
+
+#define rsp_offset_a0 0x00
+#define rsp_offset_a1 0x04
+#define rsp_FinallyFunclet_offset_thread 0x08
+
+        sw a0, rsp_offset_a0(sp)
+        sw a1, rsp_offset_a1(sp)
+
+        // Clear the DoNotTriggerGc flag
+        call  C_FUNC(RhpGetThread)
+        sw  a0, rsp_FinallyFunclet_offset_thread(sp)
+        mv  a2, a0
+        lw  a0, rsp_offset_a0(sp)
+        lw  a1, rsp_offset_a1(sp)
+
+        li  a3, ~TSF_DoNotTriggerGc
+        UPDATE_THREAD_STATE_FLAGS a2, a3, a4, 1
+
+        // Restore preserved registers
+        RESTORE_PRESERVED_REGISTERS a1
+
+        // Trash the values at the old homes to make sure nobody uses them
+        TRASH_PRESERVED_REGISTERS_STORAGE a1
+
+        // Call the funclet
+        jalr  a0  // Jump to the funclet
+
+    ALTERNATE_ENTRY RhpCallFinallyFunclet2
+
+        lw  a1, rsp_offset_a1(sp)  // Reload REGDISPLAY pointer
+
+        // Save new values of preserved registers into REGDISPLAY
+        SAVE_PRESERVED_REGISTERS a1
+
+        // Restore the DoNotTriggerGc flag
+        lw  a2, rsp_FinallyFunclet_offset_thread(sp)
+        li  a3, TSF_DoNotTriggerGc
+        UPDATE_THREAD_STATE_FLAGS a2, a3, a1, 0
+
+        // Free call funclet frame
+        FREE_CALL_FUNCLET_FRAME 0x1c
+
+        // Return
+        EPILOG_RETURN
+
+#undef rsp_offset_a0
+#undef rsp_offset_a1
+#undef rsp_FinallyFunclet_offset_thread
+
+    NESTED_END RhpCallFinallyFunclet, _TEXT
+
+//
+// void* FASTCALL RhpCallFilterFunclet(OBJECTREF exceptionObj, void* pFilterIP, REGDISPLAY* pRegDisplay)
+//
+// INPUT:  a0:  exception object
+//         a1:  filter funclet address
+//         a2:  REGDISPLAY*
+//
+
+    NESTED_ENTRY RhpCallFilterFunclet, _TEXT, NoHandler
+        // 3 padding slots
+        ALLOC_CALL_FUNCLET_FRAME 0x0c
+
+        lw  t3, OFFSETOF__REGDISPLAY__pFP(a2)
+        lw  fp, 0(t3)
+
+        //
+        // call the funclet
+        //
+        // a0 still contains the exception object
+        jalr  a1
+
+    ALTERNATE_ENTRY RhpCallFilterFunclet2
+
+        FREE_CALL_FUNCLET_FRAME 0x0c
+        EPILOG_RETURN
+
+    NESTED_END RhpCallFilterFunclet, Text
diff --git a/src/coreclr/nativeaot/Runtime/riscv32/GcProbe.S b/src/coreclr/nativeaot/Runtime/riscv32/GcProbe.S
new file mode 100644
index 00000000000..0a338dcbc60
--- /dev/null
+++ b/src/coreclr/nativeaot/Runtime/riscv32/GcProbe.S
@@ -0,0 +1,145 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+#include <unixasmmacros.inc>
+#include "AsmOffsets.inc"
+
+#define PROBE_FRAME_SIZE 0x50  // 4 * 4  for fixed part of PInvokeTransitionFrame (fp, ra, m_pThread, m_Flags) +
+                               // 11 * 4 for callee saved registers +
+                               // 1 * 4  for caller SP +
+                               // 3 * 4  for int returns (a0, a1, a2) +
+                               // 1 * 4  for alignment padding
+                               // (soft-float: floating-point values are returned in a0/a1)
+
+// Define the prolog for setting up the PInvokeTransitionFrame
+.macro PUSH_PROBE_FRAME threadReg, trashReg, BITMASK
+
+    # Define the method prologue, allocating enough stack space for the PInvokeTransitionFrame and saving
+    # incoming register values into it.
+
+    # First create PInvokeTransitionFrame
+    PROLOG_SAVE_REG_PAIR_INDEXED  fp, ra, PROBE_FRAME_SIZE
+
+    # Slot at sp+0x8 is reserved for Thread *
+    # Slot at sp+0xc is reserved for bitmask of saved registers
+
+    # Save callee-saved registers
+    PROLOG_SAVE_REG_PAIR  s1, s2,  0x10
+    PROLOG_SAVE_REG_PAIR  s3, s4,  0x18
+    PROLOG_SAVE_REG_PAIR  s5, s6,  0x20
+    PROLOG_SAVE_REG_PAIR  s7, s8,  0x28
+    PROLOG_SAVE_REG_PAIR  s9, s10, 0x30
+    PROLOG_SAVE_REG       s11,     0x38
+
+    # Slot at sp+0x3c is reserved for caller sp
+
+    # Save the integer return registers, a2 might contain an objectref (async continuation)
+    sw  a0, 0x40(sp)
+    sw  a1, 0x44(sp)
+    sw  a2, 0x48(sp)
+
+    # Slot at sp+0x4c is alignment padding
+
+    # Perform the rest of the PInvokeTransitionFrame initialization.
+    sw  \threadReg, OFFSETOF__PInvokeTransitionFrame__m_pThread(sp)        # Thread * (unused by stackwalker)
+    sw  \BITMASK, OFFSETOF__PInvokeTransitionFrame__m_Flags(sp)            # Save the register bitmask passed in by caller
+
+    addi  \trashReg, sp, PROBE_FRAME_SIZE                                  # Recover value of caller's SP
+    sw  \trashReg, 0x3c(sp)                                                # Save caller's SP
+
+    # Link the frame into the Thread
+    sw  sp, OFFSETOF__Thread__m_pDeferredTransitionFrame(\threadReg)
+
+.endm
+
+// Define the prolog for removing the PInvokeTransitionFrame
+.macro POP_PROBE_FRAME
+
+    // Restore the integer return registers
+    lw  a0, 0x40(sp)
+    lw  a1, 0x44(sp)
+    lw  a2, 0x48(sp)
+
+    // Restore callee saved registers
+    EPILOG_RESTORE_REG_PAIR s1, s2,  0x10
+    EPILOG_RESTORE_REG_PAIR s3, s4,  0x18
+    EPILOG_RESTORE_REG_PAIR s5, s6,  0x20
+    EPILOG_RESTORE_REG_PAIR s7, s8,  0x28
+    EPILOG_RESTORE_REG_PAIR s9, s10, 0x30
+    EPILOG_RESTORE_REG      s11,     0x38
+
+    // Restore the frame pointer and return address
+    EPILOG_RESTORE_REG_PAIR_INDEXED  fp, ra, PROBE_FRAME_SIZE
+.endm
+
+// Fix up the hijacked callstack
+.macro FixupHijackedCallstack
+
+    // a4 <- GetThread()
+    mv  t1, a0
+    INLINE_GETTHREAD a4
+    mv  a0, t1
+
+    // Fix the stack by restoring the original return address
+    lw  ra, OFFSETOF__Thread__m_pvHijackedReturnAddress(a4)
+
+    // Clear hijack state
+    sw  zero, OFFSETOF__Thread__m_ppvHijackedReturnAddressLocation(a4)
+    sw  zero, OFFSETOF__Thread__m_pvHijackedReturnAddress(a4)
+.endm
+
+//
+// GC Probe Hijack target
+//
+NESTED_ENTRY RhpGcProbeHijack, _TEXT, NoHandler
+    FixupHijackedCallstack
+
+    PREPARE_EXTERNAL_VAR_INDIRECT_W RhpTrapThreads, t3
+    andi  t3, t3, 1 << TrapThreadsFlags_TrapThreads_Bit
+    bnez  t3, LOCAL_LABEL(WaitForGC)
+    jr  ra
+
+LOCAL_LABEL(WaitForGC):
+    li  t3, (DEFAULT_FRAME_SAVE_FLAGS + PTFF_SAVE_A0 + PTFF_SAVE_A1 + PTFF_SAVE_A2 + PTFF_THREAD_HIJACK)
+    tail  C_FUNC(RhpWaitForGC)
+NESTED_END RhpGcProbeHijack
+
+.global C_FUNC(RhpThrowHwEx)
+
+// Wait for GC function
+NESTED_ENTRY RhpWaitForGC, _TEXT, NoHandler
+    PUSH_PROBE_FRAME a4, a3, t3
+
+    lw  a0, OFFSETOF__Thread__m_pDeferredTransitionFrame(a4)
+    call  C_FUNC(RhpWaitForGC2)
+
+    POP_PROBE_FRAME
+    EPILOG_RETURN
+NESTED_END RhpWaitForGC
+
+.global C_FUNC(RhpGcPoll2)
+
+// GC Poll function
+LEAF_ENTRY RhpGcPoll
+    PREPARE_EXTERNAL_VAR_INDIRECT_W RhpTrapThreads, a0
+    bne   a0, zero, C_FUNC(RhpGcPollRare)
+    jr  ra
+LEAF_END RhpGcPoll
+
+// Rare GC Poll function
+NESTED_ENTRY RhpGcPollRare, _TEXT, NoHandler
+    PUSH_COOP_PINVOKE_FRAME a0
+    call  RhpGcPoll2
+    POP_COOP_PINVOKE_FRAME
+    jr  ra
+NESTED_END RhpGcPollRare
+
+#ifdef FEATURE_GC_STRESS
+
+// GC Stress Hijack targets
+LEAF_ENTRY RhpGcStressHijack, _TEXT
+    // Not Yet Implemented (NYI)
+    EMIT_BREAKPOINT
+LEAF_END RhpGcStressHijack, _TEXT
+
+#endif  // FEATURE_GC_STRESS
diff --git a/src/coreclr/nativeaot/Runtime/riscv32/InteropThunksHelpers.S b/src/coreclr/nativeaot/Runtime/riscv32/InteropThunksHelpers.S
new file mode 100644
index 00000000000..162b94327eb
--- /dev/null
+++ b/src/coreclr/nativeaot/Runtime/riscv32/InteropThunksHelpers.S
@@ -0,0 +1,47 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+#include <unixasmmacros.inc>
+
+//;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;  DATA SECTIONS  ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
+
+#define POINTER_SIZE 0x04
+
+//;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; Interop Thunks Helpers ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
+
+    //
+    // RhCommonStub
+    //
+    //  INPUT: t1: thunk's data block
+    //
+    //  TRASHES: t0, t1, t2
+    //
+    LEAF_ENTRY RhCommonStub, _TEXT
+        // There are arbitrary callers passing arguments with arbitrary signatures.
+        // Custom calling convention:
+        //      t1 pointer to the current thunk's data block (data contains 2 pointer values: context + target pointers)
+
+        mv               t2, a0
+        INLINE_GET_TLS_VAR t0, C_FUNC(tls_thunkData)
+        mv               a0, t2
+
+        // t0 = base address of TLS data
+        // t1 = address of context cell in thunk's data
+
+        // Load the thunk address from the data block and store it in the thread's static storage
+        lw    t2, 0(t1)
+        sw    t2, 0(t0)
+
+        // Load the target address from the data block and jump to it
+        lw    t1, POINTER_SIZE(t1)
+        jr    t1
+
+    LEAF_END RhCommonStub, _TEXT
+
+    //
+    // IntPtr RhGetCommonStubAddress()
+    //
+    LEAF_ENTRY RhGetCommonStubAddress, _TEXT
+        PREPARE_EXTERNAL_VAR RhCommonStub, a0
+        jr  ra
+    LEAF_END RhGetCommonStubAddress, _TEXT
