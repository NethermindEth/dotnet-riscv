+#ifdef TARGET_RISCV32
+//------------------------------------------------------------------------
+// RetypeSoftFloatDoubles: Turn every double into a long for the soft-float RV32 backend.
+//
+// Notes:
+//    Under the soft-float ABI global morph has expanded every double operation into a
+//    helper call, so the doubles left only move 64-bit values: locals, loads, stores,
+//    constants, calls and returns. A double does not fit an RV32 register, so they become
+//    longs and are decomposed like any other; the ABI is unchanged, as a 2*XLEN scalar is
+//    passed and returned in a register pair either way.
+//
+void Lowering::RetypeSoftFloatDoubles()
+{
+    for (unsigned lclNum = 0; lclNum < m_compiler->lvaCount; lclNum++)
+    {
+        LclVarDsc* varDsc = m_compiler->lvaGetDesc(lclNum);
+        if (varDsc->TypeIs(TYP_DOUBLE))
+        {
+            varDsc->lvType            = TYP_LONG;
+            m_compiler->compLongUsed = true;
+        }
+    }
+
+    if (m_compiler->info.compRetType == TYP_DOUBLE)
+    {
+        m_compiler->info.compRetType       = TYP_LONG;
+        m_compiler->info.compRetNativeType = TYP_LONG;
+        m_compiler->compRetTypeDesc.Reset();
+        m_compiler->compRetTypeDesc.InitializeLongReturnType();
+        m_compiler->compLongUsed = true;
+    }
+
+    for (BasicBlock* const block : m_compiler->Blocks())
+    {
+        LIR::Range& range = LIR::AsRange(block);
+        GenTree*    node  = range.FirstNode();
+        while (node != nullptr)
+        {
+            GenTree* next = node->gtNext;
+
+            if (node->OperIsFieldList())
+            {
+                for (GenTreeFieldList::Use& use : node->AsFieldList()->Uses())
+                {
+                    if (use.GetType() == TYP_DOUBLE)
+                    {
+                        use.SetType(TYP_LONG);
+                    }
+                }
+            }
+
+            if (node->TypeIs(TYP_DOUBLE))
+            {
+                m_compiler->compLongUsed = true;
+                if (node->OperIs(GT_CNS_DBL))
+                {
+                    double  value = node->AsDblCon()->DconValue();
+                    int64_t bits;
+                    memcpy(&bits, &value, sizeof(bits));
+                    node->BashToConst(bits, TYP_LONG);
+                }
+                else
+                {
+                    node->gtType = TYP_LONG;
+                    if (node->IsCall())
+                    {
+                        GenTreeCall* call  = node->AsCall();
+                        call->gtReturnType = TYP_LONG;
+                        call->ResetReturnType();
+                        call->InitializeLongReturnType();
+                    }
+                }
+            }
+
+            // A bitcast between a double and a long is now a no-op.
+            if (node->OperIs(GT_BITCAST) && node->TypeIs(TYP_LONG) && node->gtGetOp1()->TypeIs(TYP_LONG))
+            {
+                GenTree* src = node->gtGetOp1();
+                LIR::Use use;
+                if (range.TryGetUse(node, &use))
+                {
+                    use.ReplaceWith(src);
+                }
+                else
+                {
+                    src->SetUnusedValue();
+                }
+                range.Remove(node);
+            }
+
+            node = next;
+        }
