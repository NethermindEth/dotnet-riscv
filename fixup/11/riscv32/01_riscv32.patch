+//------------------------------------------------------------------------
+// genLongToIntCast: Generate code for a [u]long to [u]int cast.
+//
+// Arguments:
+//    cast - The GT_CAST node; its source is a contained GT_LONG
+//
+// Notes:
+//    The value is the low half; a checked cast tests the high half first:
+//      long  -> int:  hi == (lo >> 31)
+//      ulong -> int:  hi == 0 && lo >= 0
+//      [u]long -> uint: hi == 0
+//
+void CodeGen::genLongToIntCast(GenTree* cast)
+{
+    assert(cast->OperIs(GT_CAST));
+
+    GenTree* src = cast->gtGetOp1();
+    noway_assert(src->OperIs(GT_LONG));
+    genConsumeRegs(src);
+
+    const var_types srcType  = cast->IsUnsigned() ? TYP_ULONG : TYP_LONG;
+    const var_types dstType  = cast->CastToType();
+    const regNumber loSrcReg = src->gtGetOp1()->GetRegNum();
+    const regNumber hiSrcReg = src->gtGetOp2()->GetRegNum();
+    const regNumber dstReg   = cast->GetRegNum();
+    assert((dstType == TYP_INT) || (dstType == TYP_UINT));
+
+    if (cast->gtOverflow())
+    {
+        if ((srcType == TYP_LONG) && (dstType == TYP_INT))
+        {
+            const regNumber tempReg = internalRegisters.GetSingle(cast);
+            GetEmitter()->emitIns_R_R_I(INS_srai, EA_4BYTE, tempReg, loSrcReg, 31);
+            genJumpToThrowHlpBlk_la(SCK_OVERFLOW, INS_bne, tempReg, nullptr, hiSrcReg);
+        }
+        else
+        {
+            if ((srcType == TYP_ULONG) && (dstType == TYP_INT))
+            {
+                genJumpToThrowHlpBlk_la(SCK_OVERFLOW, INS_blt, loSrcReg, nullptr, REG_R0);
+            }
+            genJumpToThrowHlpBlk_la(SCK_OVERFLOW, INS_bne, hiSrcReg, nullptr, REG_R0);
+        }
+    }
+
+    GetEmitter()->emitIns_Mov(INS_mov, EA_4BYTE, dstReg, loSrcReg, /* canSkip */ true);
+    genProduceReg(cast);
+}
+
+//------------------------------------------------------------------------
+// genCodeForShiftLong: Generates the high (GT_LSH_HI) or low (GT_RSH_LO) half
+// of a 64-bit shift by a constant 0 < count < 32.
+//
+// Arguments:
+//    tree - the GT_LSH_HI or GT_RSH_LO node; its first operand is a contained GT_LONG
+//
+void CodeGen::genCodeForShiftLong(GenTree* tree)
+{
+    const genTreeOps oper = tree->OperGet();
+    assert((oper == GT_LSH_HI) || (oper == GT_RSH_LO));
+
+    GenTree* operand = tree->AsOp()->gtOp1;
+    assert(operand->OperIs(GT_LONG));
+    const regNumber regLo = operand->gtGetOp1()->GetRegNum();
+    const regNumber regHi = operand->gtGetOp2()->GetRegNum();
+
+    genConsumeOperands(tree->AsOp());
+
+    GenTree* shiftBy = tree->gtGetOp2();
+    assert(shiftBy->isContainedIntOrIImmed());
+    const unsigned count = (unsigned)shiftBy->AsIntConCommon()->IconValue();
+    assert((count > 0) && (count < 32));
+
+    const regNumber dstReg  = tree->GetRegNum();
+    const regNumber tempReg = internalRegisters.GetSingle(tree);
+    emitter*        emit    = GetEmitter();
+
+    if (oper == GT_LSH_HI)
+    {
+        // (hi << count) | (lo >> (32 - count))
+        emit->emitIns_R_R_I(INS_srli, EA_4BYTE, tempReg, regLo, 32 - count);
+        emit->emitIns_R_R_I(INS_slli, EA_4BYTE, dstReg, regHi, count);
+    }
+    else
+    {
+        // (lo >> count) | (hi << (32 - count))
+        emit->emitIns_R_R_I(INS_slli, EA_4BYTE, tempReg, regHi, 32 - count);
+        emit->emitIns_R_R_I(INS_srli, EA_4BYTE, dstReg, regLo, count);
+    }
+    emit->emitIns_R_R_R(INS_or, EA_4BYTE, dstReg, dstReg, tempReg);
+
+    genProduceReg(tree);
+}
