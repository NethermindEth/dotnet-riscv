diff --git a/src/coreclr/nativeaot/Runtime/riscv32/PInvoke.S b/src/coreclr/nativeaot/Runtime/riscv32/PInvoke.S
new file mode 100644
index 00000000000..541f4581229
--- /dev/null
+++ b/src/coreclr/nativeaot/Runtime/riscv32/PInvoke.S
@@ -0,0 +1,48 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+#include <unixasmmacros.inc>
+#include "AsmOffsets.inc"
+
+.global RhpTrapThreads
+
+//
+// RhpPInvoke
+//
+// IN:  a0: address of pinvoke frame
+//
+// This helper assumes that its callsite is as good to start the stackwalk as the actual PInvoke callsite.
+// The code generator must treat the callsite of this helper as GC triggering and generate the GC info for it.
+// Also, the code generator must ensure that there are no live GC references in callee saved registers.
+//
+
+NESTED_ENTRY RhpPInvoke, _TEXT, NoHandler
+        sw    fp, OFFSETOF__PInvokeTransitionFrame__m_FramePointer(a0)
+        sw    ra, OFFSETOF__PInvokeTransitionFrame__m_RIP(a0)
+        sw    sp, OFFSETOF__PInvokeTransitionFrame__m_PreservedRegs(a0)
+        li    t0, PTFF_SAVE_SP
+        sw    t0, OFFSETOF__PInvokeTransitionFrame__m_Flags(a0)
+
+        // INLINE_GETTHREAD trashes a0.
+        mv               t2, a0
+        INLINE_GETTHREAD a1
+
+        sw    a1, OFFSETOF__PInvokeTransitionFrame__m_pThread(t2)
+        sw    t2, OFFSETOF__Thread__m_pTransitionFrame(a1)
+        ret
+NESTED_END RhpPInvoke, _TEXT
+
+LEAF_ENTRY RhpPInvokeReturn, _TEXT
+        lw    t0, OFFSETOF__PInvokeTransitionFrame__m_pThread(a0)
+        sw    zero, OFFSETOF__Thread__m_pTransitionFrame(t0)
+
+        PREPARE_EXTERNAL_VAR_INDIRECT_W RhpTrapThreads, t0
+
+        bnez    t0, 0f
+        ret
+
+0:
+        // Passing transition frame pointer in a0
+        tail    RhpWaitForGC2
+
+LEAF_END RhpPInvokeReturn, _TEXT
diff --git a/src/coreclr/nativeaot/Runtime/riscv32/UniversalTransition.S b/src/coreclr/nativeaot/Runtime/riscv32/UniversalTransition.S
new file mode 100644
index 00000000000..ec588f2da41
--- /dev/null
+++ b/src/coreclr/nativeaot/Runtime/riscv32/UniversalTransition.S
@@ -0,0 +1,133 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+#include <unixasmmacros.inc>
+
+#ifdef _DEBUG
+#define TRASH_SAVED_ARGUMENT_REGISTERS
+#endif
+
+#ifdef TRASH_SAVED_ARGUMENT_REGISTERS
+    .global RhpIntegerTrashValues
+#endif // TRASH_SAVED_ARGUMENT_REGISTERS
+
+#define COUNT_ARG_REGISTERS (8)
+#define INTEGER_REGISTER_SIZE (4)
+#define ARGUMENT_REGISTERS_SIZE (COUNT_ARG_REGISTERS * INTEGER_REGISTER_SIZE)
+
+// Largest return block is 2 integer registers (a0, a1); soft-float returns doubles there too.
+#define RETURN_BLOCK_SIZE 8
+
+#define PUSHED_RA_SIZE (4)
+#define PUSHED_FP_SIZE (4)
+
+// From CallerSP to ChildSP, the stack frame is composed of the following adjacent regions:
+//
+//      ARGUMENT_REGISTERS_SIZE
+//      RETURN_BLOCK_SIZE
+//      PUSHED_RA_SIZE
+//      PUSHED_FP_SIZE
+//
+// There are no floating-point argument registers in the ilp32 soft-float ABI.
+
+#define DISTANCE_FROM_CHILDSP_TO_RETURN_BLOCK (PUSHED_FP_SIZE + PUSHED_RA_SIZE)
+
+#define STACK_SIZE (ARGUMENT_REGISTERS_SIZE + RETURN_BLOCK_SIZE + PUSHED_RA_SIZE + PUSHED_FP_SIZE)
+
+#define ARGUMENT_REGISTERS_OFFSET (DISTANCE_FROM_CHILDSP_TO_RETURN_BLOCK + RETURN_BLOCK_SIZE)
+
+//
+// RhpUniversalTransition
+//
+// At input to this function, a0-a7 and the stack may contain any number of arguments.
+//
+// In addition, there are 2 extra arguments passed in the intra-procedure-call scratch register:
+//  t0 will contain the managed function that is to be called by this transition function
+//  t1 will contain the pointer-sized extra argument to the managed function
+//
+// When invoking the callee:
+//
+//  a0 shall contain a pointer to the TransitionBlock
+//  a1 shall contain the value that was in t1 at entry to this function
+//
+// Frame layout is:
+//
+//  {StackPassedArgs}                           ChildSP+030     CallerSP+000
+//  {IntArgRegs (a0-a7) (0x20 bytes)}           ChildSP+010     CallerSP-020
+//  {ReturnBlock (0x08 bytes)}                  ChildSP+008     CallerSP-028
+//   -- The base address of the Return block is the TransitionBlock pointer.
+//  {PushedRA}                                  ChildSP+004     CallerSP-02C
+//  {PushedFP}                                  ChildSP+000     CallerSP-030
+//
+// NOTE: If the frame layout ever changes, the C++ UniversalTransitionStackFrame structure
+// must be updated as well.
+//
+// NOTE: The stack walker guarantees that conservative GC reporting will be applied to
+// everything between the base of the ReturnBlock and the top of the StackPassedArgs.
+//
+
+    .text
+
+    .macro UNIVERSAL_TRANSITION FunctionName
+
+    NESTED_ENTRY Rhp\FunctionName, _TEXT, NoHandler
+
+        # FP and RA registers
+        PROLOG_SAVE_REG_PAIR_INDEXED fp, ra, STACK_SIZE
+
+        # Space for return block data (0x08 bytes)
+
+        # Save argument registers
+        sw          a0, ARGUMENT_REGISTERS_OFFSET(sp)
+        sw          a1, ARGUMENT_REGISTERS_OFFSET + 0x04(sp)
+        sw          a2, ARGUMENT_REGISTERS_OFFSET + 0x08(sp)
+        sw          a3, ARGUMENT_REGISTERS_OFFSET + 0x0c(sp)
+        sw          a4, ARGUMENT_REGISTERS_OFFSET + 0x10(sp)
+        sw          a5, ARGUMENT_REGISTERS_OFFSET + 0x14(sp)
+        sw          a6, ARGUMENT_REGISTERS_OFFSET + 0x18(sp)
+        sw          a7, ARGUMENT_REGISTERS_OFFSET + 0x1c(sp)
+
+#ifdef TRASH_SAVED_ARGUMENT_REGISTERS
+        PREPARE_EXTERNAL_VAR RhpIntegerTrashValues, a1
+
+        lw a2, 0x08(a1)
+        lw a3, 0x0c(a1)
+        lw a4, 0x10(a1)
+        lw a5, 0x14(a1)
+        lw a6, 0x18(a1)
+        lw a7, 0x1c(a1)
+#endif // TRASH_SAVED_ARGUMENT_REGISTERS
+
+        addi        a0, sp, DISTANCE_FROM_CHILDSP_TO_RETURN_BLOCK  # First parameter to target function is a pointer to the return block
+        mv          a1, t1                                         # Second parameter to target function
+        jalr        ra, t0, 0
+
+ALTERNATE_ENTRY ReturnFrom\FunctionName
+
+        # Move the result (the target address) to t2 so it doesn't get overridden when we restore the
+        # argument registers.
+        mv          t2, a0
+
+        # Restore the argument registers
+        lw          a0, ARGUMENT_REGISTERS_OFFSET(sp)
+        lw          a1, ARGUMENT_REGISTERS_OFFSET + 0x04(sp)
+        lw          a2, ARGUMENT_REGISTERS_OFFSET + 0x08(sp)
+        lw          a3, ARGUMENT_REGISTERS_OFFSET + 0x0c(sp)
+        lw          a4, ARGUMENT_REGISTERS_OFFSET + 0x10(sp)
+        lw          a5, ARGUMENT_REGISTERS_OFFSET + 0x14(sp)
+        lw          a6, ARGUMENT_REGISTERS_OFFSET + 0x18(sp)
+        lw          a7, ARGUMENT_REGISTERS_OFFSET + 0x1c(sp)
+
+        # Restore FP and RA registers, and free the allocated stack block
+        lw          ra, 0x04(sp)
+        lw          s0, 0x0(sp)
+        addi        sp, sp, STACK_SIZE
+
+        # Tailcall to the target address.
+        jr          t2
+
+    NESTED_END Rhp\FunctionName, _TEXT
+
+    .endm
+
+    UNIVERSAL_TRANSITION UniversalTransitionTailCall
