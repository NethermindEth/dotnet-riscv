+#ifdef TARGET_RISCV32
+//------------------------------------------------------------------------
+// RepresentOpAsReusable: Makes the operand at *edge a node that can be read
+// again later in the range: a constant, or otherwise a temp it is stored to.
+//
+// Arguments:
+//    user - the node that uses the operand
+//    edge - the edge from user to the operand
+//
+// Return Value:
+//    The node now at *edge; gtClone of it reads the same value.
+//
+GenTree* DecomposeLongs::RepresentOpAsReusable(GenTree* user, GenTree** edge)
+{
+    if (!(*edge)->IsCnsIntOrI())
+    {
+        LIR::Use opUse(Range(), edge, user);
+        opUse.ReplaceWithLclVar(m_compiler);
+    }
+    return *edge;
+}
+
+//------------------------------------------------------------------------
+// ThrowIfOverflowBitSet: Throws OverflowException when overflowBit is 1.
+//
+// Arguments:
+//    overflowBit - an int node producing 0 or 1, already in the range
+//    insertAfter - the node to insert the check after
+//
+// Notes:
+//    The check is a checked int add of INT_MAX and the bit, which overflows exactly
+//    when the bit is set, so it reuses the existing overflow codegen and throw block.
+//
+void DecomposeLongs::ThrowIfOverflowBitSet(GenTree* overflowBit, GenTree* insertAfter)
+{
+    GenTree* intMax = m_compiler->gtNewIconNode(INT32_MAX);
+    GenTree* check  = m_compiler->gtNewOperNode(GT_ADD, TYP_INT, intMax, overflowBit);
+    check->gtFlags |= GTF_OVERFLOW | GTF_EXCEPT;
+    check->SetUnusedValue();
+    Range().InsertAfter(insertAfter, intMax, check);
+}
+
+//------------------------------------------------------------------------
+// DecomposeAddSubNoFlags: Decompose GT_ADD and GT_SUB for a target without
+// condition flags, passing the carry (borrow) to the high half as a value.
+//
+// Arguments:
+//    use - the LIR::Use object for the def that needs to be decomposed.
+//
+// Return Value:
+//    The next node to process.
+//
+// Notes:
+//    ADD: lo = lo1 + lo2, hi = hi1 + hi2 + (lo <u lo2)
+//    SUB: lo = lo1 - lo2, hi = hi1 - hi2 - (lo1 <u lo2)
+//    A checked op also computes whether the 64-bit result overflowed.
+//
+GenTree* DecomposeLongs::DecomposeAddSubNoFlags(LIR::Use& use)
+{
+    GenTree*         tree       = use.Def();
+    const genTreeOps oper       = tree->OperGet();
+    const bool       isChecked  = tree->gtOverflow();
+    const bool       isUnsigned = tree->IsUnsigned();
+    assert((oper == GT_ADD) || (oper == GT_SUB));
+
+    GenTree* op1 = tree->gtGetOp1();
+    GenTree* op2 = tree->gtGetOp2();
+    noway_assert(op1->OperIs(GT_LONG) && op2->OperIs(GT_LONG));
+
+    GenTree* loOp2 = RepresentOpAsReusable(op2, &op2->AsOp()->gtOp1);
+    GenTree* loOp1 = (oper == GT_SUB) ? RepresentOpAsReusable(op1, &op1->AsOp()->gtOp1) : op1->gtGetOp1();
+    GenTree* hiOp1 = isChecked ? RepresentOpAsReusable(op1, &op1->AsOp()->gtOp2) : op1->gtGetOp2();
+    GenTree* hiOp2 = isChecked ? RepresentOpAsReusable(op2, &op2->AsOp()->gtOp2) : op2->gtGetOp2();
+
+    Range().Remove(op1);
+    Range().Remove(op2);
+
+    GenTree* loResult       = tree;
+    loResult->gtType        = TYP_INT;
+    loResult->AsOp()->gtOp1 = loOp1;
+    loResult->AsOp()->gtOp2 = loOp2;
+    loResult->gtFlags &= ~(GTF_OVERFLOW | GTF_EXCEPT | GTF_UNSIGNED);
+
+    GenTree* last   = loResult;
+    auto     append = [&](GenTree* node) {
+        Range().InsertAfter(last, node);
+        last = node;
+        return node;
+    };
+    auto read = [&](unsigned lclNum) {
+        return append(m_compiler->gtNewLclvNode(lclNum, TYP_INT));
+    };
+    auto copy = [&](GenTree* reusable) {
+        return append(m_compiler->gtClone(reusable));
+    };
+    auto op = [&](genTreeOps nodeOper, GenTree* a, GenTree* b) {
+        return append(m_compiler->gtNewOperNode(nodeOper, TYP_INT, a, b));
+    };
+    auto storeToTemp = [&](GenTree* value) {
+        unsigned lclNum = m_compiler->lvaGrabTemp(true DEBUGARG("riscv32 long arith temp"));
+        append(m_compiler->gtNewTempStore(lclNum, value));
+        return lclNum;
+    };
+
+    const unsigned loLcl = storeToTemp(loResult);
+
+    GenTree* carryA = (oper == GT_ADD) ? read(loLcl) : copy(loOp1);
+    GenTree* carryB = copy(loOp2);
+    GenTree* carry  = op(GT_LT, carryA, carryB);
+    carry->SetUnsigned();
+
+    GenTree* hiResult;
+    if (!isChecked)
+    {
+        GenTree* hiPart = op(oper, hiOp1, hiOp2);
+        hiResult        = op(oper, hiPart, carry);
+    }
+    else
+    {
+        const unsigned carryLcl  = storeToTemp(carry);
+        GenTree*       hiPartA   = copy(hiOp1);
+        GenTree*       hiPartB   = copy(hiOp2);
+        const unsigned hiPartLcl = storeToTemp(op(oper, hiPartA, hiPartB));
+        GenTree*       hiA       = read(hiPartLcl);
+        GenTree*       hiB       = read(carryLcl);
+        const unsigned hiLcl     = storeToTemp(op(oper, hiA, hiB));
+
+        GenTree* overflow;
+        if (isUnsigned)
+        {
+            // The high word wraps either in hi1 op hi2 or in applying the carry.
+            GenTree* firstA  = (oper == GT_ADD) ? read(hiPartLcl) : copy(hiOp1);
+            GenTree* firstB  = (oper == GT_ADD) ? copy(hiOp1) : copy(hiOp2);
+            GenTree* first   = op(GT_LT, firstA, firstB);
+            GenTree* secondA = (oper == GT_ADD) ? read(hiLcl) : read(hiPartLcl);
+            GenTree* secondB = (oper == GT_ADD) ? read(hiPartLcl) : read(carryLcl);
+            GenTree* second  = op(GT_LT, secondA, secondB);
+            first->SetUnsigned();
+            second->SetUnsigned();
+            overflow = op(GT_OR, first, second);
+        }
+        else
+        {
+            // ADD: the operands have the same sign and the result's sign differs.
+            // SUB: the operands' signs differ and the result's sign differs from hi1.
+            GenTree* x1 = read(hiLcl);
+            GenTree* y1 = copy(hiOp1);
+            GenTree* a  = op(GT_XOR, x1, y1);
+            GenTree* x2 = (oper == GT_ADD) ? read(hiLcl) : copy(hiOp1);
+            GenTree* y2 = copy(hiOp2);
+            GenTree* b  = op(GT_XOR, x2, y2);
+            GenTree* both = op(GT_AND, a, b);
+            GenTree* zero = append(m_compiler->gtNewZeroConNode(TYP_INT));
+            overflow      = op(GT_LT, both, zero);
+        }
+        ThrowIfOverflowBitSet(overflow, last);
+        last     = last->gtNext->gtNext;
+        hiResult = read(hiLcl);
+
+        // Only copies of the high operands are read.
+        Range().Remove(hiOp1);
+        Range().Remove(hiOp2);
+    }
+
+    GenTree* loValue = read(loLcl);
+    return FinalizeDecomposition(use, loValue, hiResult, loValue);
+}
+
+//------------------------------------------------------------------------
+// DecomposeNegNoFlags: Decompose GT_NEG for a target without condition flags.
+//
+// Arguments:
+//    use - the LIR::Use object for the def that needs to be decomposed.
+//
+// Return Value:
+//    The next node to process.
+//
+// Notes:
+//    -(hi:lo) = (-hi - (lo != 0)) : -lo
+//
+GenTree* DecomposeLongs::DecomposeNegNoFlags(LIR::Use& use)
+{
+    GenTree* tree   = use.Def();
+    GenTree* gtLong = tree->gtGetOp1();
+    noway_assert(gtLong->OperIs(GT_LONG));
+
+    GenTree* loOp1 = RepresentOpAsReusable(gtLong, &gtLong->AsOp()->gtOp1);
+    GenTree* hiOp1 = gtLong->gtGetOp2();
+    Range().Remove(gtLong);
+
+    GenTree* loResult       = tree;
+    loResult->gtType        = TYP_INT;
+    loResult->AsOp()->gtOp1 = loOp1;
+
+    GenTree* loCopy   = m_compiler->gtClone(loOp1);
+    GenTree* zero     = m_compiler->gtNewZeroConNode(TYP_INT);
+    GenTree* borrow   = m_compiler->gtNewOperNode(GT_NE, TYP_INT, loCopy, zero);
+    GenTree* hiNeg    = m_compiler->gtNewOperNode(GT_NEG, TYP_INT, hiOp1);
+    GenTree* hiResult = m_compiler->gtNewOperNode(GT_SUB, TYP_INT, hiNeg, borrow);
+    Range().InsertAfter(loResult, loCopy, zero, borrow);
+    Range().InsertAfter(borrow, hiNeg, hiResult);
+
+    return FinalizeDecomposition(use, loResult, hiResult, hiResult);
+}
+
+//------------------------------------------------------------------------
+// DecomposeSelectNoFlags: Decompose GT_SELECT for a target without condition
+// flags: the condition is evaluated once and both halves select on it.
+//
+// Arguments:
+//    use - the LIR::Use object for the def that needs to be decomposed.
+//
+// Return Value:
+//    The next node to process.
+//
+GenTree* DecomposeLongs::DecomposeSelectNoFlags(LIR::Use& use)
+{
+    GenTreeConditional* select = use.Def()->AsConditional();
+    GenTree*            op1    = select->gtOp1;
+    GenTree*            op2    = select->gtOp2;
+    assert(op1->OperIs(GT_LONG));
+    assert(op2->OperIs(GT_LONG));
+
+    GenTree* cond = RepresentOpAsReusable(select, &select->gtCond);
+
+    GenTree* loOp1 = op1->gtGetOp1();
+    GenTree* hiOp1 = op1->gtGetOp2();
+    GenTree* loOp2 = op2->gtGetOp1();
+    GenTree* hiOp2 = op2->gtGetOp2();
+    Range().Remove(op1);
+    Range().Remove(op2);
+
+    // The condition is now a local holding 0 or 1.
+    GenTree* loZero = m_compiler->gtNewZeroConNode(TYP_INT);
+    GenTree* loCond = m_compiler->gtNewOperNode(GT_NE, TYP_INT, cond, loZero);
+    Range().InsertAfter(cond, loZero, loCond);
+
+    select->gtType = TYP_INT;
+    select->gtCond = loCond;
+    select->gtOp1  = loOp1;
+    select->gtOp2  = loOp2;
+
+    GenTree*            hiCondValue = m_compiler->gtClone(cond);
+    GenTree*            hiZero      = m_compiler->gtNewZeroConNode(TYP_INT);
+    GenTree*            hiCond      = m_compiler->gtNewOperNode(GT_NE, TYP_INT, hiCondValue, hiZero);
+    GenTreeConditional* hiSelect    = m_compiler->gtNewConditionalNode(GT_SELECT, hiCond, hiOp1, hiOp2, TYP_INT);
+    Range().InsertAfter(select, hiCondValue, hiZero, hiCond, hiSelect);
+
+    return FinalizeDecomposition(use, select, hiSelect, hiSelect);
+}
+//------------------------------------------------------------------------
+// DecomposeLongs::DecomposeLongCompareNoFlags: Decomposes a TYP_LONG compare node for a
+// target without condition flags into an int compare of an int value.
+//
+// Arguments:
+//    cmp - the compare node
+//
+// Return Value:
+//    The next node to process.
+//
+// Notes:
+//    EQ|NE: ((lo1 ^ lo2) | (hi1 ^ hi2)) EQ|NE 0
+//    LT|GE: ((hi1 < hi2) | ((hi1 == hi2) & (lo1 <u lo2))) NE|EQ 0; LE|GT swap the operands first.
+//
+GenTree* DecomposeLongs::DecomposeLongCompareNoFlags(GenTree* cmp)
+{
+    GenTree* src1 = cmp->gtGetOp1();
+    GenTree* src2 = cmp->gtGetOp2();
+    assert(src1->OperIs(GT_LONG));
+    assert(src2->OperIs(GT_LONG));
+
+    genTreeOps condition  = cmp->OperGet();
+    const bool isUnsigned = cmp->IsUnsigned();
+    GenTree*   value;
+
+    if (cmp->OperIs(GT_EQ, GT_NE))
+    {
+        GenTree* loXor = m_compiler->gtNewOperNode(GT_XOR, TYP_INT, src1->gtGetOp1(), src2->gtGetOp1());
+        GenTree* hiXor = m_compiler->gtNewOperNode(GT_XOR, TYP_INT, src1->gtGetOp2(), src2->gtGetOp2());
+        value          = m_compiler->gtNewOperNode(GT_OR, TYP_INT, loXor, hiXor);
+        Range().Remove(src1);
+        Range().Remove(src2);
+        Range().InsertBefore(cmp, loXor, hiXor, value);
+    }
+    else
+    {
+        if (cmp->OperIs(GT_LE, GT_GT))
+        {
+            std::swap(src1, src2);
+            condition = GenTree::SwapRelop(condition);
+        }
+        assert((condition == GT_LT) || (condition == GT_GE));
+
+        // The high halves are compared twice.
+        auto reusable = [&](GenTree* user, GenTree** edge) {
+            if (!(*edge)->IsCnsIntOrI())
+            {
+                LIR::Use use(Range(), edge, user);
+                use.ReplaceWithLclVar(m_compiler);
+            }
+            return *edge;
+        };
+        GenTree* hi1 = reusable(src1, &src1->AsOp()->gtOp2);
+        GenTree* hi2 = reusable(src2, &src2->AsOp()->gtOp2);
+        GenTree* lo1 = src1->gtGetOp1();
+        GenTree* lo2 = src2->gtGetOp1();
+        Range().Remove(src1);
+        Range().Remove(src2);
+
+        GenTree* hiLt = m_compiler->gtNewOperNode(GT_LT, TYP_INT, hi1, hi2);
+        if (isUnsigned)
+        {
+            hiLt->SetUnsigned();
+        }
+        GenTree* hi1Copy = m_compiler->gtClone(hi1);
+        GenTree* hi2Copy = m_compiler->gtClone(hi2);
+        GenTree* hiEq    = m_compiler->gtNewOperNode(GT_EQ, TYP_INT, hi1Copy, hi2Copy);
+        GenTree* loLt    = m_compiler->gtNewOperNode(GT_LT, TYP_INT, lo1, lo2);
+        loLt->SetUnsigned();
+        GenTree* tie = m_compiler->gtNewOperNode(GT_AND, TYP_INT, hiEq, loLt);
+        value        = m_compiler->gtNewOperNode(GT_OR, TYP_INT, hiLt, tie);
+        Range().InsertBefore(cmp, hiLt, hi1Copy, hi2Copy, hiEq);
+        Range().InsertBefore(cmp, loLt, tie, value);
+
+        condition = (condition == GT_LT) ? GT_NE : GT_EQ;
+    }
+
+    GenTree* zero = m_compiler->gtNewZeroConNode(TYP_INT);
+    Range().InsertBefore(cmp, zero);
+    cmp->SetOper(condition);
+    cmp->gtFlags &= ~GTF_UNSIGNED;
+    cmp->AsOp()->gtOp1 = value;
+    cmp->AsOp()->gtOp2 = zero;
+    return cmp->gtNext;
+}
+
+#endif // TARGET_RISCV32
