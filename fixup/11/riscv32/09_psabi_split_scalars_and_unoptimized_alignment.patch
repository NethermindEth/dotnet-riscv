+#ifdef TARGET_RISCV
+//------------------------------------------------------------------------
+// IsRegisterCopyUnderAligned: whether a struct copied as one scalar of its size can be at an address
+// that is not aligned for that scalar.
+//
+// Notes:
+//    Without strict alignment a base is trusted to be aligned for the struct it points to, and a struct
+//    of bytes or of shorts can be at any address its own alignment allows. With strict alignment every
+//    base is tested anyway (see ContainCheckIndir).
+//
+static bool IsRegisterCopyUnderAligned(Compiler* comp, ClassLayout* layout, var_types regType)
+{
+    if ((JitConfig.JitNoUnalignedAccess() == 0) || (JitConfig.JitRiscV64StrictAlign() != 0) || (layout == nullptr) ||
+        layout->IsCustomLayout() || (layout->GetClassHandle() == NO_CLASS_HANDLE))
+    {
+        return false;
+    }
+    return comp->info.compCompHnd->getClassAlignmentRequirement(layout->GetClassHandle()) < genTypeSize(regType);
+}
+#endif // TARGET_RISCV
