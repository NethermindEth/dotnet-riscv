+        // The module sections a static dispatch cell resolution reads never change once the modules are
+        // loaded, so they are looked up once instead of on every resolution. Concurrent first resolutions
+        // may each build the table; the copies are identical.
+        private static ModuleDispatchCells[] s_moduleDispatchCells;
+
+        private unsafe struct DispatchCellRegion
+        {
+            public DispatchCell* Start;
+            public DispatchCell* End;
+            public NativeArray CellInfo;
+
+            public DispatchCellRegion(TypeManagerHandle typeManager, ReadyToRunSectionType cellSection, ReadyToRunSectionType infoSection)
+            {
+                Start = (DispatchCell*)RuntimeImports.RhGetModuleSection(typeManager, cellSection, out int length);
+                End = (DispatchCell*)((byte*)Start + length);
+                CellInfo = default;
+                if (length != 0)
+                {
+                    byte* pInfo = (byte*)RuntimeImports.RhGetModuleSection(typeManager, infoSection, out int infoLength);
+                    CellInfo = new NativeArray(new NativeParser(new NativeReader(pInfo, checked((uint)infoLength)), 0));
+                }
+            }
+
+            public bool Contains(DispatchCell* pCell) => pCell >= Start && pCell < End;
+        }
+
+        private struct ModuleDispatchCells
+        {
+            public DispatchCellRegion InterfaceCells;
+            public DispatchCellRegion GvmCells;
+            public ExternalReferencesTable NativeReferences;
+        }
+
+        private static ModuleDispatchCells[] InitializeModuleDispatchCells()
+        {
+            ReadOnlySpan<TypeManagerHandle> modules = StartupCodeHelpers.GetLoadedModules();
+            var moduleDispatchCells = new ModuleDispatchCells[modules.Length];
+            for (int i = 0; i < modules.Length; i++)
+            {
+                ref ModuleDispatchCells module = ref moduleDispatchCells[i];
+                module.InterfaceCells = new DispatchCellRegion(modules[i], ReadyToRunSectionType.InterfaceDispatchCellRegion, ReadyToRunSectionType.InterfaceDispatchCellInfoRegion);
+                module.GvmCells = new DispatchCellRegion(modules[i], ReadyToRunSectionType.GvmDispatchCellRegion, ReadyToRunSectionType.GvmDispatchCellInfoRegion);
+                module.NativeReferences.InitializeNativeReferences(modules[i]);
+            }
+
+            return s_moduleDispatchCells = moduleDispatchCells;
+        }
