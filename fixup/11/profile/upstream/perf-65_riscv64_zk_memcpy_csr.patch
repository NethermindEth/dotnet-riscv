+//------------------------------------------------------------------------
+// zkCpBlkUsesMemcpyCsr: does this unrolled block copy become the ZisK DMA memcpy idiom
+//   (JitZkMemcpyCsr)? Reports whether codegen needs registers to materialize the destination
+//   and source addresses (a local, or a based address with a non-zero offset).
+//
+bool Compiler::zkCpBlkUsesMemcpyCsr(GenTreeBlk* blk, bool* needsDstReg, bool* needsSrcReg)
+{
+    *needsDstReg = false;
+    *needsSrcReg = false;
+    const int minSize = JitConfig.JitZkMemcpyCsr();
+    if ((minSize <= 0) || !blk->OperIs(GT_STORE_BLK) || !blk->OperIsCopyBlkOp() ||
+        (blk->gtBlkOpKind != GenTreeBlk::BlkOpKindUnroll) || (blk->Size() < (unsigned)minSize))
+    {
+        return false;
+    }
+    if (blk->IsUnaligned() && (JitConfig.JitNoUnalignedAccess() != 0))
+    {
+        return false;
+    }
+    auto addrOk = [](GenTree* addr, bool* needsReg) -> bool {
+        if (!addr->isContained())
+        {
+            return true;
+        }
+        if (addr->OperIsAddrMode())
+        {
+            if (addr->AsAddrMode()->HasIndex() || !emitter::isValidSimm12(addr->AsAddrMode()->Offset()))
+            {
+                return false;
+            }
+            *needsReg = (addr->AsAddrMode()->Offset() != 0);
+            return true;
+        }
+        if (addr->OperIs(GT_LCL_ADDR))
+        {
+            *needsReg = true;
+            return true;
+        }
+        return false;
+    };
+    if (!addrOk(blk->Addr(), needsDstReg))
+    {
+        return false;
+    }
+    GenTree* src = blk->Data();
+    if (src->OperIs(GT_LCL_VAR, GT_LCL_FLD))
+    {
+        *needsSrcReg = true;
+        return src->isContained();
+    }
+    if (!src->OperIs(GT_IND) || !src->isContained())
+    {
+        return false;
+    }
+    return addrOk(src->AsIndir()->Addr(), needsSrcReg);
+}
