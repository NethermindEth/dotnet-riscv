+            // genLclHeap hands out STACK_ALIGN'ed space (and null for a zero size).
+            return (unsigned)BitOperations::TrailingZeroCount((unsigned)STACK_ALIGN);
+
         default:
             return 0;
     }
@@ -2010,10 +2014,25 @@
 
