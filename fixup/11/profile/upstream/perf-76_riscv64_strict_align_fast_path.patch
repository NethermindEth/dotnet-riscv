         (genTypeSize(indirNode->TypeGet()) > 1))
     {
+        GenTree*  addr = indirNode->Addr();
+        const int size = (int)genTypeSize(indirNode->TypeGet());
+        if (addr->OperIs(GT_LEA) && addr->AsAddrMode()->HasBase() && !addr->AsAddrMode()->HasIndex() &&
+            !addr->AsAddrMode()->Base()->isContained())
