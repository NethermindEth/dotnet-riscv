         sd a0, 0x60(sp)  // Save a0 to 0x60
@@ -623,7 +640,14 @@ LOCAL_LABEL(DonePopping):
         // Set the DoNotTriggerGc flag
         addi  t3, a2, OFFSETOF__Thread__m_ThreadStateFlags
         addiw  a3, zero, -17  // Mask value (0xFFFFFFEF)
+#ifdef __riscv_atomic
