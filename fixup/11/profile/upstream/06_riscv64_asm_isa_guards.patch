     .endif
 
 .endm
@@ -405,6 +413,7 @@ C_FUNC(\Name):
 
     // Save FP callee-saved registers (fs0-fs11 = f8,f9,f18-f27) at offset 0
     // RISC-V FP callee-saved: fs0=f8, fs1=f9, fs2-fs11=f18-f27
+#if __riscv_flen >= 64
