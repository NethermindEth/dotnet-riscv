-    var_types type = tree->gtGetOp1()->TypeGet();
-    emitAttr  size = emitTypeSize(type);
+    // The width comes from the node: the operand type need not match it.
+    emitAttr  size = emitActualTypeSize(tree);
     regNumber dest = tree->GetRegNum();
     regNumber src  = genConsumeReg(tree->gtGetOp1());
 
     assert(m_compiler->compOpportunisticallyDependsOn(InstructionSet_Zbb));
     emitter& emit = *GetEmitter();
     emit.emitIns_R_R(INS_rev8, size, dest, src);
-    if (size < EA_PTRSIZE)
+    if (tree->OperIs(GT_BSWAP16))
     {
-        int shiftAmount = tree->OperIs(GT_BSWAP16) ? 48 : 32;
         // TODO: we need to right-shift the byte-reversed register anyway. Remove the cast (in Lowering::LowerCast?)
         // wrapping GT_BSWAP16 and pass the exact destination type here, so that this codegen could leave the register
         // properly extended.
-        emit.emitIns_R_R_I(INS_srli, size, dest, dest, shiftAmount);
+        emit.emitIns_R_R_I(INS_srli, size, dest, dest, 48);
+    }
+    else if (size == EA_4BYTE)
+    {
+        // Shift arithmetically so the int32 result stays sign-extended, as RV64 expects of 32-bit values.
+        emit.emitIns_R_R_I(INS_srai, size, dest, dest, 32);
     }
 
     genProduceReg(tree);
@@ -6486,7 +6490,8 @@
 
     assert(shiftBy->IsCnsIntOrI());
 
-    unsigned shamt = (unsigned)shiftBy->AsIntCon()->IconValue();
+    // Mask like genCodeForShift: an over-shift constant would otherwise spill into the funct6 field.
