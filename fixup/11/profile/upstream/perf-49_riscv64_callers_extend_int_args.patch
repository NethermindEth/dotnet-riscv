 //------------------------------------------------------------------------
+// IsInt32ResultSignExtended: whether an INT call returns its result sign-extended from 32 bits.
+//
+// Arguments:
+//    comp - the compiler
+//    call - the INT call
+//
+// Notes:
+//    The RV64 psABI has the callee sign-extend a 32-bit integer result, and every INT return of
+//    compiled code is extended (see genSimpleReturn), as is every INT argument (see genPutArgReg).
+//    Both are relied on only under NativeAOT, where all managed code comes from this JIT and the
+//    runtime's native-to-managed transitions extend what they pass (RhpThrowHwEx), and only for calls
+//    into managed code: P/Invokes and internal calls (FCalls, RuntimeImports) reach native code whose
+//    declared return type may be wider than the managed one. Helpers and struct returns, whose
+//    register holds a struct's bytes, are not relied on either.
+//
+bool Lowering::IsInt32ResultSignExtended(Compiler* comp, const GenTreeCall* call)
+{
+    return comp->IsTargetAbi(CORINFO_NATIVEAOT_ABI) && genActualTypeIsInt(call) && !call->IsHelperCall() &&
+           !call->IsUnmanaged() && ((call->gtCallMoreFlags & GTF_CALL_M_NOGCCHECK) == 0) &&
+           varTypeIsIntegral(call->gtReturnType);
+}
+
+//------------------------------------------------------------------------
 // IsInt32SignExtendedInReg: whether the register holding the value of an INT node is known to be the
 // sign extension of its low 32 bits.
 //
