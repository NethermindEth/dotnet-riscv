 //------------------------------------------------------------------------
+// IsInt32ResultSignExtended: whether an INT call returns its result sign-extended from 32 bits.
+//
+// Notes:
+//    The RV64 psABI has the callee sign-extend a 32-bit integer result, and every INT return of
+//    compiled code is extended (see genSimpleReturn), so the caller can rely on it. Helpers and
+//    struct returns, whose register holds a struct's bytes, are not relied on.
+//
+bool Lowering::IsInt32ResultSignExtended(const GenTreeCall* call)
+{
+    return genActualTypeIsInt(call) && !call->IsHelperCall() && varTypeIsIntegral(call->gtReturnType);
+}
