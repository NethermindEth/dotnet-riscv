--- a/src/libraries/System.Private.CoreLib/src/System/Math.cs
+++ b/src/libraries/System.Private.CoreLib/src/System/Math.cs
@@ -254,6 +254,7 @@ static ulong SoftwareFallback(ulong a, ulong b, out ulong low)
         /// <param name="b">The second number to multiply.</param>
         /// <param name="low">The low 64-bit of the product of the specified numbers.</param>
         /// <returns>The high 64-bit of the product of the specified numbers.</returns>
+        [Intrinsic] // RISC-V (M): mul + mulh, expanded by the JIT like the unsigned overload; this body is the fallback
         public static long BigMul(long a, long b, out long low)
         {
 #if !MONO // X86Base.BigMul is not yet implemented in MONO
