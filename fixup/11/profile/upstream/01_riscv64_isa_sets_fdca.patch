diff --git a/src/coreclr/jit/compiler.cpp b/src/coreclr/jit/compiler.cpp
index 137d4aef..6e323316 100644
--- a/src/coreclr/jit/compiler.cpp
+++ b/src/coreclr/jit/compiler.cpp
@@ -1941,6 +1941,35 @@ void Compiler::compSetProcessor()
 
     // Add virtual vector ISA. Vector128 is part of the required Wasm SIMD baseline.
     instructionSetFlags.AddInstructionSet(InstructionSet_Vector128);
+#elif defined(TARGET_RISCV64)
+    // Ensure the required baseline ISA is supported in JIT code, even if not passed in by the VM.
+    instructionSetFlags.AddInstructionSet(InstructionSet_RiscV64Base);
+
+    // F/D/C/A are part of the rv64gc baseline the VM (or AOT driver) seeds by
+    // default. Honor explicit config opt-outs here, so reduced-ISA targets can
+    // drop them with the DOTNET_/-codegenopt knobs no matter how the flags were
+    // seeded; the validity pass below also drops D when F is disabled.
+    if (JitConfig.EnableRiscV64F() == 0)
+    {
+        instructionSetFlags.RemoveInstructionSet(InstructionSet_F);
+    }
+
+    if (JitConfig.EnableRiscV64D() == 0)
+    {
+        instructionSetFlags.RemoveInstructionSet(InstructionSet_D);
+    }
+
+    if (JitConfig.EnableRiscV64Compressed() == 0)
+    {
+        instructionSetFlags.RemoveInstructionSet(InstructionSet_C);
+    }
+
+    if (JitConfig.EnableRiscV64Atomic() == 0)
+    {
+        instructionSetFlags.RemoveInstructionSet(InstructionSet_A);
+    }
+
+    instructionSetFlags = EnsureInstructionSetFlagsAreValid(instructionSetFlags);
 #endif // TARGET_ARM64
 
     assert(instructionSetFlags.Equals(EnsureInstructionSetFlagsAreValid(instructionSetFlags)));
@@ -6196,6 +6225,26 @@ int Compiler::compCompileAfterInit(CORINFO_MODULE_HANDLE classPtr,
         {
             instructionSetFlags.AddInstructionSet(InstructionSet_Zicond);
         }
+
+        if (JitConfig.EnableRiscV64F() != 0)
+        {
+            instructionSetFlags.AddInstructionSet(InstructionSet_F);
+        }
+
+        if (JitConfig.EnableRiscV64D() != 0)
+        {
+            instructionSetFlags.AddInstructionSet(InstructionSet_D);
+        }
+
+        if (JitConfig.EnableRiscV64Compressed() != 0)
+        {
+            instructionSetFlags.AddInstructionSet(InstructionSet_C);
+        }
+
+        if (JitConfig.EnableRiscV64Atomic() != 0)
+        {
+            instructionSetFlags.AddInstructionSet(InstructionSet_A);
+        }
 #endif
 
