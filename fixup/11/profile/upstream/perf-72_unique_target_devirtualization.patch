 //------------------------------------------------------------------------
+// impDevirtualizeToUniqueTarget: devirtualize a call whose receiver type is not known exactly, when every
+//    class the receiver can have resolves the call to the same method.
+//
+// Arguments:
+//     call               - the virtual or interface call
+//     method             - [IN/OUT] method handle for the call, updated to the target
+//     methodFlags        - [IN/OUT] flags of the method, updated to the target's
+//     contextHandle      - [IN/OUT] context handle for the call
+//     exactContextHandle - [OUT] exact context of the target, if not nullptr
+//     baseMethod         - the virtual method called
+//     objClass           - the best known class (or interface) of the receiver
+//     objIsNonNull       - whether the receiver is known non-null
+//     isExplicitTailCall - whether the call is an explicit tail call
+//     ilOffset           - IL offset of the call
+//
+// Returns:
+//     true if the call was transformed into a direct call.
+//
+// Notes:
+//     Only NativeAOT knows the classes that can implement or derive from a type (getExactClasses, from its
+//     whole program view). Guarded devirtualization uses them for up to a few classes with a type test per
+//     class. When the classes are more, but all of them resolve the call to one method - a class hierarchy
+//     whose members implement an interface or override a virtual once, at the root - no test is needed and
+//     the call becomes a direct call, with an explicit null check if the receiver may be null.
+//
+bool Compiler::impDevirtualizeToUniqueTarget(GenTreeCall*            call,
+                                             CORINFO_METHOD_HANDLE*  method,
+                                             unsigned*               methodFlags,
+                                             CORINFO_CONTEXT_HANDLE* contextHandle,
+                                             CORINFO_CONTEXT_HANDLE* exactContextHandle,
+                                             CORINFO_METHOD_HANDLE   baseMethod,
+                                             CORINFO_CLASS_HANDLE    objClass,
+                                             bool                    objIsNonNull,
+                                             bool                    isExplicitTailCall,
+                                             IL_OFFSET               ilOffset)
+{
+    if (!IsNativeAot() || !JitConfig.JitEnableExactDevirtualization() || (objClass == NO_CLASS_HANDLE) ||
+        call->IsGenericVirtual(this) || ((call->gtCallMoreFlags & GTF_CALL_M_GUARDED_DEVIRT) != 0))
+    {
+        return false;
+    }
+
+    const int            maxClasses = 64;
+    CORINFO_CLASS_HANDLE exactClasses[maxClasses];
+    const int            numClasses = info.compCompHnd->getExactClasses(objClass, maxClasses, exactClasses);
+    if (numClasses <= 0)
+    {
+        return false;
+    }
+
+    CORINFO_DEVIRTUALIZATION_INFO dvInfo;
+    CORINFO_METHOD_HANDLE         target = nullptr;
+    for (int i = 0; i < numClasses; i++)
+    {
+        if ((info.compCompHnd->getClassAttribs(exactClasses[i]) & CORINFO_FLG_VALUECLASS) != 0)
+        {
+            return false;
+        }
+
+        dvInfo.virtualMethod               = baseMethod;
+        dvInfo.objClass                    = exactClasses[i];
+        dvInfo.context                     = *contextHandle;
+        dvInfo.detail                      = CORINFO_DEVIRTUALIZATION_UNKNOWN;
+        dvInfo.pResolvedTokenVirtualMethod = nullptr;
+        if (!info.compCompHnd->resolveVirtualMethod(&dvInfo) || (dvInfo.devirtualizedMethod == nullptr) ||
+            ((target != nullptr) && (dvInfo.devirtualizedMethod != target)))
+        {
+            return false;
+        }
+
+        target = dvInfo.devirtualizedMethod;
+    }
+
+    // The classes share the target, not necessarily its lookup context: take the context of the class that
+    // declares it, which is only sound when its code is not shared between instantiations.
+    CORINFO_CLASS_HANDLE const ownerClass = info.compCompHnd->getMethodClass(target);
+    CORINFO_SIG_INFO           targetSig;
+    info.compCompHnd->getMethodSig(target, &targetSig);
+    if (targetSig.hasTypeArg() || ((info.compCompHnd->getClassAttribs(ownerClass) & CORINFO_FLG_SHAREDINST) != 0))
+    {
+        return false;
+    }
+
+    JITDUMP("All %d classes of %s resolve %s to %s: devirtualizing\n", numClasses, eeGetClassName(objClass),
+            eeGetMethodFullName(baseMethod), eeGetMethodFullName(target));
+
+    unsigned targetAttribs = info.compCompHnd->getMethodAttribs(target);
+
+    DevirtualizedCallInfo dcInfo;
+    dcInfo.tokenLookupContext    = MAKE_CLASSCONTEXT(ownerClass);
+    dcInfo.pInstParamLookup      = &dvInfo.instParamLookup;
+    dcInfo.pResolvedToken        = &dvInfo.resolvedTokenDevirtualizedMethod;
+    dcInfo.pUnboxedResolvedToken = &dvInfo.resolvedTokenDevirtualizedUnboxedMethod;
+    dcInfo.pMethSig              = &targetSig;
+    dcInfo.objIsNonNull          = objIsNonNull;
+    dcInfo.hadImplicitNullCheck  = true;
+    dcInfo.isDelegateCall        = false;
+    dcInfo.isExplicitTailCall    = isExplicitTailCall;
+    dcInfo.objClassIsExact       = false;
+    dcInfo.objClassIsFinal       = false;
+    dcInfo.ilOffset              = ilOffset;
+    impTransformDevirtualizedCall(call, &target, &targetAttribs, &dcInfo, compCurBB,
+                                  contextHandle COMMA_INDEBUG(baseMethod));
+
+    *method      = target;
+    *methodFlags = targetAttribs;
+    if (exactContextHandle != nullptr)
+    {
+        *exactContextHandle = dcInfo.tokenLookupContext;
+    }
+
+    return true;
+}
+
+//------------------------------------------------------------------------
 // impTransformDevirtualizedCall: transform a resolved virtual call target
 //    into a direct call.
 //
