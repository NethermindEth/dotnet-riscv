 //------------------------------------------------------------------------
+// IsZeroExtendableIntLoad: whether a node is an INT load that could load with lwu instead of lw.
+//
+static bool IsZeroExtendableIntLoad(GenTree* node)
+{
+    if (!node->TypeIs(TYP_INT) || node->isContained())
+        return false;
+
+    // Only a GT_LCL_VAR that is not enregistered loads at its use (genCodeForLclVar).
+    return (node->OperIs(GT_IND) && !node->AsIndir()->IsVolatile()) || node->OperIs(GT_LCL_VAR, GT_LCL_FLD);
+}
+
+//------------------------------------------------------------------------
+// IsInt32RangeNonNegative: whether an operand holds a value in [0, INT32_MAX], so that it reads the same against
+// the zero and the sign extension of an INT.
+//
+static bool IsInt32RangeNonNegative(Compiler* comp, GenTree* node)
+{
+    if (node->IsIntegralConst())
+    {
+        const INT64 value = node->AsIntConCommon()->IntegralValue();
+        return !node->IsIconHandle() && (value >= 0) && (value <= INT32_MAX);
+    }
+
+    return genActualTypeIsInt(node) && Lowering::IsInt32NonNegativeInReg(comp, node);
+}
+
+//------------------------------------------------------------------------
+// IsUpperHalfIgnored: whether a user reads the same result from an INT operand whether its register holds
+// the sign or the zero extension of the operand's low 32 bits.
+//
+// Arguments:
+//    comp - the compiler
+//    user - the user
+//    op   - the INT operand, a zero-extendable load
+//
+static bool IsUpperHalfIgnored(Compiler* comp, GenTree* user, GenTree* op)
+{
+    if (user->isContained())
+        return false;
+
+    GenTree* other = nullptr;
+    bool     equalityOrUnsigned;
+    switch (user->OperGet())
+    {
+        case GT_STOREIND:
+            // sw/sh/sb store the low bits.
+            return (user->AsStoreInd()->Data() == op) && (genTypeSize(user) <= 4);
+
+        case GT_STORE_LCL_FLD:
+            return (user->AsLclFld()->Data() == op) && (genTypeSize(user) <= 4);
+
+        case GT_ADD:
+        case GT_SUB:
+        case GT_MUL:
+        case GT_NEG:
+            // addw/subw/mulw/negw read the low 32 bits. (Not the overflow checks, nor DIV/MOD, whose
+            // INT_MIN / -1 check compares full registers.)
+            return user->TypeIs(TYP_INT) && !user->gtOverflow();
+
+        case GT_LSH:
+        case GT_RSH:
+        case GT_RSZ:
+            // sllw/sraw/srlw read the low 32 bits of the value; every shift reads only the low bits of its count.
+            return user->TypeIs(TYP_INT) || (user->gtGetOp2() == op);
+
+        case GT_CAST:
+            // A cast to a small type reads the low 8 or 16 bits.
+            return !user->gtOverflow() && varTypeIsSmall(user->AsCast()->CastToType());
+
+        case GT_AND:
+            // AND with a value in [0, INT32_MAX] clears the upper half and bit 31 either way.
+            other = (user->gtGetOp1() == op) ? user->gtGetOp2() : user->gtGetOp1();
+            return IsInt32RangeNonNegative(comp, other);
+
+        case GT_EQ:
+        case GT_NE:
+        case GT_LT:
+        case GT_LE:
+        case GT_GE:
+        case GT_GT:
+            other              = (user->gtGetOp1() == op) ? user->gtGetOp2() : user->gtGetOp1();
+            equalityOrUnsigned = user->OperIs(GT_EQ, GT_NE) || user->IsUnsigned();
+            break;
+
+        case GT_JCMP:
+            other              = (user->gtGetOp1() == op) ? user->gtGetOp2() : user->gtGetOp1();
+            equalityOrUnsigned = user->AsOpCC()->gtCondition.Is(GenCondition::EQ, GenCondition::NE) ||
+                                 user->AsOpCC()->gtCondition.IsUnsigned();
+            break;
+
+        case GT_BOUNDS_CHECK:
+        {
+            // bgeu index, length. A zero-extended length can only fail more indices, and only when the length
+            // is negative, which an array, string or span length never is.
+            GenTreeBoundsChk* const check = user->AsBoundsChk();
+            if (check->GetArrayLength() == op)
+                return true;
+
+            other              = check->GetArrayLength();
+            equalityOrUnsigned = true;
+            break;
+        }
+
+        default:
+            return false;
+    }
+
+    // Against a value in [0, INT32_MAX], equality and unsigned order read the same from either extension.
+    return equalityOrUnsigned && IsInt32RangeNonNegative(comp, other);
+}
+
+//------------------------------------------------------------------------
+// MarkZeroExtendedLoads: load with lwu the INT loads whose user ignores their upper 32 bits, and narrow
+// the INT loads that only feed a cast to a small type or a mask of their low byte or halfword.
+//
+// Notes:
+//    An INT is sign-extended in its register, so an INT load is an lw. Under ZisK, lw is a load plus a
+//    sign-extension operation proved by the BinaryExtension state machine, while lwu is a plain load. A
+//    load whose single user reads only its low 32 bits, or compares it in a way the two extensions agree
+//    on, may leave the upper half zero (GTF_ZEXT_LOAD). A spill of such a load reloads it with lw, which
+//    the same user accepts. LowerArrLength marks an array or string length whatever its user: it lies in
+//    [0, INT32_MAX], where both loads agree.
+//    A cast to a small type of an INT load, or an AND of it with 0xFF or 0xFFFF, needs only the load's low
+//    bytes, which a narrower load at the same address reads directly (little-endian).
+//    This runs last in lowering: the users above take nothing from IsInt32SignExtendedInReg about the
+//    operand, so nothing reads the sign extension a marked load no longer provides.
+//
+void Lowering::MarkZeroExtendedLoads()
+{
+    if (m_compiler->opts.OptimizationDisabled() || m_compiler->opts.IsOSR())
+        return;
+
+    for (BasicBlock* const block : m_compiler->Blocks())
+    {
+        LIR::Range& range = LIR::AsRange(block);
+        for (GenTree* node = range.FirstNode(); node != nullptr; node = node->gtNext)
+        {
+            if (!IsZeroExtendableIntLoad(node))
+                continue;
+
+            LIR::Use use;
+            if (!range.TryGetUse(node, &use))
+                continue;
+
+            GenTree* const user = use.User();
+            if (node->OperIs(GT_IND) && !user->isContained())
+            {
+                // (byte)/(short)/(ushort)/(sbyte) of the load, or the load & 0xFF / 0xFFFF.
+                var_types narrowType = TYP_UNDEF;
+                GenTree*  mask       = nullptr;
+                if (user->OperIs(GT_CAST) && !user->gtOverflow() && varTypeIsSmall(user->AsCast()->CastToType()))
+                {
+                    narrowType = user->AsCast()->CastToType();
+                }
+                else if (user->OperIs(GT_AND) && user->TypeIs(TYP_INT))
+                {
+                    mask = (user->gtGetOp1() == node) ? user->gtGetOp2() : user->gtGetOp1();
+                    if (mask->IsIntegralConst(0xFF))
+                    {
+                        narrowType = TYP_UBYTE;
+                    }
+                    else if (mask->IsIntegralConst(0xFFFF))
+                    {
+                        narrowType = TYP_USHORT;
+                    }
+                }
+
+                LIR::Use narrowUse;
+                if ((narrowType != TYP_UNDEF) && range.TryGetUse(user, &narrowUse))
+                {
+                    node->ChangeType(narrowType);
+                    node->gtFlags &= ~GTF_ZEXT_LOAD;
+                    narrowUse.ReplaceWith(node);
+                    range.Remove(user);
+                    if (mask != nullptr)
+                    {
+                        range.Remove(mask);
+                    }
+                    continue;
+                }
+            }
+
+            if (IsUpperHalfIgnored(m_compiler, user, node))
+                node->gtFlags |= GTF_ZEXT_LOAD;
+        }
+    }
+}
