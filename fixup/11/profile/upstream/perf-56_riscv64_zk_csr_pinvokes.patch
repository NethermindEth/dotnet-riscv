+//------------------------------------------------------------------------
+// zkCsrForPInvoke: the CSR a P/Invoke stands for on the zkVM, or -1 for an ordinary call.
+//
+// Arguments:
+//    call - a call node
+//
+// Return Value:
+//    The CSR number when `call` is an unmanaged call whose entry point is listed in
+//    JitZkCsrPInvokes and takes exactly one argument (the operand address); otherwise -1.
+//
+// Notes:
+//    See JitZkCsrPInvokes. The decision is purely name based, so it is cheap enough to ask
+//    again at each consumer (LSRA kills, call codegen, the leaf RA-elision scan) rather than
+//    carried on the node.
+//
+int Compiler::zkCsrForPInvoke(GenTreeCall* call)
+{
+    if (!call->IsUnmanaged() || (call->gtCallType != CT_USER_FUNC) || (call->gtCallMethHnd == nullptr) ||
+        call->IsFastTailCall() || (call->gtArgs.CountArgs() != 1))
+    {
+        return -1;
+    }
+
+    const char* cfg = JitConfig.JitZkCsrPInvokes();
+    if ((cfg == nullptr) || (*cfg == '\0'))
+    {
+        return -1;
+    }
+
+    // The P/Invoke the JIT sees is either the DllImport itself or, for a LibraryImport, the
+    // generated local function named "<EntryPoint>g____PInvoke|N_M"; both carry the entry
+    // point name, which is what the config lists.
+    const char* methodName = info.compCompHnd->getMethodNameFromMetadata(call->gtCallMethHnd, nullptr, nullptr, nullptr, 0);
+    if (methodName == nullptr)
+    {
+        return -1;
+    }
+    const char* name    = methodName;
+    size_t      nameLen = strlen(name);
+    if (name[0] == '<')
+    {
+        const char* close = strchr(name, '>');
+        if (close == nullptr)
+        {
+            return -1;
+        }
+        name++;
+        nameLen = (size_t)(close - name);
+    }
+
+    // Each entry is "EntryPoint:hex"; entries are separated by ',' (shell-neutral).
+    const char* p = cfg;
+    while (*p != '\0')
+    {
+        const char* entryEnd = p;
+        while ((*entryEnd != '\0') && (*entryEnd != ','))
+        {
+            entryEnd++;
+        }
+
+        const char* colon = nullptr;
+        for (const char* q = p; q < entryEnd; q++)
+        {
+            if (*q == ':')
+            {
+                colon = q;
+            }
+        }
+
+        if ((colon != nullptr) && ((size_t)(colon - p) == nameLen) && (strncmp(name, p, nameLen) == 0))
+        {
+            int value = 0;
+            for (const char* q = colon + 1; q < entryEnd; q++)
+            {
+                int digit;
+                if ((*q >= '0') && (*q <= '9'))
+                {
+                    digit = *q - '0';
+                }
+                else if ((*q >= 'a') && (*q <= 'f'))
+                {
+                    digit = *q - 'a' + 10;
+                }
+                else if ((*q >= 'A') && (*q <= 'F'))
+                {
+                    digit = *q - 'A' + 10;
+                }
+                else
+                {
+                    return -1;
+                }
+                value = (value << 4) | digit;
+                if (value > 0xFFF)
+                {
+                    return -1;
+                }
+            }
+            return (colon + 1 < entryEnd) ? value : -1;
+        }
+
+        p = (*entryEnd == ',') ? entryEnd + 1 : entryEnd;
+    }
+
+    return -1;
+}
+
