 //------------------------------------------------------------------------
+// TryTailCallNoReturn: make a call that never returns, ending a throw block, a fast tail call.
+//
+// Arguments:
+//    call - the call being lowered
+//
+// Notes:
+//    Nothing runs after such a call, so jumping to it after the epilog changes no behavior, and a
+//    method whose other calls are fast tail calls then needs no RA save and often no frame (see
+//    genComputeLeafRaElision). An exception the callee throws unwinds straight into the caller, where
+//    it goes anyway from a method without EH clauses, with the callee-saved registers the epilog
+//    restored. The frame is gone while the callee runs, so no local may have its address taken and
+//    every argument travels in a register. Only a stack trace would miss the frame, so this follows the
+//    zkVM-guest knob RiscV64ElideLeafRaSave.
+//
+void Lowering::TryTailCallNoReturn(GenTreeCall* call)
+{
+    if ((JitConfig.RiscV64ElideLeafRaSave() == 0) || m_compiler->opts.OptimizationDisabled() ||
+        m_compiler->opts.IsOSR() || !call->IsNoReturn() || call->IsTailCall() || (call->gtCallType != CT_USER_FUNC) ||
+        call->IsVirtual() || call->IsUnmanaged() || call->IsDelegateInvoke() || call->IsAsync() ||
+        call->IsSpecialIntrinsic() || call->gtArgs.HasRetBuffer() || call->IsR2ROrVirtualStubRelativeIndir() ||
+        call->HasNonStandardAddedArgs(m_compiler) || !m_block->KindIs(BBJ_THROW) || (BlockRange().LastNode() != call))
+    {
+        return;
+    }
+
+    if ((m_compiler->compHndBBtabCount != 0) || m_compiler->compLocallocUsed || m_compiler->info.compIsVarArgs ||
+        ((m_compiler->info.compFlags & CORINFO_FLG_SYNCH) != 0) || m_compiler->opts.IsReversePInvoke() ||
+        m_compiler->compMethodRequiresPInvokeFrame() || m_compiler->getNeedsGSSecurityCookie() ||
+        m_compiler->compIsProfilerHookNeeded() || m_compiler->compIsAsync())
+    {
+        return;
+    }
+
+    for (CallArg& arg : call->gtArgs.Args())
+    {
+        if (arg.AbiInfo.HasAnyStackSegment())
+        {
+            return;
+        }
+    }
+
+    for (unsigned lclNum = 0; lclNum < m_compiler->lvaCount; lclNum++)
+    {
+        const LclVarDsc* const varDsc = m_compiler->lvaGetDesc(lclNum);
+        if (varDsc->lvPinned || (varDsc->IsAddressExposed() && (lclNum != m_compiler->lvaOutgoingArgSpaceVar)))
+        {
+            return;
+        }
+    }
+
+    JITDUMP("Tail calling no-return call [%06u]\n", Compiler::dspTreeID(call));
+    call->gtCallMoreFlags |= GTF_CALL_M_TAILCALL;
+    m_compiler->compTailCallUsed = true;
+    m_block->SetKindAndTargetEdge(BBJ_RETURN);
+    m_block->SetFlags(BBF_HAS_JMP);
+}
+
