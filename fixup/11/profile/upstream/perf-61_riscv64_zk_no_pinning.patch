 // caller-saved register whenever one is free, and only call-spanning intervals pay for
 // callee-saved ones.
 RELEASE_CONFIG_INTEGER(JitRiscV64LsraCallerCalleeFirst, "JitRiscV64LsraCallerCalleeFirst", 1)
+// zkVM: the uGC never moves objects, so a `fixed` (pinned) local need not be pinned. Pinned locals
+// cannot be enregistered and are zero-initialized in the prolog and cleared after use; treating them
+// as ordinary byrefs/pointers removes that traffic (the keccak and span helpers pin on every call).
+// Non-zero drops the pinned attribute at import. Default 0 (standard semantics).
+RELEASE_CONFIG_INTEGER(JitZkNoPinning, "JitZkNoPinning", 0)
