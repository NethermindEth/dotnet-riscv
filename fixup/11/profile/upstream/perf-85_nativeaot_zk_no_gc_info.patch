+        // The GC info of the main LSDA. With OmitGcInfo, only a reverse P/Invoke method keeps it:
+        // its unwind reads the frame from it (UnixNativeCodeManager::UnwindStackFrame). The rest is
+        // read only to report a frame to the GC (EnumGcRefs) or to find a safe point (IsSafePoint,
+        // return address hijacking), which a GC that never scans a stack does not do. The dispatch
+        // of an exception reads the flags and the pointers before it.
+        private static byte[] GcInfoToEmit(INodeWithCodeInfo nodeWithCodeInfo, bool omitGcInfo)
+        {
+            if (omitGcInfo && (nodeWithCodeInfo.FrameInfos[0].Flags & FrameInfoFlags.ReversePInvoke) == 0)
+                return null;
+            return nodeWithCodeInfo.GCInfo;
+        }
