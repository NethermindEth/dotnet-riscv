 #include "CommonTypes.h"
 #include "CommonMacros.h"
@@ -24,6 +25,25 @@
 
 #if defined(TARGET_APPLE)
 #include <mach-o/compact_unwind_encoding.h>
+
+// The unwind-info/LSDA side tables are byte-packed, so the 32-bit fields below sit
+// at arbitrary byte offsets. Read them through memcpy: the compiler expands that
+// into byte loads on a target without unaligned-access support, whereas a plain
+// wide load traps on executors that reject misaligned access (SP1, OpenVM).
+static inline int32_t ReadInt32Unaligned(const void* p)
+{
+    int32_t v;
+    memcpy(&v, p, sizeof(v));
+    return v;
+}
+
+static inline uint32_t ReadUInt32Unaligned(const void* p)
+{
+    uint32_t v;
+    memcpy(&v, p, sizeof(v));
+    return v;
+}
+
 #endif // TARGET_APPLE
 
 #if defined(TARGET_ARM64)
@@ -138,11 +158,11 @@
 #endif // TARGET_APPLE
 
