NativeAOT runtime: read the byte-packed unwind/LSDA side tables without
misaligned wide loads. UnixNativeCodeManager (FDE length, LSDA and method
start offsets, EH info offset, associated data) and RuntimeInstance (unboxing
stub target) read int32 fields at arbitrary byte offsets with a plain
*(int32_t*) cast; on SP1 that is a fatal LW/LD at a misaligned address (the
first one the guest hits is EHEnumInit). Go through memcpy, which the
compiler expands into byte loads on a target without unaligned-access
support.

--- a/src/coreclr/nativeaot/Runtime/RuntimeInstance.cpp	2026-09-11 15:22:30
+++ b/src/coreclr/nativeaot/Runtime/RuntimeInstance.cpp	2026-09-11 15:22:58
@@ -2,6 +2,7 @@
 // The .NET Foundation licenses this file to you under the MIT license.
 
 #include "common.h"
+#include <string.h>
 #include "CommonTypes.h"
 #include "CommonMacros.h"
 #include "daccess.h"
@@ -153,7 +154,14 @@
             uint8_t flags = *pData++;
 
             if ((flags & (uint8_t)AssociatedDataFlags::HasUnboxingStubTarget) != 0)
-                return pData + *dac_cast<PTR_int32_t>(pData);
+            {
+                // Byte-packed side table: read through memcpy so the compiler emits
+                // byte loads rather than a wide load that traps on targets that reject
+                // misaligned access (SP1, OpenVM).
+                int32_t offset;
+                memcpy(&offset, pData, sizeof(offset));
+                return pData + offset;
+            }
         }
     }
 
