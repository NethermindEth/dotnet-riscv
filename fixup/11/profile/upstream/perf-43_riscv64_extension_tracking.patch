+// IsInt32NonNegativeInReg: whether the register holding the value of an INT node is known to lie in
+// [0, INT32_MAX], so that its 32-bit zero and sign extensions are the register itself.
+//
+// Arguments:
+//    comp  - the compiler
+//    node  - the INT node (a GT_COPY/GT_RELOAD of one is looked through)
+//    depth - recursion depth
+//
+// Notes:
+//    Only producers whose instruction selection guarantees the range are recognized. The property
+//    survives a spill and reload, which reloads the low 32 bits sign-extended. Locals are known only
+//    after lowering (see ComputeSignExtendedLocals).
+//
+bool Lowering::IsInt32NonNegativeInReg(Compiler* comp, GenTree* node, unsigned depth)
+{
+    node = node->gtSkipReloadOrCopy();
+    if (!genActualTypeIsInt(node) || (depth > 4))
+        return false;
+
+    if (node->IsCnsIntOrI())
+    {
+        const ssize_t value = node->AsIntCon()->IconValue();
+        return !node->IsIconHandle() && (value >= 0) && (value <= INT32_MAX);
+    }
+
+    if (node->isContained())
+        return false;
+
+    switch (node->OperGet())
+    {
+        case GT_EQ:
+        case GT_NE:
+        case GT_LT:
+        case GT_LE:
+        case GT_GE:
+        case GT_GT:
+            // slt(i)(u) / feq / flt / fle, optionally followed by xori 1: 0 or 1.
+            return true;
+
+        case GT_IND:
+        case GT_LCL_FLD:
+            // lbu / lhu (or their byte-wise equivalent).
+            return node->TypeIs(TYP_UBYTE, TYP_USHORT);
+
+        case GT_CAST:
+            // andi 0xff / zext.h / slli+srli.
+            return !node->gtOverflow() && varTypeIsIntegral(node->AsCast()->CastOp()) &&
+                   varTypeIsSmall(node->AsCast()->CastToType()) && varTypeIsUnsigned(node->AsCast()->CastToType());
+
+        case GT_AND:
+            return IsInt32NonNegativeInReg(comp, node->gtGetOp1(), depth + 1) ||
+                   IsInt32NonNegativeInReg(comp, node->gtGetOp2(), depth + 1);
+
+        case GT_RSZ:
+            // srliw by 1..31 clears bit 31 of the result it sign-extends.
+            return node->gtGetOp2()->IsCnsIntOrI() && ((node->gtGetOp2()->AsIntCon()->IconValue() & 31) != 0);
+
+        case GT_LCL_VAR:
+        {
+            // A local that lives on the frame is loaded at every use, with lbu/lhu for these node types.
+            const LclVarDsc* const varDsc = comp->lvaGetDesc(node->AsLclVar());
+            return varDsc->lvNonNegativeInt || (varDsc->lvDoNotEnregister && node->TypeIs(TYP_UBYTE, TYP_USHORT));
+        }
+
+        default:
+            return false;
+    }
+}
+
+//------------------------------------------------------------------------
+// IsInt32SignExtendedInReg: whether the register holding the value of an INT node is known to be the
+// sign extension of its low 32 bits.
+//
+// Arguments:
+//    comp  - the compiler
+//    node  - the INT node (a GT_COPY/GT_RELOAD of one is looked through)
+//    depth - recursion depth
+//
+// Notes:
+//    Arithmetic, shifts, compares and atomics are the nodes SignExtendIfNecessary already trusts
+//    (their W-form instructions sign-extend). Loads use lw/lh/lb/lhu/lbu, and a cast to INT is
+//    either a sign/zero extension or, from INT, a copy of its operand. Locals are known only
+//    after lowering (see ComputeSignExtendedLocals).
+//
+bool Lowering::IsInt32SignExtendedInReg(Compiler* comp, GenTree* node, unsigned depth)
+{
+    node = node->gtSkipReloadOrCopy();
+    if (!genActualTypeIsInt(node) || (depth > 4))
+        return false;
+
+    if (IsInt32NonNegativeInReg(comp, node, depth))
+        return true;
+
+    if (node->IsCnsIntOrI())
+        return !node->IsIconHandle() && (node->AsIntCon()->IconValue() == (int32_t)node->AsIntCon()->IconValue());
+
+    if (node->isContained())
+        return false;
+
+    if (node->OperIs(GT_ADD, GT_SUB, GT_MUL, GT_MOD, GT_UMOD, GT_DIV, GT_UDIV, GT_NEG) || node->OperIsShiftOrRotate() ||
+        node->OperIsCmpCompare() || node->OperIsAtomicOp())
+        return true;
+
+    switch (node->OperGet())
+    {
+        case GT_IND:
+        case GT_LCL_FLD:
+            return node->TypeIs(TYP_INT, TYP_BYTE, TYP_SHORT);
+
+        case GT_CAST:
+        {
+            GenTree* const src = node->AsCast()->CastOp();
+            if (node->gtOverflow() || !varTypeIsIntegral(src))
+                return false;
+            // To a small type: an extension; from LONG: sext.w; from INT: a copy.
+            if (varTypeIsSmall(node->AsCast()->CastToType()) || !genActualTypeIsInt(src))
+                return true;
+            return IsInt32SignExtendedInReg(comp, src, depth + 1);
+        }
+
+        case GT_AND:
+        case GT_OR:
+        case GT_XOR:
+            return IsInt32SignExtendedInReg(comp, node->gtGetOp1(), depth + 1) &&
+                   IsInt32SignExtendedInReg(comp, node->gtGetOp2(), depth + 1);
+
+        case GT_NOT:
+            return IsInt32SignExtendedInReg(comp, node->gtGetOp1(), depth + 1);
+
+        case GT_LCL_VAR:
+        {
+            // A local that lives on the frame is loaded at every use, with lw/lh/lb/lhu/lbu for these node types.
+            const LclVarDsc* const varDsc = comp->lvaGetDesc(node->AsLclVar());
+            return varDsc->lvSignExtendedInt ||
+                   (varDsc->lvDoNotEnregister && node->TypeIs(TYP_INT, TYP_BYTE, TYP_UBYTE, TYP_SHORT, TYP_USHORT));
+        }
+
+        default:
+            return false;
+    }
+}
+
+//------------------------------------------------------------------------
+// ComputeSignExtendedLocals: find the locals whose register always holds a value sign-extended from 32
+// bits, or one in [0, INT32_MAX], and record them in LclVarDsc::lvSignExtendedInt / lvNonNegativeInt.
+//
+// Notes:
+//    Runs on the final LIR. A local qualifies when every definition is a GT_STORE_LCL_VAR of a value
+//    IsInt32SignExtendedInReg (IsInt32NonNegativeInReg) accepts, other locals included, hence the
+//    optimistic fixed point. An INT parameter, or an INT local a parameter register maps to from its
+//    low bits, is also defined by its incoming register, which the caller need not have extended:
+//    genHomeRegisterParams sign-extends it in place if the local keeps lvSignExtendedInt (a moved one is
+//    extended by the move, a spilled one reloaded by lw). Likewise a store of an INT call result, which
+//    genCodeForStoreLclVar sign-extends in place. A promoted field qualifies only while its struct is
+//    never defined as a whole.
+//
+void Lowering::ComputeSignExtendedLocals()
+{
+    for (unsigned lclNum = 0; lclNum < m_compiler->lvaCount; lclNum++)
+    {
+        LclVarDsc* const varDsc = m_compiler->lvaGetDesc(lclNum);
+        bool             candidate;
+        if (varDsc->IsAddressExposed())
+        {
+            candidate = false;
+        }
+        else if (varDsc->lvIsParamRegTarget)
+        {
+            // Only as the sole target of its register, mapped from the register's low bits.
+            candidate = varDsc->TypeIs(TYP_INT) && (m_compiler->m_paramRegLocalMappings != nullptr);
+            for (int i = 0; candidate && (i < m_compiler->m_paramRegLocalMappings->Height()); i++)
+            {
+                const ParameterRegisterLocalMapping& mapping = m_compiler->m_paramRegLocalMappings->BottomRef(i);
+                if (mapping.LclNum != lclNum)
+                    continue;
+
+                candidate = (mapping.Offset == 0);
+                for (int j = 0; candidate && (j < m_compiler->m_paramRegLocalMappings->Height()); j++)
+                {
+                    const ParameterRegisterLocalMapping& other = m_compiler->m_paramRegLocalMappings->BottomRef(j);
+                    candidate = (other.LclNum == lclNum) ||
+                                (other.RegisterSegment->GetRegister() != mapping.RegisterSegment->GetRegister());
+                }
+            }
+        }
+        else if (varDsc->lvIsParam)
+        {
+            // Only a parameter itself has ABI info: the promoted fields of a struct parameter inherit
+            // lvIsParam but are numbered past the parameters.
+            candidate = varDsc->TypeIs(TYP_INT) && (lclNum < m_compiler->info.compArgsCount) &&
+                        m_compiler->lvaGetParameterABIInfo(lclNum).HasExactlyOneRegisterSegment() &&
+                        !m_compiler->lvaGetParameterABIInfo(lclNum).HasAnyStackSegment();
+        }
+        else
+        {
+            candidate =
+                !varDsc->lvIsStructField || !m_compiler->lvaGetDesc(varDsc->lvParentLcl)->lvIsParam;
+        }
+
+        varDsc->lvSignExtendedInt = candidate && varDsc->TypeIs(TYP_INT);
+        varDsc->lvNonNegativeInt  = candidate && !varDsc->lvIsParam && !varDsc->lvIsParamRegTarget &&
+                                   varDsc->TypeIs(TYP_INT, TYP_UBYTE, TYP_USHORT);
+    }
+
+    ArrayStack<GenTreeLclVarCommon*> stores(m_compiler->getAllocator(CMK_Lower));
+    for (BasicBlock* const block : m_compiler->Blocks())
+    {
+        for (GenTree* const node : LIR::AsRange(block))
+        {
+            if (!node->OperIsLocalStore() && !node->OperIs(GT_LCL_ADDR))
+                continue;
+
+            LclVarDsc* const varDsc = m_compiler->lvaGetDesc(node->AsLclVarCommon());
+            if (varDsc->lvPromoted)
+            {
+                // The struct is defined, or its address taken, as a whole: so are its fields.
+                for (unsigned i = 0; i < varDsc->lvFieldCnt; i++)
+                {
+                    LclVarDsc* const fieldDsc = m_compiler->lvaGetDesc(varDsc->lvFieldLclStart + i);
+                    fieldDsc->lvSignExtendedInt = false;
+                    fieldDsc->lvNonNegativeInt  = false;
+                }
+            }
+
+            if (!varDsc->lvSignExtendedInt && !varDsc->lvNonNegativeInt)
+                continue;
+
+            if (node->OperIs(GT_STORE_LCL_VAR))
+            {
+                stores.Push(node->AsLclVarCommon());
+            }
+            else
+            {
+                varDsc->lvSignExtendedInt = false;
+                varDsc->lvNonNegativeInt  = false;
+            }
+        }
+    }
+
+    bool changed;
+    do
+    {
+        changed = false;
+        for (int i = 0; i < stores.Height(); i++)
+        {
+            GenTreeLclVarCommon* const store  = stores.Bottom(i);
+            LclVarDsc* const           varDsc = m_compiler->lvaGetDesc(store);
+            if (varDsc->lvSignExtendedInt && !IsInt32SignExtendedInReg(m_compiler, store->Data()) &&
+                !(store->Data()->IsCall() && genActualTypeIsInt(store->Data())))
+            {
+                varDsc->lvSignExtendedInt = false;
+                changed                   = true;
+            }
+            if (varDsc->lvNonNegativeInt && !IsInt32NonNegativeInReg(m_compiler, store->Data()))
+            {
+                varDsc->lvNonNegativeInt = false;
+                changed                  = true;
+            }
+        }
+    } while (changed);
+}
+
+//------------------------------------------------------------------------
+// IsLocalReferencedInRange: whether a node between a local read and its new consumer references the local.
+//
+// Notes:
+//    Moving the read's consumer past such a node could observe a later value or break its last-use marking.
+//
+static bool IsLocalReferencedInRange(GenTree* lclRead, GenTree* endExclusive)
+{
+    const unsigned lclNum = lclRead->AsLclVarCommon()->GetLclNum();
+    for (GenTree* node = lclRead->gtNext; node != endExclusive; node = node->gtNext)
+    {
+        if (node->OperIsAnyLocal() && (node->AsLclVarCommon()->GetLclNum() == lclNum))
+            return true;
+    }
+    return false;
+}
+
+//------------------------------------------------------------------------
+// RemoveRedundantExtensions: drop the 32-to-64-bit extensions whose operand register already holds the
+// extended value, where the user reads its operands as full registers.
+//
+// Notes:
+//    Integer compares, and the 64-bit add/sub, logic, shift and shift-add nodes, select their instruction
+//    from their own type and read full registers, so an operand already sign-extended (or, for a zero
+//    extension, non-negative) gives the same result without its cast. GT_MUL is not one of them: it picks
+//    mulw for two INT operands. Locals are known only after lowering, so this also removes the casts
+//    SignExtendIfNecessary had to insert for them.
+//
+void Lowering::RemoveRedundantExtensions()
+{
+    if (m_compiler->opts.OptimizationDisabled() || m_compiler->opts.IsOSR())
+        return;
+
+    ComputeSignExtendedLocals();
+
+    for (BasicBlock* const block : m_compiler->Blocks())
+    {
+        LIR::Range& range = LIR::AsRange(block);
+        for (GenTree* const node : range)
+        {
+            GenTree** uses[2] = {};
+            if (node->OperIsCmpCompare() || node->OperIs(GT_JCMP))
+            {
+                uses[0] = &node->AsOp()->gtOp1;
+                uses[1] = &node->AsOp()->gtOp2;
+            }
+            else if (node->isContained() || node->gtOverflowEx() || !node->TypeIs(TYP_LONG, TYP_BYREF))
+            {
+                continue;
+            }
+            else if (node->OperIs(GT_ADD, GT_SUB, GT_AND, GT_OR, GT_XOR, GT_SH1ADD, GT_SH2ADD, GT_SH3ADD))
+            {
+                uses[0] = &node->AsOp()->gtOp1;
+                uses[1] = &node->AsOp()->gtOp2;
+            }
+            else if (node->OperIs(GT_LSH, GT_RSH, GT_RSZ, GT_NEG, GT_NOT, GT_RETURN, GT_STORE_LCL_VAR))
+            {
+                uses[0] = &node->AsUnOp()->gtOp1;
+            }
+            else if (node->OperIs(GT_STOREIND))
+            {
+                uses[0] = &node->AsStoreInd()->Data();
+            }
+            else
+            {
+                continue;
+            }
+
+            for (GenTree** const use : uses)
+            {
+                if (use == nullptr)
+                    continue;
+
+                if (!(*use)->OperIs(GT_CAST) || (*use)->gtOverflow() ||
+                    (genTypeSize((*use)->AsCast()->CastToType()) != 8))
+                    continue;
+
+                GenTreeCast* const cast = (*use)->AsCast();
+                GenTree* const     src  = cast->CastOp();
+                if (!genActualTypeIsInt(src) || !varTypeIsIntegral(src))
+                    continue;
+
+                const bool redundant = cast->IsUnsigned() ? IsInt32NonNegativeInReg(m_compiler, src)
+                                                          : IsInt32SignExtendedInReg(m_compiler, src);
+                if (!redundant || (src->OperIs(GT_LCL_VAR) && IsLocalReferencedInRange(src, node)))
+                    continue;
+
+                range.Remove(cast);
+                *use = src;
+            }
+        }
+    }
+}
