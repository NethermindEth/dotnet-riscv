+                // high half, the value returned, a mulhu (GT_INTRINSIC, as GT_MULHI is not valid in HIR).
+                if ((sig->numArgs != 3) || (sig->retType != CORINFO_TYPE_ULONG))
+                {
+                    break;
+                }
+
+                CORINFO_ARG_LIST_HANDLE arg           = sig->args;
+                CORINFO_CLASS_HANDLE    argClass      = NO_CLASS_HANDLE;
+                bool                    ulongFactors  = true;
+                for (unsigned i = 0; i < 2; i++)
+                {
+                    ulongFactors &= (strip(info.compCompHnd->getArgType(sig, arg, &argClass)) == CORINFO_TYPE_ULONG);
+                    arg = info.compCompHnd->getArgNext(arg);
+                }
+
+                if (!ulongFactors)
+                {
+                    break;
+                }
+
+                GenTree* const lowAddr = impPopStack().val;
+                GenTree*       factors[2];
+                factors[1] = impPopStack().val;
+                factors[0] = impPopStack().val;
+
+                // Both halves read the factors, the high one after the low half is stored, which may overwrite a
+                // factor ("BigMul(a, b, out a)"). Temps also keep the evaluation order: factors, then the address.
+                for (GenTree*& factor : factors)
+                {
+                    if (!factor->IsIntegralConst())
+                    {
+                        const unsigned tmpNum = lvaGrabTemp(true DEBUGARG("BigMul factor"));
+                        impStoreToTemp(tmpNum, factor, CHECK_SPILL_ALL);
+                        factor = gtNewLclvNode(tmpNum, genActualType(lvaGetDesc(tmpNum)->TypeGet()));
+                    }
+                }
+
+                GenTree* const low = gtNewOperNode(GT_MUL, TYP_LONG, factors[0], factors[1]);
+                impAppendTree(gtNewStoreIndNode(TYP_LONG, lowAddr, low), CHECK_SPILL_ALL, impCurStmtDI);
+
+                retNode = new (this, GT_INTRINSIC)
+                    GenTreeIntrinsic(TYP_LONG, gtCloneExpr(factors[0]), gtCloneExpr(factors[1]), ni,
+                                     nullptr R2RARG(CORINFO_CONST_LOOKUP{IAT_VALUE}));
+                break;
+            }
+#endif // TARGET_RISCV64
