RISC-V: elide unchecked long-local casts used as register shift counts.

perf-91 keeps the signed int representation of a narrowed local. When its
only use is the count of a register shift, RV64 reads the low five or six
bits of the original local directly. A cast that CSE shares between several
shifts becomes an INT local and keeps its single sext.w.

Regression test: tools/tests/ShiftCountCast
Regression test: bflat-ts:integers/int_extension_matrix_a

diff --git a/src/coreclr/jit/lower.cpp b/src/coreclr/jit/lower.cpp
--- a/src/coreclr/jit/lower.cpp
+++ b/src/coreclr/jit/lower.cpp
@@ -8997,5 +8997,21 @@ void Lowering::TryRemoveShiftRotateMask(GenTreeOp* op)
         BlockRange().Remove(addend);
         op->gtOp2->ClearContained();
     }
+
+#ifdef TARGET_64BIT
+    // Register shifts read only the low five or six bits of their count.
+    GenTree* count = op->gtGetOp2();
+    if (op->OperIs(GT_LSH, GT_RSH, GT_RSZ) && count->OperIs(GT_CAST) && !count->gtOverflow() &&
+        (count->CastToType() == TYP_INT))
+    {
+        GenTree* source = count->AsCast()->CastOp();
+        if (source->OperIs(GT_LCL_VAR) && source->TypeIs(TYP_LONG))
+        {
+            op->gtOp2 = source;
+            source->ClearContained();
+            BlockRange().Remove(count);
+        }
+    }
+#endif
 #endif
 }
