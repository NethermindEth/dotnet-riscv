 //------------------------------------------------------------------------
+// IsAlignmentTestedAccess: is `indir` an access lowering will test at run time, through a base local
+// plus a multiple of its size?
+//
+// Arguments:
+//    indir  - the access, in the block whose facts m_alignFacts holds
+//    lclNum - receives the base local
+//    size   - receives the size of the access
+//
+// Notes:
+//    The base is a local whose value only changes through stores in the LIR: not address-exposed, and
+//    not a field of an address-exposed struct.
+//
+bool Lowering::IsAlignmentTestedAccess(GenTreeIndir* indir, unsigned* lclNum, unsigned* size) const
+{
+    const unsigned accessSize = genTypeSize(indir->TypeGet());
+    GenTree*       addr       = indir->Addr();
+    if (indir->TypeIs(TYP_STRUCT) || (accessSize <= 1) || IsAddrKnownAligned(addr, accessSize))
+    {
+        return false;
+    }
+    ssize_t offset = 0;
+    if (addr->OperIs(GT_ADD) && !addr->gtOverflow())
+    {
+        GenTree* base  = addr->gtGetOp1();
+        GenTree* other = addr->gtGetOp2();
+        if (base->IsCnsIntOrI())
+        {
+            std::swap(base, other);
+        }
+        if (!other->IsCnsIntOrI() || other->IsIconHandle())
+        {
+            return false;
+        }
+        offset = other->AsIntCon()->IconValue();
+        addr   = base;
+    }
+    if (((offset % (ssize_t)accessSize) != 0) || !addr->OperIs(GT_LCL_VAR) || !addr->TypeIs(TYP_BYREF, TYP_I_IMPL))
+    {
+        return false;
+    }
+    const unsigned   baseLcl = addr->AsLclVar()->GetLclNum();
+    const LclVarDsc* varDsc  = m_compiler->lvaGetDesc(baseLcl);
+    if ((baseLcl >= m_lclAlignCount) || varDsc->IsAddressExposed() || varDsc->lvPromoted ||
+        (genActualType(varDsc->TypeGet()) != addr->TypeGet()) ||
+        (varDsc->lvIsStructField && m_compiler->lvaGetDesc(varDsc->lvParentLcl)->IsAddressExposed()))
+    {
+        return false;
+    }
+    *lclNum = baseLcl;
+    *size   = accessSize;
+    return true;
+}
