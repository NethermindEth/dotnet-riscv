+    // zkVM/RISC-V64 codegen peephole: drop an in-place `sext.w rd,rd` whose source was
+    // just produced by a W-form op or a sign-extending/byte/half load. Per the RV64 spec,
+    // all *.W instructions and lb/lh/lw sign-extend their 32-bit result into bits [63:32],
+    // and lbu/lhu yield a non-negative value (bit 31 == 0), so re-extending in place is a
+    // no-op. We deliberately handle ONLY reg1==reg2 here: when the destination differs the
+    // value still has to be moved, so converting to `mv` saves nothing (it just trades a
+    // sext.w for a mv). Those reg1!=reg2 cases are instead removed at their source by the
+    // redundant-cast elision in Lowering::TryRemoveCast (riscv64), which drops the GT_CAST
+    // node entirely so no extra register/move is ever allocated. Conservative: the producer
+    // must be the immediately-preceding instruction in the same group writing reg2.
+    if ((ins == INS_sext_w) && (reg1 == reg2) && (emitLastIns != nullptr) &&
+        (emitLastInsIG == emitCurIG) && (emitLastIns->idReg1() == reg2))
+    {
+        const instruction p = emitLastIns->idIns();
+        const bool        prevSignExtends =
+            (p == INS_lb) || (p == INS_lh) || (p == INS_lw) || (p == INS_lbu) || (p == INS_lhu) ||
+            (p == INS_sext_w) || (p == INS_addiw) || (p == INS_slliw) || (p == INS_srliw) ||
+            (p == INS_sraiw) || (p == INS_addw) || (p == INS_subw) || (p == INS_sllw) || (p == INS_srlw) ||
+            (p == INS_sraw) || (p == INS_mulw) || (p == INS_divw) || (p == INS_divuw) || (p == INS_remw) ||
+            (p == INS_remuw);
+        if (prevSignExtends)
+        {
+            return; // already sign-extended in place: the sext.w is dead
+        }
+    }
 
     if (INS_mov == ins || INS_sext_w == ins || INS_not == ins || (INS_clz <= ins && ins <= INS_rev8))
     {
diff --git a/src/coreclr/jit/lower.cpp b/src/coreclr/jit/lower.cpp
--- a/src/coreclr/jit/lower.cpp
+++ b/src/coreclr/jit/lower.cpp
@@ -10247,7 +10247,81 @@
     if (node->gtOverflow())
