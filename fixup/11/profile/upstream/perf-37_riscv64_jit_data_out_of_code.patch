zkVM RISC-V: keep the JIT data (jump tables, span/string constants) out of
the code. RyuJIT allocates it right after the method's instructions on
arm64/loongarch64/riscv64 (Compiler::eeAllocMem), inside the FUNC symbol;
the ZisK transpiler decodes the code section linearly and panics on the
first data word that is not a valid instruction ("invalid
riscv_instruction.inst_name=c.fsd"). With JitRiscV64DataInCode=0 the data
chunks go to the EE separately (ILC: MethodReadOnlyDataNode, .rodata) and
emitIns_R_C reaches them through the RISCV64_PCREL_I relocation the
emitter already supports. Default 1 keeps the upstream layout; bflat
passes 0 for zkVM targets.

diff --git a/src/coreclr/jit/ee_il_dll.cpp b/src/coreclr/jit/ee_il_dll.cpp
--- a/src/coreclr/jit/ee_il_dll.cpp
+++ b/src/coreclr/jit/ee_il_dll.cpp
@@ -1168,6 +1168,18 @@
     printf("\n");
 }
 #endif // DEBUG
+
+#ifdef TARGET_RISCV64
+//------------------------------------------------------------------------
+// eeJitDataAdjacentToCode: Is the JIT data (jump tables, constants) allocated
+//    in the code chunk right after the instructions (the arm64-style default),
+//    or handed to the EE as separate read-only data chunks?
+//
+bool Compiler::eeJitDataAdjacentToCode()
+{
+    return JitConfig.JitRiscV64DataInCode() != 0;
+}
+#endif // TARGET_RISCV64
 
 bool Compiler::eeDataWithCodePointersNeedsRelocs()
 {
@@ -1232,14 +1244,26 @@
     // compiler does.
     // This way allows us to use a single `ldr` to access such data like float constant/jmp table.
     // For LoongArch64 using `pcaddi + ld` to access such data.
+    //
+    // zkVM RISC-V targets are the exception: their transpilers decode the whole
+    // code section linearly and reject data (jump tables, span/string constants)
+    // found between instructions. JitRiscV64DataInCode=0 hands every data
+    // chunk to the EE separately, so it lands in read-only data and the
+    // accesses go through pc-relative relocations (see emitIns_R_C).
 
     for (unsigned i = 0; i < numDataChunks; i++)
     {
         if (((dataChunks[i].flags & CORJIT_ALLOCMEM_HAS_POINTERS_TO_CODE) != 0) && eeDataWithCodePointersNeedsRelocs())
         {
             // These are always passed to the EE as separate chunks since their relocations need special treatment
+            chunks.Push(dataChunks[i]);
+        }
+#ifdef TARGET_RISCV64
+        else if (!eeJitDataAdjacentToCode())
+        {
             chunks.Push(dataChunks[i]);
         }
+#endif // TARGET_RISCV64
         else
         {
             // Increase size of the hot code chunk and store offset in data chunk
