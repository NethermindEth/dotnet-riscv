+#ifdef TARGET_RISCV64
+//------------------------------------------------------------------------
+// lvaIsZkWideHome: whether a small integer local gets a whole aligned 8-byte stack home on a zkVM.
+//
+// Arguments:
+//    varNum -- variable to query
+//
+// Return Value:
+//    True, when JitZkBumpAddr is set, for an INT or smaller integer local that is not address-exposed
+//    and not a field of a dependently promoted struct: a local, a parameter passed in one register,
+//    or a local a parameter register maps to (lvIsParamRegTarget).
+//
+// Notes:
+//    A zkVM charges a 1-, 2- or 4-byte access, or one not aligned to 8 bytes, several times an
+//    aligned 64-bit one (ZisK runs each through its MemAlign state machine). Such a local's home is
+//    the whole aligned 8-byte slot, so every store that covers the local writes the register with
+//    sd, and a load of a register candidate reads it back with ld (see lvaIsZkWideHomeAccess). The
+//    locals left out have homes the caller or a containing struct writes narrow.
+//
+bool Compiler::lvaIsZkWideHome(unsigned varNum)
+{
+    if (JitConfig.JitZkBumpAddr() == 0)
+    {
+        return false;
+    }
+
+    const LclVarDsc* const varDsc = lvaGetDesc(varNum);
+    if (!varTypeIsIntegral(varDsc) || (genTypeSize(varDsc) > 4) || varDsc->IsAddressExposed() ||
+        lvaIsFieldOfDependentlyPromotedStruct(varDsc))
+    {
+        return false;
+    }
+
+    if (varDsc->lvIsParam && !varDsc->lvIsParamRegTarget)
+    {
+        // A field of a struct parameter inherits lvIsParam; only the parameter itself has ABI information.
+        return !varDsc->lvIsStructField && (varNum < info.compArgsCount) &&
+               lvaGetParameterABIInfo(varNum).HasExactlyOneRegisterSegment() &&
+               !lvaGetParameterABIInfo(varNum).HasAnyStackSegment();
+    }
+
+    return true;
+}
+
+//------------------------------------------------------------------------
+// lvaIsZkWideHomeAccess: whether a narrow frame access at offset 0 of a local or spill temp can use
+// the whole 8-byte slot instead.
+//
+// Arguments:
+//    varx   -- the local (>= 0) or spill temp (< 0) accessed
+//    width  -- the width of the access in bytes
+//    isLoad -- whether the access is a load
+//
+// Return Value:
+//    True if a store can be widened to sd, or a load to ld, without changing what the program
+//    computes.
+//
+// Notes:
+//    Every store that covers a wide home (lvaIsZkWideHome) or an INT spill temp (8 bytes on a zkVM,
+//    see RegSet::tmpPreAllocateTemps) writes the whole register with sd, so the slot holds exactly
+//    the register a spill or a store saved. A reload with ld restores that register bit for bit,
+//    where lw/lh/lb (or the zero-extending forms) would re-extend its low bits: the code that uses
+//    the value is correct for the register it had before the spill, and it never relies on a reload
+//    extending it. That holds for spill temps and register candidates. A local that is not a register
+//    candidate is read at every use and the JIT trusts those loads to be extended (see
+//    Lowering::IsInt32SignExtendedInReg), and it may have partial (LCL_FLD) stores, so its loads stay
+//    narrow; a partial store, narrower than the local, is never widened. So do the loads of a small
+//    parameter normalized once on entry (lvNormalizedSmallParam), whose home the prolog fills with the
+//    register as the caller passed it. The prolog sign-extends a mapped parameter register before it
+//    homes a local Lowering took to be sign-extended (see CodeGen::genSpillOrAddRegisterParam).
+//
+bool Compiler::lvaIsZkWideHomeAccess(int varx, unsigned width, bool isLoad)
+{
+    if (JitConfig.JitZkBumpAddr() == 0)
+    {
+        return false;
+    }
+
+    if (varx < 0)
+    {
+        const TempDsc* const temp = codeGen->regSet.tmpGetNum(varx);
+        return (temp->tdTempType() == TYP_INT) && (temp->tdTempSize() == TARGET_POINTER_SIZE);
+    }
+
+    if (!lvaIsZkWideHome((unsigned)varx))
+    {
+        return false;
+    }
+
+    const LclVarDsc* const varDsc = lvaGetDesc((unsigned)varx);
+    return (width >= genTypeSize(varDsc)) &&
+           (!isLoad || (varDsc->lvIsRegCandidate() && !varDsc->lvNormalizedSmallParam));
+}
+#endif // TARGET_RISCV64
+
