+
+                    const bool isUnsigned = (type0 == CORINFO_TYPE_ULONG) && (type1 == CORINFO_TYPE_ULONG);
+                    const bool isSigned   = (type0 == CORINFO_TYPE_LONG) && (type1 == CORINFO_TYPE_LONG);
+
+                    if (isUnsigned || isSigned)
