+
+                        const NamedIntrinsic hiName =
+                            isUnsigned ? NI_PRIMITIVE_MultiplyHighUnsigned : NI_PRIMITIVE_MultiplyHigh;
+                        retNode = new (this, GT_INTRINSIC)
+                            GenTreeIntrinsic(TYP_LONG, op1Dup, op2Dup, hiName, nullptr R2RARG(CORINFO_CONST_LOOKUP{IAT_VALUE}));
