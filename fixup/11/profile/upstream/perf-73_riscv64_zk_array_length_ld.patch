diff --git a/src/coreclr/jit/lower.cpp b/src/coreclr/jit/lower.cpp
--- a/src/coreclr/jit/lower.cpp
+++ b/src/coreclr/jit/lower.cpp
@@ -794,6 +794,20 @@
 #ifdef TARGET_RISCV64
     // An array or string length lies in [0, INT32_MAX]: lwu loads the same register as lw.
     const bool isNonNegativeLength = node->OperIs(GT_ARR_LENGTH);
+
+    // On 64-bit an array's length is followed by a 32-bit padding word, which nothing writes: ILC emits frozen
+    // arrays with it zero, the allocators write the length into fresh memory, and the JIT zero-initializes a
+    // stack-allocated array. A zkVM heap (JitZkBumpAddr) is fresh, zeroed RAM that is never reused, so there the
+    // padding is zero and one aligned ld reads the length. Not for a string, whose characters follow its length.
+    bool isPaddedArrayLength = false;
+    if (isNonNegativeLength && (JitConfig.JitZkBumpAddr() != 0))
+    {
+        bool                       isExact   = false;
+        bool                       isNonNull = false;
+        const CORINFO_CLASS_HANDLE arrClass  = m_compiler->gtGetClassHandle(arr, &isExact, &isNonNull);
+        isPaddedArrayLength                  = (arrClass != NO_CLASS_HANDLE) &&
+                              ((m_compiler->info.compCompHnd->getClassAttribs(arrClass) & CORINFO_FLG_ARRAY) != 0);
+    }
 #endif
 
     // Change to a GT_IND.
@@ -805,6 +819,11 @@
     {
         node->gtFlags |= GTF_ZEXT_LOAD;
     }
+
+    if (isPaddedArrayLength)
+    {
+        node->gtFlags |= GTF_IND_PADDED_LENGTH;
+    }
 #endif
 
     return arr->gtNext;
