diff --git a/src/coreclr/jit/lsra.h b/src/coreclr/jit/lsra.h
index 3541e1a23..9352a4a96 100644
--- a/src/coreclr/jit/lsra.h
+++ b/src/coreclr/jit/lsra.h
@@ -1921,7 +1921,13 @@ private:
 public:
     // The following keep track of information about internal (temporary register) intervals
     // during the building of a single node.
+#if defined(TARGET_RISCV64)
+    // The unrolled memmove holds the whole source in GPR temps (no SIMD): 8 of them for
+    // the 64-byte limit of getUnrollThreshold(Memmove).
+    static const int MaxInternalCount = 8;
+#else
     static const int MaxInternalCount = 5;
+#endif
 
 private:
     RefPosition* internalDefs[MaxInternalCount];
diff --git a/src/coreclr/jit/lsrariscv64.cpp b/src/coreclr/jit/lsrariscv64.cpp
index 98a23fc00..ec17b7198 100644
--- a/src/coreclr/jit/lsrariscv64.cpp
+++ b/src/coreclr/jit/lsrariscv64.cpp
@@ -1315,6 +1315,34 @@ int LinearScan::BuildBlockStore(GenTreeBlk* blkNode)
                 }
                 break;
 
+            case GenTreeBlk::BlkOpKindUnrollMemmove:
+            {
+                // genCodeForMemmove loads the whole source into temps before the first
+                // store, so src/dst overlap does not matter: one GPR per 8-byte chunk
+                // (a remainder is covered by an overlapping 8-byte access), two GPRs for
+                // a 3..7 byte block (two overlapping accesses), one for 1/2/4 bytes. The
+                // size is capped by getUnrollThreshold(Memmove) at MaxInternalCount * 8.
+                // The temps must not alias the address registers, which stay live across
+                // the loads: delay-free them.
+                assert(size > 0);
+                unsigned temps;
+                if (size >= REGSIZE_BYTES)
+                {
+                    temps = (size + REGSIZE_BYTES - 1) / REGSIZE_BYTES;
+                }
+                else
+                {
+                    temps = isPow2(size) ? 1 : 2;
+                }
+                assert(temps <= (unsigned)MaxInternalCount);
+                for (unsigned i = 0; i < temps; i++)
+                {
+                    buildInternalIntRegisterDefForNode(blkNode);
+                }
+                setInternalRegsDelayFree = true;
+                break;
+            }
+
             default:
                 unreached();
         }
