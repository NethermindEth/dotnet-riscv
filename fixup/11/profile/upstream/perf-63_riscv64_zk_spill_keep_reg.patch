+                    GetEmitter()->emitIns_S_R(ins_Store(storeType), emitTypeSize(storeType), varDsc->GetRegNum(),
+                                              m_compiler->lvaTrackedIndexToLclNum(varIndex), 0);
+                }
+                genUpdateRegLife(varDsc, /*isBorn*/ false, /*isDying*/ true DEBUGARG(call));
+                gcInfo.gcMarkRegSetNpt(varRegMask);
+                if (VarSetOps::IsMember(m_compiler, gcInfo.gcTrkStkPtrLcls, varIndex))
+                {
+                    VarSetOps::AddElemD(m_compiler, gcInfo.gcVarPtrSetCur, varIndex);
+                }
+                varDsc->SetRegNum(REG_STK);
+            }
+        }
+    }
+
