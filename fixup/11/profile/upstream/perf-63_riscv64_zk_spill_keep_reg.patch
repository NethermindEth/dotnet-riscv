+//------------------------------------------------------------------------
+// zkApplyCallCrossPolicy (JitZkColdCallSpill): on the zkVM every instruction is one step, so a
+// callee-saved register costs its save and restore (and for a parameter the move out of the
+// argument register) on every invocation, while a caller-saved register costs a store before and
+// a reload after each call actually executed (JitZkSpillKeepReg places both on the call's path).
+// A local prefers callee-saved registers only if the summed weight of the call blocks it is live
+// across reaches JitZkColdCallSpill percent of the entry block weight (150% of that for parameters).
+//
+void LinearScan::zkApplyCallCrossPolicy()
+{
+#if defined(TARGET_RISCV64)
+    const int pct = JitConfig.JitZkColdCallSpill();
+    if ((pct <= 0) || !enregisterLocalVars)
+    {
+        return;
+    }
+    const weight_t entryWeight = blockInfo[m_compiler->fgFirstBB->bbNum].weight;
+    for (unsigned varIndex = 0; varIndex < m_compiler->lvaTrackedCount; varIndex++)
+    {
+        Interval* interval = localVarIntervals[varIndex];
+        if ((interval == nullptr) || (interval->zkCallCrossWeight <= 0))
+        {
+            continue;
+        }
+        const LclVarDsc* varDsc    = m_compiler->lvaGetDescByTrackedIndex(varIndex);
+        weight_t         threshold = entryWeight * pct / 100;
+        if (varDsc->lvIsParam || varDsc->lvIsParamRegTarget)
+        {
+            threshold = threshold * 3 / 2;
+        }
+        if (interval->zkCallCrossWeight < threshold)
+        {
+            JITDUMP("zk: V%02u crosses calls of weight %.2f < %.2f: caller-saved candidates kept\n", interval->varNum,
+                    interval->zkCallCrossWeight, threshold);
+            continue;
+        }
+        interval->preferCalleeSave = true;
+        SingleTypeRegSet trash          = RBM_CALLEE_TRASH.GetRegSetForType(interval->registerType);
+        SingleTypeRegSet newPreferences = allRegs(interval->registerType) & ~trash;
+        if (newPreferences != RBM_NONE)
+        {
+            interval->registerAversion |= trash;
+            interval->updateRegisterPreferences(newPreferences);
+        }
+    }
+#endif
+}
