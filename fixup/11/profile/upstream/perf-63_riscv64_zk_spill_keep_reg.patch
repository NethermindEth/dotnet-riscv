+        regMaskTP callKillMask = RBM_CALLEE_TRASH;
+        if (call->IsHelperCall())
+        {
+            callKillMask = m_compiler->compHelperCallKillSet(call->GetHelperNum());
+        }
+        else if (call->IsUnmanaged() && (m_compiler->zkCsrForPInvoke(call) >= 0))
+        {
+            // A precompile CSR write (JitZkCsrPInvokes) changes no register (see LSRA's kill set).
+            callKillMask = RBM_NONE;
+        }
+        if ((regSet.GetMaskVars() & callKillMask).IsNonEmpty())
+        {
