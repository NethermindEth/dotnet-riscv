@@ -1095,6 +1120,80 @@ static bool RiscV64StrictAlign()
     return (JitConfig.JitRiscV64StrictAlign() != 0) && (JitConfig.JitNoUnalignedAccess() != 0);
 }
 
+//------------------------------------------------------------------------
+// ComputeAlignedLocals: for every local, find an alignment all the values stored to it have.
+//
+// Notes:
+//    Runs before lowering, so a byref formed once (a CSE temp, or a local holding a base rounded down
+//    to a known boundary) keeps the alignment of its definition at every access through it, and the
+//    strict-alignment checks of those accesses can be proven away. A local qualifies when every
+//    definition is a GT_STORE_LCL_VAR: not a parameter (its incoming value is unknown), not
+//    address-exposed, never the target of a GT_LCL_ADDR or a partial store, and not a promoted struct
+//    or field. The fixed point starts optimistic and only lowers a local's alignment, so stores of other
+//    locals and of the local itself are accounted for.
+//
+void Lowering::ComputeAlignedLocals()
+{
+    if (!RiscV64StrictAlign() || m_compiler->opts.OptimizationDisabled() || m_compiler->opts.IsOSR())
+    {
+        return;
+    }
+
+    const unsigned count = m_compiler->lvaCount;
+    unsigned char* align = new (m_compiler, CMK_Lower) unsigned char[count];
+    for (unsigned lclNum = 0; lclNum < count; lclNum++)
+    {
+        LclVarDsc* const varDsc    = m_compiler->lvaGetDesc(lclNum);
+        const bool       candidate = !varDsc->IsAddressExposed() && !varDsc->lvIsParam && !varDsc->lvIsParamRegTarget &&
+                               !varDsc->lvIsStructField && !varDsc->lvPromoted &&
+                               varDsc->TypeIs(TYP_BYREF, TYP_I_IMPL, TYP_LONG, TYP_INT);
+        align[lclNum] = candidate ? 6 : 0;
+    }
+
+    ArrayStack<GenTreeLclVarCommon*> stores(m_compiler->getAllocator(CMK_Lower));
+    for (BasicBlock* const block : m_compiler->Blocks())
+    {
+        for (GenTree* const node : LIR::AsRange(block))
+        {
+            if (!node->OperIsLocalStore() && !node->OperIs(GT_LCL_ADDR))
+                continue;
+
+            const unsigned lclNum = node->AsLclVarCommon()->GetLclNum();
+            if (align[lclNum] == 0)
+                continue;
+
+            if (node->OperIs(GT_STORE_LCL_VAR))
+            {
+                stores.Push(node->AsLclVarCommon());
+            }
+            else
+            {
+                align[lclNum] = 0;
+            }
+        }
+    }
+
+    m_lclAlignLog2  = align;
+    m_lclAlignCount = count;
+
+    bool changed;
+    do
+    {
+        changed = false;
+        for (int i = 0; i < stores.Height(); i++)
+        {
+            GenTreeLclVarCommon* const store  = stores.Bottom(i);
+            const unsigned             lclNum = store->GetLclNum();
+            const unsigned             log2   = KnownAlignmentLog2(store->Data());
+            if (log2 < align[lclNum])
+            {
+                align[lclNum] = (unsigned char)log2;
+                changed       = true;
+            }
+        }
+    } while (changed);
+}
