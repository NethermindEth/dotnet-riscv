+// IsAddrKnownAligned: is `addr` provably a multiple of `align`, a power of two?
+//
+bool Lowering::IsAddrKnownAligned(GenTree* addr, unsigned align) const
+{
+    return (align <= 1) || ((1u << KnownAlignmentLog2(addr)) >= align);
+}
