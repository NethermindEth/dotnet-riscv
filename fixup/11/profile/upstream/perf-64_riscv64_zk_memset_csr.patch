+//------------------------------------------------------------------------
+// zkInitBlkUsesMemsetCsr: does this unrolled or looped zero-fill block store become the ZisK memset
+//   precompile idiom (JitZkMemsetCsr)? Also reports whether codegen needs a register to
+//   materialize the destination address (a contained local address or a based offset).
+//
+bool Compiler::zkInitBlkUsesMemsetCsr(GenTreeBlk* blk, bool* needsAddrReg)
+{
+    *needsAddrReg = false;
+    const int minSize = JitConfig.JitZkMemsetCsr();
+    if ((minSize <= 0) || !blk->OperIs(GT_STORE_BLK) || !blk->OperIsInitBlkOp() ||
+        ((blk->gtBlkOpKind != GenTreeBlk::BlkOpKindUnroll) && (blk->gtBlkOpKind != GenTreeBlk::BlkOpKindLoop)) ||
+        (blk->Size() < (unsigned)minSize))
+    {
+        return false;
+    }
+    GenTree* src = blk->Data();
+    if (src->OperIs(GT_INIT_VAL))
+    {
+        src = src->gtGetOp1();
+    }
+    if (!src->isContained() || !src->IsIntegralConst(0))
+    {
+        return false;
+    }
+    if (blk->IsUnaligned() && (JitConfig.JitNoUnalignedAccess() != 0))
+    {
+        return false;
+    }
+    GenTree* dstAddr = blk->Addr();
+    if (dstAddr->isContained())
+    {
+        if (dstAddr->OperIsAddrMode())
+        {
+            if (dstAddr->AsAddrMode()->HasIndex() || !emitter::isValidSimm12(dstAddr->AsAddrMode()->Offset()))
+            {
+                return false;
+            }
+            *needsAddrReg = (dstAddr->AsAddrMode()->Offset() != 0);
+        }
+        else
+        {
+            *needsAddrReg = true; // GT_LCL_ADDR: lea into a register
+        }
+    }
+    return true;
+}
