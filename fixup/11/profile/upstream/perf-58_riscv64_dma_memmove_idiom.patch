diff --git a/src/coreclr/jit/morph.cpp b/src/coreclr/jit/morph.cpp
index 1a0c70051..2ce456d43 100644
--- a/src/coreclr/jit/morph.cpp
+++ b/src/coreclr/jit/morph.cpp
@@ -6365,7 +6365,8 @@ void Compiler::fgMorphTailCallViaJitHelper(GenTreeCall* call)
 //
 // Return Value:
 //    The CSR number when `call` is an unmanaged call whose entry point is listed in
-//    JitZkCsrPInvokes and takes exactly one argument (the operand address); otherwise -1.
+//    JitZkCsrPInvokes and takes one argument (the operand address) or three (the ZisK DMA
+//    copy shape: destination, source, length); otherwise -1.
 //
 // Notes:
 //    See JitZkCsrPInvokes. The decision is purely name based, so it is cheap enough to ask
@@ -6375,7 +6376,14 @@ void Compiler::fgMorphTailCallViaJitHelper(GenTreeCall* call)
 int Compiler::zkCsrForPInvoke(GenTreeCall* call)
 {
     if (!call->IsUnmanaged() || (call->gtCallType != CT_USER_FUNC) || (call->gtCallMethHnd == nullptr) ||
-        call->IsFastTailCall() || (call->gtArgs.CountArgs() != 1))
+        call->IsFastTailCall())
+    {
+        return -1;
+    }
+    // One argument: the operand block address goes into the CSR. Three arguments: the ZisK DMA
+    // shape (memmove/memcpy), `csrrs x0, csr, src; add x0, dst, len` - see genCallInstruction.
+    const unsigned argCount = call->gtArgs.CountArgs();
+    if ((argCount != 1) && (argCount != 3))
     {
         return -1;
     }
diff --git a/src/libraries/System.Private.CoreLib/src/System/SpanHelpers.ByteMemOps.cs b/src/libraries/System.Private.CoreLib/src/System/SpanHelpers.ByteMemOps.cs
index 486136a1f..34d483611 100644
--- a/src/libraries/System.Private.CoreLib/src/System/SpanHelpers.ByteMemOps.cs
+++ b/src/libraries/System.Private.CoreLib/src/System/SpanHelpers.ByteMemOps.cs
@@ -261,6 +261,15 @@ internal static void Memmove(ref byte dest, ref byte src, nuint len)
             MemmoveNative(ref dest, ref src, len);
         }
 
+#if TARGET_RISCV64
+        // zkVM/RISC-V64: the uGC never moves objects, so the refs need no pinning, and the JIT
+        // emits the memmove P/Invoke as the ZisK DMA idiom (dotnet-riscv perf-58) with no call
+        // and no register kills, so the shim can inline into Memmove's native path: a copy past
+        // the inline threshold costs the DMA idiom instead of two frames and a stub.
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        private static unsafe void MemmoveNative(ref byte dest, ref byte src, nuint len) =>
+            memmove(Unsafe.AsPointer(ref dest), Unsafe.AsPointer(ref src), len);
+#else
         // Non-inlinable wrapper around the QCall that avoids polluting the fast path
         // with P/Invoke prolog/epilog.
         [MethodImpl(MethodImplOptions.NoInlining)]
@@ -272,6 +281,7 @@ private static unsafe void MemmoveNative(ref byte dest, ref byte src, nuint len)
                 memmove(pDest, pSrc, len);
             }
         }
+#endif
 
 #if MONO
         [MethodImpl(MethodImplOptions.InternalCall)]
