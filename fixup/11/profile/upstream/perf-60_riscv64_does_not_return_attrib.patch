             if (method.Signature.IsStatic)
                 result |= CorInfoFlag.CORINFO_FLG_STATIC;
 
+            // The JIT only learns that a callee never returns by scanning it as an inline candidate, which a
+            // NoInlining throw helper never is; every value live after such a call then has to survive a call
+            // in a callee-saved register. The attribute states the fact directly.
+            if (method.GetTypicalMethodDefinition() is EcmaMethod doesNotReturnCandidate &&
+                doesNotReturnCandidate.HasCustomAttribute("System.Diagnostics.CodeAnalysis", "DoesNotReturnAttribute"))
+                result |= CorInfoFlag.CORINFO_FLG_DOES_NOT_RETURN;
+
             if (method.IsSynchronized)
                 result |= CorInfoFlag.CORINFO_FLG_SYNCH;
             if (method.IsIntrinsic)
