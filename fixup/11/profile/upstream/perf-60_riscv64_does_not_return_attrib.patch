+//------------------------------------------------------------------------
+// impMarkCallDoesNotReturnFromAttribs: mark a direct call to a [DoesNotReturn] method as no-return.
+//
+// Arguments:
+//    call   - the call node
+//    mflags - the callee's method attributes
+//
+// Notes:
+//    The EE reports CORINFO_FLG_DOES_NOT_RETURN (NativeAOT) for methods carrying the attribute. The
+//    inliner also discovers no-return callees, but only for the ones it scans; a NoInlining throw
+//    helper is never scanned, and every value live after the call then has to be kept in a callee-saved
+//    register, which on the zkVM costs two executed instructions per invocation of the caller.
+//
+void Compiler::impMarkCallDoesNotReturnFromAttribs(GenTreeCall* call, unsigned mflags)
+{
+    if (((mflags & CORINFO_FLG_DOES_NOT_RETURN) == 0) || call->IsNoReturn() || call->IsVirtual() ||
+        call->IsTailPrefixedCall() || compIsAsync())
+    {
+        return;
+    }
+    JITDUMP("Call [%06u] targets a [DoesNotReturn] method; marking it no-return\n", dspTreeID(call));
+    setCallDoesNotReturn(call);
+}
+
