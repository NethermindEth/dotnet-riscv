+            public override bool CanCalliReceiveFatPointer(Internal.TypeSystem.MethodSignature calliSignature)
+            {
+                // Only static signatures with parameters are tracked. Instance fat pointers also come from generic
+                // virtual method resolution and value type methods, which are not enumerated here, and the class
+                // constructor runner calls class constructors, fat for shared generic types, through a static
+                // parameterless calli.
+                if (!calliSignature.IsStatic || calliSignature.Length == 0)
+                    return true;
+
+                // A calli passes exactly its signature's parameters, so a fat pointer can only arrive at one whose
+                // parameter count is its target's. Comparing counts rather than types keeps shared canonical
+                // signatures (__Canon) matching the exact ones they are called through.
+                return _fatPointerStaticTargetArities.Contains(calliSignature.Length);
+            }
