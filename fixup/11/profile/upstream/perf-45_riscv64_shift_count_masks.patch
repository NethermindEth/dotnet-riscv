--- a/src/coreclr/jit/morph.cpp
+++ b/src/coreclr/jit/morph.cpp
@@ -11791,6 +11791,25 @@
 
 #endif
 
+#ifdef TARGET_RISCV64
+    // sll/srl/sra use the low 6 bits of the count and their W forms the low 5, the same masking the IR's shift
+    // semantics assume (constant folding and VN mask the count too). Drop an AND that keeps all of those bits now,
+    // before CSE can share the masked count between several shifts and keep the AND alive in a register; lowering
+    // (TryRemoveShiftRotateMask) only sees an AND that is still the shift's direct operand.
+    if (fgGlobalMorph && tree->OperIs(GT_LSH, GT_RSH, GT_RSZ))
+    {
+        const ssize_t countMask = varTypeIsLong(typ) ? 0x3f : 0x1f;
+        while (op2->OperIs(GT_AND) && op2->gtGetOp2()->IsCnsIntOrI() &&
+               ((op2->gtGetOp2()->AsIntCon()->IconValue() & countMask) == countMask))
+        {
+            GenTree* const maskedCount = op2->gtGetOp1();
+            DEBUG_DESTROY_NODE(op2->gtGetOp2());
+            DEBUG_DESTROY_NODE(op2);
+            tree->gtOp2 = op2 = maskedCount;
+        }
+    }
+#endif
+
