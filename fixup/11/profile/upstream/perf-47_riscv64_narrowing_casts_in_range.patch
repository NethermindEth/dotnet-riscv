 //------------------------------------------------------------------------
+// IsInt64InInt32RangeInReg: whether the register holding the value of a LONG node is known to be the
+// sign extension of its low 32 bits (with nonNegative: to lie in [0, INT32_MAX]), so that a narrowing
+// cast to INT, which RISC-V implements as sext.w, is a copy of it.
+//
+// Arguments:
+//    comp        - the compiler
+//    node        - the LONG node (a GT_COPY/GT_RELOAD of one is looked through)
+//    nonNegative - require [0, INT32_MAX] rather than [INT32_MIN, INT32_MAX]
+//    depth       - recursion depth
+//
+// Notes:
+//    srli by 33..63 leaves at most 31 significant bits and srai by 32..63 at most 32 sign bits. A cast
+//    from INT holds its sign extension (sext.w, or the source register when that is already extended)
+//    or, zero-extending, its source register when that is in [0, INT32_MAX] (see genIntToIntCast).
+//    AND, OR, XOR and NOT keep bits 63..31 equal when they are equal in the operands, and an AND with an
+//    operand in [0, INT32_MAX] is in that range itself. Min/max return one of their operands and the
+//    bit counts are at most 64.
+//
+bool Lowering::IsInt64InInt32RangeInReg(Compiler* comp, GenTree* node, bool nonNegative, unsigned depth)
+{
+    node = node->gtSkipReloadOrCopy();
+    if (!node->TypeIs(TYP_LONG) || (depth > 4))
+        return false;
+
+    if (node->IsCnsIntOrI())
+    {
+        const ssize_t value = node->AsIntCon()->IconValue();
+        return !node->IsIconHandle() && (value <= INT32_MAX) && (value >= (nonNegative ? 0 : INT32_MIN));
+    }
+
+    if (node->isContained() || node->gtOverflowEx())
+        return false;
+
+    switch (node->OperGet())
+    {
+        case GT_RSZ:
+        case GT_RSH:
+        {
+            GenTree* const shiftBy = node->gtGetOp2();
+            if (!shiftBy->IsCnsIntOrI())
+                return false;
+            const ssize_t shift = shiftBy->AsIntCon()->IconValue() & 63;
+            return node->OperIs(GT_RSZ) ? (shift >= 33) : (!nonNegative && (shift >= 32));
+        }
+
+        case GT_CAST:
+        {
+            GenTree* const src = node->AsCast()->CastOp();
+            if (!varTypeIsIntegral(src) || !genActualTypeIsInt(src))
+                return false;
+            if (nonNegative || node->IsUnsigned())
+                return IsInt32NonNegativeInReg(comp, src, depth + 1);
+            return true;
+        }
+
+        case GT_AND:
+            if (IsInt64InInt32RangeInReg(comp, node->gtGetOp1(), true, depth + 1) ||
+                IsInt64InInt32RangeInReg(comp, node->gtGetOp2(), true, depth + 1))
+                return true;
+            FALLTHROUGH;
+        case GT_OR:
+        case GT_XOR:
+            return IsInt64InInt32RangeInReg(comp, node->gtGetOp1(), nonNegative, depth + 1) &&
+                   IsInt64InInt32RangeInReg(comp, node->gtGetOp2(), nonNegative, depth + 1);
+
+        case GT_NOT:
+            return !nonNegative && IsInt64InInt32RangeInReg(comp, node->gtGetOp1(), false, depth + 1);
+
+        case GT_INTRINSIC:
+            switch (node->AsIntrinsic()->gtIntrinsicName)
+            {
+                case NI_System_Math_Min:
+                case NI_System_Math_Max:
+                case NI_System_Math_MinUnsigned:
+                case NI_System_Math_MaxUnsigned:
+                    return IsInt64InInt32RangeInReg(comp, node->gtGetOp1(), nonNegative, depth + 1) &&
+                           IsInt64InInt32RangeInReg(comp, node->gtGetOp2(), nonNegative, depth + 1);
+
+                case NI_PRIMITIVE_LeadingZeroCount:
+                case NI_PRIMITIVE_TrailingZeroCount:
+                case NI_PRIMITIVE_PopCount:
+                    return true;
+
+                default:
+                    return false;
+            }
+
+        default:
+            return false;
+    }
+}
+
