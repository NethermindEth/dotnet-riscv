+//------------------------------------------------------------------------
+// fgLegalizeSoftFloat: rewrite all floating-point IR into integer IR plus
+// soft-float helper calls, for RISC-V targets without the F/D extensions.
+//
+// After this pass no node in the IR has a floating-point type:
+//  * float values are TYP_INT (their IEEE754 bits), doubles are TYP_LONG;
+//  * FP arithmetic, comparisons and conversions become helper calls that
+//    follow the compiler-rt/libgcc soft-float conventions;
+//  * locals, params, returns and call sites are retyped to match the lp64
+//    (soft-float) ABI which the parameter classifier already applies when
+//    opts.compUseSoftFP is set.
+//
+// The pass runs at the start of global morph: inlining and struct promotion
+// have already happened (promoted FP fields are retyped here like any other
+// local), and everything morph creates afterwards derives its type from the
+// already-retyped locals and signatures.
+//
+void Compiler::fgLegalizeSoftFloat()
+{
+    assert(opts.compUseSoftFP);
+
+    // Retype the method return.
+    if (varTypeIsFloating(info.compRetType))
+    {
+        info.compRetType = info.compRetType == TYP_FLOAT ? TYP_INT : TYP_LONG;
+        compRetTypeDesc.Reset();
+        compRetTypeDesc.InitializeReturnType(this, info.compRetType, info.compMethodInfo->args.retTypeClass,
+                                             info.compCallConv);
+        info.compRetNativeType = compRetTypeDesc.GetReturnRegType(0);
+    }
+
+    // Retype locals. Params were already classified by the integer calling
+    // convention; float/double have the same size and alignment as int/long,
+    // so frame layout and GC info are unaffected.
+    for (unsigned lclNum = 0; lclNum < lvaCount; lclNum++)
+    {
+        LclVarDsc* const varDsc = lvaGetDesc(lclNum);
+        if (varDsc->TypeIs(TYP_FLOAT))
+        {
+            varDsc->lvType = TYP_INT;
+        }
+        else if (varDsc->TypeIs(TYP_DOUBLE))
+        {
+            varDsc->lvType = TYP_LONG;
+        }
+    }
+
+    for (BasicBlock* const block : Blocks())
+    {
+        for (Statement* const stmt : block->Statements())
+        {
+            stmt->SetRootNode(fgSoftFloatRewriteTree(stmt->GetRootNode()));
+        }
+    }
+}
+
+//------------------------------------------------------------------------
+// fgSoftFloatRewriteTree: recursively rewrite one tree (post-order).
+//
+GenTree* Compiler::fgSoftFloatRewriteTree(GenTree* tree)
+{
+    // Capture pre-rewrite operand types where the rewrite depends on them
+    // (relops and casts lose the FP-ness of their operands once those are
+    // rewritten to integer types).
+    var_types preOp1Type = TYP_UNDEF;
+    if (tree->OperIsSimple() && (tree->AsOp()->gtGetOp1() != nullptr))
+    {
+        preOp1Type = tree->AsOp()->gtGetOp1()->TypeGet();
+    }
+
+    for (GenTree** use : tree->UseEdges())
+    {
+        *use = fgSoftFloatRewriteTree(*use);
+    }
+
+    const var_types type = tree->TypeGet();
+
+    switch (tree->OperGet())
+    {
+        case GT_CNS_DBL:
+        {
+            double dval = tree->AsDblCon()->DconValue();
+            if (type == TYP_FLOAT)
+            {
+                float   fval = (float)dval;
+                int32_t bits;
+                memcpy(&bits, &fval, sizeof(bits));
+                return gtNewIconNode(bits, TYP_INT);
+            }
+            else
+            {
+                int64_t bits;
+                memcpy(&bits, &dval, sizeof(bits));
+                return gtNewLconNode(bits);
+            }
+        }
+
+        case GT_ADD:
+        case GT_SUB:
+        case GT_MUL:
+        case GT_DIV:
+        case GT_MOD:
+        {
+            if (!varTypeIsFloating(type))
+            {
+                break;
+            }
+            const bool isDbl = type == TYP_DOUBLE;
+            unsigned   helper;
+            switch (tree->OperGet())
+            {
+                case GT_ADD:
+                    helper = isDbl ? CORINFO_HELP_DBLADD : CORINFO_HELP_FLTADD;
+                    break;
+                case GT_SUB:
+                    helper = isDbl ? CORINFO_HELP_DBLSUB : CORINFO_HELP_FLTSUB;
+                    break;
+                case GT_MUL:
+                    helper = isDbl ? CORINFO_HELP_DBLMUL : CORINFO_HELP_FLTMUL;
+                    break;
+                case GT_DIV:
+                    helper = isDbl ? CORINFO_HELP_DBLDIV : CORINFO_HELP_FLTDIV;
+                    break;
+                default:
+                    helper = isDbl ? CORINFO_HELP_DBLREM : CORINFO_HELP_FLTREM;
+                    break;
+            }
+            return gtNewHelperCallNode(helper, isDbl ? TYP_LONG : TYP_INT, tree->AsOp()->gtOp1, tree->AsOp()->gtOp2);
+        }
+
+        case GT_NEG:
+        {
+            if (!varTypeIsFloating(type))
+            {
+                break;
+            }
+            // Flip the sign bit; no helper needed.
+            if (type == TYP_FLOAT)
+            {
+                return gtNewOperNode(GT_XOR, TYP_INT, tree->AsOp()->gtOp1, gtNewIconNode((int32_t)0x80000000, TYP_INT));
+            }
+            else
+            {
+                return gtNewOperNode(GT_XOR, TYP_LONG, tree->AsOp()->gtOp1, gtNewLconNode(INT64_MIN));
+            }
+        }
+
+        case GT_EQ:
+        case GT_NE:
+        case GT_LT:
+        case GT_LE:
+        case GT_GE:
+        case GT_GT:
+            if (varTypeIsFloating(preOp1Type))
+            {
+                return fgSoftFloatRewriteRelop(tree->AsOp(), preOp1Type);
+            }
+            break;
+
+        case GT_CAST:
+            if (varTypeIsFloating(preOp1Type) || varTypeIsFloating(tree->AsCast()->CastToType()))
+            {
+                return fgSoftFloatRewriteCast(tree->AsCast(), preOp1Type);
+            }
+            break;
+
+        case GT_CALL:
+            if (varTypeIsFloating(type))
+            {
+                GenTreeCall* const call = tree->AsCall();
+                call->gtType            = type == TYP_FLOAT ? TYP_INT : TYP_LONG;
+                call->gtReturnTypeDesc.Reset();
+                call->gtReturnTypeDesc.InitializeReturnType(this, call->gtType, call->gtRetClsHnd,
+                                                            call->GetUnmanagedCallConv());
+            }
+            return tree;
+
+        case GT_CKFINITE:
+            NO_WAY("CKFINITE is not supported on soft-float targets");
+            break;
+
+        case GT_INTRINSIC:
+            // FP math intrinsics are suppressed at import time under soft-float.
+            noway_assert(!varTypeIsFloating(type));
+            break;
+
+        case GT_BITCAST:
+            if (varTypeIsFloating(type))
+            {
+                tree->gtType = type == TYP_FLOAT ? TYP_INT : TYP_LONG;
+            }
+            if (tree->TypeGet() == genActualType(tree->AsOp()->gtOp1->TypeGet()))
+            {
+                // int<->float bitcasts degenerate to identity once both sides are integer.
+                return tree->AsOp()->gtOp1;
+            }
+            return tree;
+
+        default:
+            break;
+    }
+
+    // Generic retype for every other FP-typed node: indirs, local loads and
+    // stores, commas, qmarks, selects. The value is the same bits.
+    if (varTypeIsFloating(tree->TypeGet()))
+    {
+        tree->gtType = tree->TypeGet() == TYP_FLOAT ? TYP_INT : TYP_LONG;
+    }
+    return tree;
+}
+
+//------------------------------------------------------------------------
+// fgSoftFloatRewriteRelop: rewrite an FP comparison into a soft-float
+// compare helper call plus an integer comparison of its tri-state result.
+//
+// The helpers follow the libgcc conventions: lt/le return +1 on unordered,
+// gt/ge return -1, eq returns nonzero. This lets every ordered comparison
+// and every unordered one except ueq/one map onto a single call:
+//
+//   oeq: eq == 0   une: eq != 0
+//   olt: lt <  0   ult: ge <  0
+//   ole: le <= 0   ule: gt <= 0
+//   ogt: gt >  0   ugt: le >  0
+//   oge: ge >= 0   uge: lt >= 0
+//
+// ueq and one are composed from the ordered lt/gt helpers:
+//   ueq = (lt >= 0) && (gt <= 0)     one = (lt < 0) || (gt > 0)
+//
+GenTree* Compiler::fgSoftFloatRewriteRelop(GenTreeOp* relop, var_types opndType)
+{
+    const bool isDbl = opndType == TYP_DOUBLE;
+    const bool isUn  = (relop->gtFlags & GTF_RELOP_NAN_UN) != 0;
+
+    GenTree* op1 = relop->gtOp1;
+    GenTree* op2 = relop->gtOp2;
+
+#define CMP_HELPER(name) (isDbl ? CORINFO_HELP_DBLCMP_##name : CORINFO_HELP_FLTCMP_##name)
+
+    const genTreeOps oper = relop->OperGet();
+
+    if ((oper == GT_EQ && isUn) || (oper == GT_NE && !isUn))
+    {
+        GenTree* op1b = fgMakeMultiUse(&op1);
+        GenTree* op2b = fgMakeMultiUse(&op2);
+
+        GenTree* ltCall = gtNewHelperCallNode(CMP_HELPER(LT), TYP_INT, op1, op2);
+        GenTree* gtCall = gtNewHelperCallNode(CMP_HELPER(GT), TYP_INT, op1b, op2b);
+
+        GenTree* combined;
+        if (oper == GT_EQ)
+        {
+            // ueq
+            GenTree* notLt = gtNewOperNode(GT_GE, TYP_INT, ltCall, gtNewIconNode(0));
+            GenTree* notGt = gtNewOperNode(GT_LE, TYP_INT, gtCall, gtNewIconNode(0));
+            combined       = gtNewOperNode(GT_AND, TYP_INT, notLt, notGt);
+        }
+        else
+        {
+            // one
+            GenTree* isLt = gtNewOperNode(GT_LT, TYP_INT, ltCall, gtNewIconNode(0));
+            GenTree* isGt = gtNewOperNode(GT_GT, TYP_INT, gtCall, gtNewIconNode(0));
+            combined      = gtNewOperNode(GT_OR, TYP_INT, isLt, isGt);
+        }
+        // Keep the result a relop so that GT_JTRUE parents stay well-formed.
+        return gtNewOperNode(GT_NE, TYP_INT, combined, gtNewIconNode(0));
+    }
+
+    unsigned helper;
+    switch (oper)
+    {
+        case GT_EQ:
+        case GT_NE:
+            helper = CMP_HELPER(EQ);
+            break;
+        case GT_LT:
+            helper = isUn ? CMP_HELPER(GE) : CMP_HELPER(LT);
+            break;
+        case GT_LE:
+            helper = isUn ? CMP_HELPER(GT) : CMP_HELPER(LE);
+            break;
+        case GT_GT:
+            helper = isUn ? CMP_HELPER(LE) : CMP_HELPER(GT);
+            break;
+        default:
+            helper = isUn ? CMP_HELPER(LT) : CMP_HELPER(GE);
+            break;
+    }
+
+#undef CMP_HELPER
+
+    GenTree* call = gtNewHelperCallNode(helper, TYP_INT, op1, op2);
+    return gtNewOperNode(oper, TYP_INT, call, gtNewIconNode(0));
+}
+
+//------------------------------------------------------------------------
+// fgSoftFloatRewriteCast: rewrite a cast with an FP source or destination.
+//
+// FP->integer conversions go through the 64-bit runtime helpers, which carry
+// the .NET saturation semantics (NaN -> 0, out-of-range -> Min/MaxValue);
+// 32-bit destinations additionally clamp the 64-bit result. Integer->FP
+// widens the source to (u)int64 first. Small destinations narrow the 32-bit
+// result with an ordinary integer cast, matching what morph does on
+// hard-float targets.
+//
+GenTree* Compiler::fgSoftFloatRewriteCast(GenTreeCast* cast, var_types srcType)
+{
+    GenTree*        src     = cast->CastOp();
+    const var_types dstType = cast->CastToType();
+    const bool      srcFP   = varTypeIsFloating(srcType);
+    const bool      dstFP   = varTypeIsFloating(dstType);
+
+    if (srcFP && dstFP)
+    {
+        if (srcType == dstType)
+        {
+            return src;
+        }
+        if (dstType == TYP_DOUBLE)
+        {
+            return gtNewHelperCallNode(CORINFO_HELP_FLT2DBL, TYP_LONG, src);
+        }
+        return gtNewHelperCallNode(CORINFO_HELP_DBL2FLT, TYP_INT, src);
+    }
+
+    if (srcFP)
+    {
+        if (srcType == TYP_FLOAT)
+        {
+            src = gtNewHelperCallNode(CORINFO_HELP_FLT2DBL, TYP_LONG, src);
+        }
+
+        var_types wide = dstType;
+        if (varTypeIsSmall(dstType))
+        {
+            wide = TYP_INT;
+        }
+
+        GenTree* result;
+        if (cast->gtOverflow())
+        {
+            unsigned helper;
+            switch (wide)
+            {
+                case TYP_INT:
+                    helper = CORINFO_HELP_DBL2INT_OVF;
+                    break;
+                case TYP_UINT:
+                    helper = CORINFO_HELP_DBL2UINT_OVF;
+                    break;
+                case TYP_ULONG:
+                    helper = CORINFO_HELP_DBL2ULNG_OVF;
+                    break;
+                default:
+                    helper = CORINFO_HELP_DBL2LNG_OVF;
+                    break;
+            }
+            result = gtNewHelperCallNode(helper, ((wide == TYP_LONG) || (wide == TYP_ULONG)) ? TYP_LONG : TYP_INT, src);
+        }
+        else
+        {
+            const bool   toUns = (wide == TYP_UINT) || (wide == TYP_ULONG);
+            GenTreeCall* cvt =
+                gtNewHelperCallNode(toUns ? CORINFO_HELP_DBL2ULNG : CORINFO_HELP_DBL2LNG, TYP_LONG, src);
+
+            if ((wide == TYP_LONG) || (wide == TYP_ULONG))
+            {
+                result = cvt;
+            }
+            else if (wide == TYP_INT)
+            {
+                // val > INT32_MAX ? INT32_MAX : (val < INT32_MIN ? INT32_MIN : (int)val)
+                GenTree* val  = cvt;
+                GenTree* valB = fgMakeMultiUse(&val);
+                GenTree* valC = fgMakeMultiUse(&valB);
+
+                GenTree* trunc = gtNewCastNode(TYP_INT, valC, false, TYP_INT);
+                GenTree* isLo  = gtNewOperNode(GT_LT, TYP_INT, valB, gtNewLconNode(INT32_MIN));
+                GenTree* selLo = gtNewConditionalNode(GT_SELECT, isLo, gtNewIconNode(INT32_MIN, TYP_INT), trunc, TYP_INT);
+                GenTree* isHi  = gtNewOperNode(GT_GT, TYP_INT, val, gtNewLconNode(INT32_MAX));
+                result         = gtNewConditionalNode(GT_SELECT, isHi, gtNewIconNode(INT32_MAX, TYP_INT), selLo, TYP_INT);
+            }
+            else
+            {
+                // TYP_UINT: val > UINT32_MAX ? UINT32_MAX : (uint)val
+                GenTree* val  = cvt;
+                GenTree* valB = fgMakeMultiUse(&val);
+
+                GenTree* trunc = gtNewCastNode(TYP_INT, valB, false, TYP_UINT);
+                GenTree* isHi  = gtNewOperNode(GT_GT, TYP_INT, val, gtNewLconNode((int64_t)UINT32_MAX));
+                isHi->gtFlags |= GTF_UNSIGNED;
+                result = gtNewConditionalNode(GT_SELECT, isHi, gtNewIconNode(-1, TYP_INT), trunc, TYP_INT);
+            }
+        }
+
+        if (varTypeIsSmall(dstType))
+        {
+            GenTree* narrow = gtNewCastNode(TYP_INT, result, false, dstType);
+            if (cast->gtOverflow())
+            {
+                narrow->gtFlags |= GTF_OVERFLOW | GTF_EXCEPT;
+            }
+            result = narrow;
+        }
+        return result;
+    }
+
+    // integer -> FP
+    {
+        GenTree* val = src;
+        if (genActualType(srcType) == TYP_INT)
+        {
+            // Widen to int64; unsigned sources zero-extend (the value then
+            // always fits, so the signed int64 helper is exact).
+            val = gtNewCastNode(TYP_LONG, src, cast->IsUnsigned(), TYP_LONG);
+        }
+        const bool uns64 = (genActualType(srcType) == TYP_LONG) && cast->IsUnsigned();
+
+        unsigned helper;
+        if (dstType == TYP_FLOAT)
+        {
+            helper = uns64 ? CORINFO_HELP_ULNG2FLT : CORINFO_HELP_LNG2FLT;
+        }
+        else
+        {
+            helper = uns64 ? CORINFO_HELP_ULNG2DBL : CORINFO_HELP_LNG2DBL;
+        }
+        return gtNewHelperCallNode(helper, dstType == TYP_FLOAT ? TYP_INT : TYP_LONG, val);
+    }
+}
+
+#endif // TARGET_RISCV64
