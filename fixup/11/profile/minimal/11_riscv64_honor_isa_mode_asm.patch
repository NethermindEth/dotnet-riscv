+++ b/src/coreclr/pal/inc/unixasmmacrosriscv64.inc
@@ -161,6 +161,11 @@
 
 // Reserve 64 bytes of memory before calling  SAVE_FLOAT_ARGUMENT_REGISTERS
 .macro SAVE_FLOAT_ARGUMENT_REGISTERS reg, ofs
+    // Honor the compiler's -march: emit the FP register saves only when the
+    // target has a floating-point unit (__riscv_flen != 0). On a soft-float /
+    // no-FPU build (e.g. -march=rv64ima) these become no-ops; the caller still
+    // reserves the 64-byte slot so frame offsets are unaffected.
+#if __riscv_flen != 0
     fsd  fa0, (\ofs)(\reg)
     fsd  fa1, (\ofs + 8)(\reg)
     fsd  fa2, (\ofs + 16)(\reg)
@@ -169,6 +174,7 @@
     fsd  fa5, (\ofs + 40)(\reg)
     fsd  fa6, (\ofs + 48)(\reg)
     fsd  fa7, (\ofs + 56)(\reg)
+#endif
 .endm
 
 // Reserve 64 bytes of memory before calling  SAVE_FLOAT_CALLEESAVED_REGISTERS
@@ -199,6 +205,9 @@
 .endm
 
 .macro RESTORE_FLOAT_ARGUMENT_REGISTERS reg, ofs
+    // Honor -march: restore FP argument registers only on an FP-capable target
+    // (see SAVE_FLOAT_ARGUMENT_REGISTERS). No-op on soft-float builds.
+#if __riscv_flen != 0
     fld  fa0, (\ofs)(\reg)
     fld  fa1, (\ofs + 8)(\reg)
     fld  fa2, (\ofs + 16)(\reg)
@@ -207,6 +216,7 @@
     fld  fa5, (\ofs + 40)(\reg)
     fld  fa6, (\ofs + 48)(\reg)
     fld  fa7, (\ofs + 56)(\reg)
+#endif
 .endm
 
 .macro RESTORE_FLOAT_CALLEESAVED_REGISTERS reg, ofs
