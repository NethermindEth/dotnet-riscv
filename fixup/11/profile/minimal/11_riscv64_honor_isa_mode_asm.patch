diff --git a/src/coreclr/vm/precode.h b/src/coreclr/vm/precode.h
--- a/src/coreclr/vm/precode.h
+++ b/src/coreclr/vm/precode.h
@@ -394,7 +394,17 @@ struct FixupPrecode
     static const int FixupCodeOffset = 12;
 #elif defined(TARGET_RISCV64)
     static const SIZE_T CodeSize = 32;
+    // Keep in sync with FixupPrecodeCode in vm/riscv64/thunktemplates.S. The
+    // second half of the thunk (the `fence r,rw`) follows auipc + ld + the tail
+    // jump, so its offset depends on whether that jump is the 2-byte c.jr or the
+    // 4-byte jr. __riscv_compressed is predefined by the compiler from -march,
+    // exactly as in the assembly, so both halves stay consistent - but that also
+    // means the runtime and any DAC built for it must use the same -march.
+#ifdef __riscv_compressed
     static const int FixupCodeOffset = 10;
+#else
+    static const int FixupCodeOffset = 12;
+#endif
 #endif // TARGET_AMD64
 
     BYTE m_code[CodeSize];
