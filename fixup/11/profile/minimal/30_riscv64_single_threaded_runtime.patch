diff --git a/src/coreclr/nativeaot/Runtime/FinalizerHelpers.SingleThreaded.cpp b/src/coreclr/nativeaot/Runtime/FinalizerHelpers.SingleThreaded.cpp
new file mode 100644
--- /dev/null
+++ b/src/coreclr/nativeaot/Runtime/FinalizerHelpers.SingleThreaded.cpp
@@ -0,0 +1,122 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+//
+// Unmanaged portion of finalization for a single-threaded runtime
+// (FEATURE_SINGLE_THREADED_RUNTIME): there is no finalizer thread, so
+// finalizable objects are only processed explicitly, on the caller's thread,
+// through GC.WaitForPendingFinalizers. This is the model of the NativeAOT-LLVM
+// (WebAssembly) runtime; it is selected here by the libRuntime.SingleThreaded
+// flavor instead of by the target, so that the same target keeps its regular
+// multi-threaded runtime available.
+//
+#include "common.h"
+#include "gcenv.h"
+#include "gcheaputilities.h"
+#include "thread.h"
+#include "threadstore.h"
+#include "threadstore.inl"
+#include "thread.inl"
+
+// Set when the GC has queued finalizable objects. Used for quick early outs.
+static bool g_FinalizationRequestPending = false;
+static bool g_FinalizationInProgress = false;
+
+// Managed drain of the finalization queue (Runtime.Base __Finalizer).
+EXTERN_C void QCALLTYPE RhpProcessFinalizersAndReturn();
+
+static void FinalizeFinalizableObjects()
+{
+    // Must be called in preemptive mode: the managed drain runs arbitrary finalizers.
+    ASSERT(!ThreadStore::GetCurrentThread()->IsCurrentThreadInCooperativeMode());
+
+    // A recursive wait (a finalizer calling GC.WaitForPendingFinalizers) is a no-op.
+    if (g_FinalizationRequestPending && !g_FinalizationInProgress)
+    {
+        g_FinalizationInProgress = true;
+        RhpProcessFinalizersAndReturn();
+
+        // Finalizers may have queued new objects (GC.ReRegisterForFinalize); they wait for
+        // the next top-level request. Restarting here could loop on self-rearming finalizers.
+        g_FinalizationRequestPending = false;
+        g_FinalizationInProgress = false;
+    }
+}
+
+bool RhInitializeFinalization()
+{
+    // No finalizer thread, no events to allocate.
+    return true;
+}
+
+#ifdef TARGET_WINDOWS
+bool RhWaitForFinalizerThreadStart()
+{
+    return true;
+}
+#endif
+
+// Called by the GC at the end of a collection that found finalizable objects.
+void RhEnableFinalization()
+{
+    g_FinalizationRequestPending = true;
+}
+
+EXTERN_C void QCALLTYPE RhWaitForPendingFinalizers(UInt32_BOOL allowReentrantWait)
+{
+    UNREFERENCED_PARAMETER(allowReentrantWait);
+    FinalizeFinalizableObjects();
+}
+
+// The finalizer-thread protocol (Runtime.Base __Finalizer.ProcessFinalizers) is still
+// compiled into the class library, which is shared between the runtime flavors; it is
+// never entered without a finalizer thread. Keep the symbols resolvable and loud.
+EXTERN_C UInt32_BOOL QCALLTYPE RhpWaitForFinalizerRequest()
+{
+    ASSERT_UNCONDITIONALLY("RhpWaitForFinalizerRequest called on a single-threaded runtime");
+    RhFailFast();
+    return FALSE;
+}
+
+EXTERN_C void QCALLTYPE RhpSignalFinalizationComplete(uint32_t fcount, int32_t observedFullGcCount)
+{
+    UNREFERENCED_PARAMETER(fcount);
+    UNREFERENCED_PARAMETER(observedFullGcCount);
+    ASSERT_UNCONDITIONALLY("RhpSignalFinalizationComplete called on a single-threaded runtime");
+    RhFailFast();
+}
+
+//
+// The following helpers are special in that they interact with internal GC state or directly manipulate
+// managed references so they're called with a special co-operative p/invoke.
+//
+
+// Fetch next object which needs finalization or return null if we've reached the end of the list.
+FCIMPL0(OBJECTREF, RhpGetNextFinalizableObject)
+{
+    while (true)
+    {
+        // Get the next finalizable object. If we get back NULL we've reached the end of the list.
+        OBJECTREF refNext = GCHeapUtilities::GetGCHeap()->GetNextFinalizable();
+        if (refNext == NULL)
+            return NULL;
+
+        // The queue may contain objects which have been marked as finalized already (via GC.SuppressFinalize()
+        // for instance). Skip finalization for these but reset the flag so that the object can be put back on
+        // the list with RegisterForFinalization().
+        if (refNext->GetHeader()->GetBits() & BIT_SBLK_FINALIZER_RUN)
+        {
+            refNext->GetHeader()->ClrBit(BIT_SBLK_FINALIZER_RUN);
+            continue;
+        }
+
+        // We've found the first finalizable object, return it to the caller.
+        return refNext;
+    }
+}
+FCIMPLEND
+
+FCIMPL0(FC_BOOL_RET, RhpCurrentThreadIsFinalizerThread)
+{
+    FC_RETURN_BOOL(false);
+}
+FCIMPLEND
