+# finalization implementation that runs on the calling thread (no finalizer
+# thread). Selected by the IlcSingleThreadedRuntime build property.
+add_library(Runtime.GC.SingleThreaded OBJECT ${GC_WKS_SVR_SOURCES})
+if(FEATURE_PERFTRACING)
+  add_dependencies(Runtime.GC.SingleThreaded aot_eventing_headers)
+endif()
+target_compile_definitions(Runtime.GC.SingleThreaded PRIVATE FEATURE_SINGLE_THREADED_RUNTIME)
+set_target_properties(Runtime.GC.SingleThreaded PROPERTIES UNITY_BUILD ON UNITY_BUILD_BATCH_SIZE 0)
+if (CLR_CMAKE_TARGET_WIN32)
+  target_compile_options(Runtime.GC.SingleThreaded PRIVATE /Z7)
+endif (CLR_CMAKE_TARGET_WIN32)
+
+set(SINGLE_THREADED_RUNTIME_SOURCES ${COMMON_RUNTIME_SOURCES})
+list(FILTER SINGLE_THREADED_RUNTIME_SOURCES EXCLUDE REGEX "/FinalizerHelpers\\.cpp$")
+list(APPEND SINGLE_THREADED_RUNTIME_SOURCES ${NATIVEAOT_RUNTIME_DIR}/FinalizerHelpers.SingleThreaded.cpp)
+
+add_library(Runtime.SingleThreaded STATIC
+    ${SINGLE_THREADED_RUNTIME_SOURCES}
+    ${FULL_RUNTIME_SOURCES}
+    ${NATIVEAOT_PRIVATE_LIBUNWIND_OBJECT}
+    ${RUNTIME_ARCH_ASM_OBJECTS}
+    $<TARGET_OBJECTS:Runtime.GC.SingleThreaded>)
+if(FEATURE_PERFTRACING)
+  add_dependencies(Runtime.SingleThreaded aot_eventing_headers)
+endif()
+target_compile_definitions(Runtime.SingleThreaded PRIVATE FEATURE_SINGLE_THREADED_RUNTIME)
+target_link_libraries(Runtime.SingleThreaded PRIVATE aotminipal nativeaot_cdac_contract_descriptor nativeaot_gc_wks_descriptor)
+
