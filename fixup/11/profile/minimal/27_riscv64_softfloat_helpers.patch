 }
 HCIMPLEND
 
+/*********************************************************************/
+// Soft-float helpers (no-FPU targets). On hard-float hosts these fold to the
+// native FP instructions. The compare helpers follow the libgcc tri-state
+// conventions: lt/le return +1 on unordered, gt/ge return -1, eq nonzero.
+
+HCIMPL2_VV(float, JIT_FltAdd, float a, float b)
+{
+    FCALL_CONTRACT;
+    return a + b;
+}
+HCIMPLEND
+
+HCIMPL2_VV(float, JIT_FltSub, float a, float b)
+{
+    FCALL_CONTRACT;
+    return a - b;
+}
+HCIMPLEND
+
+HCIMPL2_VV(float, JIT_FltMul, float a, float b)
+{
+    FCALL_CONTRACT;
+    return a * b;
+}
+HCIMPLEND
+
+HCIMPL2_VV(float, JIT_FltDiv, float a, float b)
+{
+    FCALL_CONTRACT;
+    return a / b;
+}
+HCIMPLEND
+
+HCIMPL2_VV(double, JIT_DblAdd, double a, double b)
+{
+    FCALL_CONTRACT;
+    return a + b;
+}
+HCIMPLEND
+
+HCIMPL2_VV(double, JIT_DblSub, double a, double b)
+{
+    FCALL_CONTRACT;
+    return a - b;
+}
+HCIMPLEND
+
+HCIMPL2_VV(double, JIT_DblMul, double a, double b)
+{
+    FCALL_CONTRACT;
+    return a * b;
+}
+HCIMPLEND
+
+HCIMPL2_VV(double, JIT_DblDiv, double a, double b)
+{
+    FCALL_CONTRACT;
+    return a / b;
+}
+HCIMPLEND
+
+HCIMPL2_VV(int32_t, JIT_FltCmpEq, float a, float b)
+{
+    FCALL_CONTRACT;
+    return (a == b) ? 0 : 1;
+}
+HCIMPLEND
+
+HCIMPL2_VV(int32_t, JIT_FltCmpLt, float a, float b)
+{
+    FCALL_CONTRACT;
+    return (a < b) ? -1 : ((a == b) ? 0 : 1);
+}
+HCIMPLEND
+
+HCIMPL2_VV(int32_t, JIT_FltCmpLe, float a, float b)
+{
+    FCALL_CONTRACT;
+    return (a < b) ? -1 : ((a == b) ? 0 : 1);
+}
+HCIMPLEND
+
+HCIMPL2_VV(int32_t, JIT_FltCmpGt, float a, float b)
+{
+    FCALL_CONTRACT;
+    return (a > b) ? 1 : ((a == b) ? 0 : -1);
+}
+HCIMPLEND
+
+HCIMPL2_VV(int32_t, JIT_FltCmpGe, float a, float b)
+{
+    FCALL_CONTRACT;
+    return (a > b) ? 1 : ((a == b) ? 0 : -1);
+}
+HCIMPLEND
+
+HCIMPL2_VV(int32_t, JIT_DblCmpEq, double a, double b)
+{
+    FCALL_CONTRACT;
+    return (a == b) ? 0 : 1;
+}
+HCIMPLEND
+
+HCIMPL2_VV(int32_t, JIT_DblCmpLt, double a, double b)
+{
+    FCALL_CONTRACT;
+    return (a < b) ? -1 : ((a == b) ? 0 : 1);
+}
+HCIMPLEND
+
+HCIMPL2_VV(int32_t, JIT_DblCmpLe, double a, double b)
+{
+    FCALL_CONTRACT;
+    return (a < b) ? -1 : ((a == b) ? 0 : 1);
+}
+HCIMPLEND
+
+HCIMPL2_VV(int32_t, JIT_DblCmpGt, double a, double b)
+{
+    FCALL_CONTRACT;
+    return (a > b) ? 1 : ((a == b) ? 0 : -1);
+}
+HCIMPLEND
+
+HCIMPL2_VV(int32_t, JIT_DblCmpGe, double a, double b)
+{
+    FCALL_CONTRACT;
+    return (a > b) ? 1 : ((a == b) ? 0 : -1);
+}
+HCIMPLEND
+
+HCIMPL1_V(double, JIT_Flt2Dbl, float val)
+{
+    FCALL_CONTRACT;
+    return (double)val;
+}
+HCIMPLEND
+
+HCIMPL1_V(float, JIT_Dbl2Flt, double val)
+{
+    FCALL_CONTRACT;
+    return (float)val;
+}
+HCIMPLEND
+
