diff --git a/src/coreclr/tools/aot/ILCompiler.Compiler.Tests/RiscV64ObjectWriterTests.cs b/src/coreclr/tools/aot/ILCompiler.Compiler.Tests/RiscV64ObjectWriterTests.cs
new file mode 100644
--- /dev/null
+++ b/src/coreclr/tools/aot/ILCompiler.Compiler.Tests/RiscV64ObjectWriterTests.cs
@@ -0,0 +1,26 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+using ILCompiler.ObjectWriter;
+using Internal.TypeSystem;
+using Xunit;
+
+namespace ILCompiler.Compiler.Tests
+{
+    public class RiscV64ObjectWriterTests
+    {
+        // e_flags of a RISC-V object: EF_RISCV_RVC (0x1) only when the target has the C
+        // extension, EF_RISCV_FLOAT_ABI_DOUBLE (0x4) for lp64d and EF_RISCV_FLOAT_ABI_SOFT (0)
+        // for the lp64 (soft-float) ABI.
+        [Theory]
+        [InlineData(TargetAbi.NativeAot, false, 0x4u)]
+        [InlineData(TargetAbi.NativeAot, true, 0x5u)]
+        [InlineData(TargetAbi.NativeAotRiscV64SoftFloat, false, 0x0u)]
+        [InlineData(TargetAbi.NativeAotRiscV64SoftFloat, true, 0x1u)]
+        public void ElfFlagsFollowTheTarget(TargetAbi abi, bool compressed, uint expectedFlags)
+        {
+            ObjectWritingOptions options = compressed ? ObjectWritingOptions.RiscV64Compressed : ObjectWritingOptions.None;
+            Assert.Equal(expectedFlags, ElfObjectWriter.GetRiscV64ElfFlags(abi, options));
+        }
+    }
+}
