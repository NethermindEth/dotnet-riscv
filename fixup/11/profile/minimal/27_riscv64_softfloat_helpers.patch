diff --git a/src/coreclr/jit/valuenumfuncs.h b/src/coreclr/jit/valuenumfuncs.h
--- a/src/coreclr/jit/valuenumfuncs.h
+++ b/src/coreclr/jit/valuenumfuncs.h
@@ -213,6 +213,38 @@ ValueNumFuncDef(HWI_INTRINSIC_END, -1, false, false)
     ValueNumFuncDef(MaxInt, 2, true, false)
     ValueNumFuncDef(MinInt_UN, 2, true, false)
     ValueNumFuncDef(MaxInt_UN, 2, true, false)
+
+    // Soft-float helper calls (no-F targets). These are pure, so they need a
+    // VNFunc to be CSE-able, but they must stay opaque to the evaluator: their
+    // operands are the *integer bit patterns* of the FP values, so reusing
+    // VNF_ADD and friends would let VN constant-fold them with integer
+    // arithmetic and produce wrong results. None of these appears in
+    // VNEvalCanFoldBinaryFunc, so no folding is attempted.
+    // Add and multiply are marked commutative, matching how VN already treats
+    // the hardware FP forms.
+    ValueNumFuncDef(SoftFPAddFlt, 2, true, false)
+    ValueNumFuncDef(SoftFPAddDbl, 2, true, false)
+    ValueNumFuncDef(SoftFPSubFlt, 2, false, false)
+    ValueNumFuncDef(SoftFPSubDbl, 2, false, false)
+    ValueNumFuncDef(SoftFPMulFlt, 2, true, false)
+    ValueNumFuncDef(SoftFPMulDbl, 2, true, false)
+    ValueNumFuncDef(SoftFPDivFlt, 2, false, false)
+    ValueNumFuncDef(SoftFPDivDbl, 2, false, false)
+    // Tri-state comparisons: swapping the operands negates the result, so
+    // none of them is commutative (not even the eq form, which is an alias of
+    // the le form in compiler-rt).
+    ValueNumFuncDef(SoftFPCmpEqFlt, 2, false, false)
+    ValueNumFuncDef(SoftFPCmpEqDbl, 2, false, false)
+    ValueNumFuncDef(SoftFPCmpLtFlt, 2, false, false)
+    ValueNumFuncDef(SoftFPCmpLtDbl, 2, false, false)
+    ValueNumFuncDef(SoftFPCmpLeFlt, 2, false, false)
+    ValueNumFuncDef(SoftFPCmpLeDbl, 2, false, false)
+    ValueNumFuncDef(SoftFPCmpGtFlt, 2, false, false)
+    ValueNumFuncDef(SoftFPCmpGtDbl, 2, false, false)
+    ValueNumFuncDef(SoftFPCmpGeFlt, 2, false, false)
+    ValueNumFuncDef(SoftFPCmpGeDbl, 2, false, false)
+    ValueNumFuncDef(SoftFPFlt2Dbl, 1, false, false)
+    ValueNumFuncDef(SoftFPDbl2Flt, 1, false, false)
 #endif // TARGET_RISCV64
 
 // clang-format on
