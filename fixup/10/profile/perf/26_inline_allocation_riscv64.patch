+#if defined(TARGET_RISCV64)
+    // ===== zkVM per-site inline allocation (fixed-size reference types) =======
+    // A zkVM guest has no GC and no OS: every byte it allocates comes from one
+    // downward bump pointer in a cell at a FIXED address, shared with the C
+    // allocator in the guest's PAL. Because the address is fixed, the bump can
+    // be inlined at each allocation site as a bare constant with no relocation,
+    // which is much cheaper than a call to the allocation helper.
+    //
+    // The address is NOT baked in here. It comes from JitZkBumpAddr and is 0 by
+    // default, so an ordinary riscv64 target (linux/musl/glibc) is unaffected -
+    // an absolute constant address is meaningless there, and writing to it would
+    // be memory corruption. Only a build that passes the knob gets the inline
+    // sequence, and the value it passes must match the address its linker script
+    // gives the cell.
+    //
+    // Layout, identical to the C allocator's so inline- and helper-allocated
+    // objects interleave on one heap:
+    //
+    //     cell[0]   = bump pointer = header address of the last object
+    //     cell[-1]  = heap floor   = lowest address the heap may occupy
+    //     object    = header + 8,  header holds the payload size
+    //
+    // COST: exactly one instruction more than an unchecked bump - a single
+    // `bgeu` to the method's one shared SCK_FAIL_FAST block (fgAddCodeRef gives
+    // FAIL_FAST refData 0, so every site in the method shares one block and no
+    // code is added per site). The floor is loaded, not materialized, but the
+    // load is marked invariant, so it is value-numbered as VNF_InvariantLoad,
+    // CSEd across every allocation site in the method and hoisted out of loops:
+    // its cost is amortized away rather than paid per allocation.
+    //
+    // The guard rejects `header <= floor`, i.e. the heap is exhausted. There is
+    // no GC to fall back on, so the helper could not satisfy the request either
+    // and failing fast is the honest outcome. Without it the bump walks down
+    // into .bss, .data and the stack and corrupts them silently - the same
+    // failure the PAL's C allocator has always checked for. The guard runs
+    // before the cell is updated, so a trap leaves the heap exactly as it was.
+    //
+    // WHY THE FLOOR MAY BE TREATED AS INVARIANT, and why there is no second
+    // guard for an unset cell: the PAL publishes the floor from an .init_array
+    // constructor, before __libc_start_main hands control to the runtime's entry
+    // point, and never writes it again. So by the time any JIT-compiled code
+    // exists the cell is set, and it never changes afterwards. A PAL that
+    // published it later, or moved it, would break this transform.
+    //
+    // EXPECTED ITERATION POINTS if it miscompiles/asserts:
+    //   (1) ref vs native-int typing of the result local (TYP_REF read of a
+    //       TYP_I_IMPL local);
+    //   (2) COMMA-of-stores shape / GTF flags on the bump indirs;
+    //   (3) getHeapClassSize vs the runtime MT.BaseSize the helper uses.
+
+    // NativeAOT's getNewHelper returns CORINFO_HELP_NEWSFAST for a plain fixed-size
+    // reference class (no finalizer, no align8) - it maps to RhpNewFast, whose bump
+    // protocol this inline mirrors. (CORINFO_HELP_NEWFAST is NOT used for newobj here;
+    // the _FINALIZE / _ALIGN8 / _VC variants map to other helpers and are left alone.)
+    if ((helper == CORINFO_HELP_NEWSFAST) && (allocObj->gtAllocObjClsHnd != NO_CLASS_HANDLE) && (arg != nullptr))
+    {
+        // Low 32 bits of the cell address, zero-extended. 0 disables the transform.
+        const ssize_t bumpAddr = (ssize_t)(size_t)(uint32_t)JitConfig.JitZkBumpAddr();
+
+        if ((bumpAddr != 0) && ((bumpAddr & 7) == 0))
+        {
+            const unsigned MIN_OBJ_SIZE = 0x18;
+
+            unsigned baseSize = comp->info.compCompHnd->getHeapClassSize(allocObj->gtAllocObjClsHnd);
+            if (baseSize < MIN_OBJ_SIZE)
+            {
+                baseSize = MIN_OBJ_SIZE;
+            }
+            const ssize_t payload = (ssize_t)((baseSize + 7u) & ~(unsigned)7u);
+
+            unsigned cellLcl = comp->lvaGrabTemp(true DEBUGARG("zkVM inline-alloc cell"));
+            unsigned objLcl  = comp->lvaGrabTemp(true DEBUGARG("zkVM inline-alloc obj"));
+            unsigned hdrLcl  = comp->lvaGrabTemp(true DEBUGARG("zkVM inline-alloc hdr"));
+            comp->lvaTable[cellLcl].lvType = TYP_I_IMPL;
+            comp->lvaTable[objLcl].lvType  = TYP_I_IMPL;
+            comp->lvaTable[hdrLcl].lvType  = TYP_I_IMPL;
+
+            // cell = BUMP_ADDR. Held in a local so the constant is materialized
+            // once and reused by the load and the store below.
+            GenTree* storeCell = comp->gtNewStoreLclVarNode(cellLcl, comp->gtNewIconNode(bumpAddr, TYP_I_IMPL));
+
+            // obj = *(intptr*)cell - payload
+            GenTree* cur = comp->gtNewIndir(TYP_I_IMPL, comp->gtNewLclvNode(cellLcl, TYP_I_IMPL));
+            GenTree* storeObj =
+                comp->gtNewStoreLclVarNode(objLcl, comp->gtNewOperNode(GT_SUB, TYP_I_IMPL, cur,
+                                                                      comp->gtNewIconNode(payload, TYP_I_IMPL)));
+
+            // hdr = obj - 8
+            GenTree* storeHdr = comp->gtNewStoreLclVarNode(
+                hdrLcl, comp->gtNewOperNode(GT_SUB, TYP_I_IMPL, comp->gtNewLclvNode(objLcl, TYP_I_IMPL),
+                                            comp->gtNewIconNode(8, TYP_I_IMPL)));
+
+            // floor = *(intptr*)(BUMP_ADDR - 8), invariant: a separate constant
+            // address rather than cell-8, so the whole load is one hoistable,
+            // CSEable expression instead of one anchored on a per-site local.
+            GenTree* floor = comp->gtNewIndir(TYP_I_IMPL, comp->gtNewIconNode(bumpAddr - 8, TYP_I_IMPL),
+                                              GTF_IND_NONFAULTING | GTF_IND_INVARIANT);
+
+            // Guard: fail fast when hdr <= floor. GT_BOUNDS_CHECK traps on
+            // (unsigned)index >= (unsigned)length, so index = floor, length = hdr.
+            // Rejecting the exact boundary costs at most one object at the very
+            // bottom of the heap and keeps this to a single instruction.
+            GenTree* guard = new (comp, GT_BOUNDS_CHECK)
+                GenTreeBoundsChk(floor, comp->gtNewLclvNode(hdrLcl, TYP_I_IMPL), SCK_FAIL_FAST);
+
+            // *(intptr*)cell = hdr
+            GenTree* storeBump = comp->gtNewStoreIndNode(TYP_I_IMPL, comp->gtNewLclvNode(cellLcl, TYP_I_IMPL),
+                                                         comp->gtNewLclvNode(hdrLcl, TYP_I_IMPL));
+
+            // *(int64*)hdr = payload   (size header, for layout compat with the C allocator)
+            GenTree* storeSize = comp->gtNewStoreIndNode(TYP_LONG, comp->gtNewLclvNode(hdrLcl, TYP_I_IMPL),
+                                                         comp->gtNewIconNode(payload, TYP_LONG));
+
+            // *(intptr*)obj = MethodTable
+            GenTree* storeMt =
+                comp->gtNewStoreIndNode(TYP_I_IMPL, comp->gtNewLclvNode(objLcl, TYP_I_IMPL), arg);
+
+            // result value: obj as an object reference
+            GenTree* result = comp->gtNewLclvNode(objLcl, TYP_REF);
+
+            // COMMA nests right, so the node passed as op1 runs first: build from
+            // the tail so evaluation is cell, obj, hdr, guard, then the stores.
+            GenTree* tree = comp->gtNewOperNode(GT_COMMA, TYP_REF, storeMt, result);
+            tree          = comp->gtNewOperNode(GT_COMMA, TYP_REF, storeSize, tree);
+            tree          = comp->gtNewOperNode(GT_COMMA, TYP_REF, storeBump, tree);
+            tree          = comp->gtNewOperNode(GT_COMMA, TYP_REF, guard, tree);
+            tree          = comp->gtNewOperNode(GT_COMMA, TYP_REF, storeHdr, tree);
+            tree          = comp->gtNewOperNode(GT_COMMA, TYP_REF, storeObj, tree);
+            tree          = comp->gtNewOperNode(GT_COMMA, TYP_REF, storeCell, tree);
+            return tree;
+        }
+    }
+    // =========================================================================
+#endif // TARGET_RISCV64
+
     const bool morphArgs  = false;
     GenTree*   helperCall = comp->fgMorphIntoHelperCall(allocObj, allocObj->gtNewHelper, morphArgs, arg);
