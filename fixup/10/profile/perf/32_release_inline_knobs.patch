+//------------------------------------------------------------------------
+// ClampConfigValue: clamp a config value to the range the implementation
+//    supports
+//
+// Arguments:
+//    value      - value read from config
+//    lowerBound - smallest supported value
+//    upperBound - largest supported value
+//
+// Return Value:
+//    value, clamped to [lowerBound, upperBound]
+
+static unsigned ClampConfigValue(int value, int lowerBound, int upperBound)
+{
+    assert(lowerBound <= upperBound);
+    return (unsigned)((value < lowerBound) ? lowerBound : ((value > upperBound) ? upperBound : value));
+}
+
