+//------------------------------------------------------------------------
+// genCodeForDmaCmp: Emit the zkVM (ZisK) inline DMA-memcmp idiom for GT_DMA_CMP.
+//
+// The ZisK ROM transpiler folds the adjacent instruction pair
+//
+//     csrrs <resultReg>, 0x814, <srcReg>
+//     addi  x0, <dstReg>, N              ; N = byte count (must fit simm12)
+//
+// into a single dma_xmemcmp emulator step that compares N bytes at dst against src
+// and writes the memcmp difference (0 iff the buffers are equal) into <resultReg>.
+//
+// The result register is the CSRRS's rd and the addi's rd MUST be x0. The mirrored
+// form (rd on the addi, x0 on the csrrs) also transpiles, but through the branch
+// ZisK marks DEPRECATED - it prints "DEPRECATED INSTRUCTION ... please update
+// toolchain/zisklibs/ziskos" and is slated for removal. This encoding matches
+// ziskos's own dma/memcmp.s, which is the reference.
+//
+// Note that resultReg may be the same register as dstReg or srcReg: the two RISC-V
+// instructions become ONE emulator step, so there is no intermediate write to
+// clobber an operand. ziskos's memcmp.s relies on exactly that (csrrs a0, ...;
+// add x0, a0, a2), so no LSRA constraint is needed here.
+//
+// The two instructions MUST remain adjacent - the transpiler panics if the csrrs is
+// not immediately followed by the addi - so they are emitted back-to-back here with
+// nothing in between. Behind JitRiscV64DmaCompare; only emitted for ZisK targets.
+//
+void CodeGen::genCodeForDmaCmp(GenTreeDmaCmp* tree)
+{
+    assert(tree->OperIs(GT_DMA_CMP));
+    assert(tree->gtCount > 0);
+    assert(tree->gtCount <= 2047); // fits the addi immediate
 
+    genConsumeOperands(tree);
+
+    const regNumber dstReg    = tree->gtOp1->GetRegNum(); // addi rs1
+    const regNumber srcReg    = tree->gtOp2->GetRegNum(); // csrrs rs1
+    const regNumber resultReg = tree->GetRegNum();        // csrrs rd (== memcmp result)
+
+    // csrrs result, 0x814, src
+    GetEmitter()->emitIns_R_R_I(INS_csrrs, EA_PTRSIZE, resultReg, srcReg, 0x814);
+    // addi x0, dst, count      (transpiled: result = memcmp(dst, src, count))
+    GetEmitter()->emitIns_R_R_I(INS_addi, EA_PTRSIZE, REG_R0, dstReg, (ssize_t)tree->gtCount);
+
     genProduceReg(tree);
 }
 
