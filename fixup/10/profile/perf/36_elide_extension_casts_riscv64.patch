+                LclVarDsc* varDsc = comp->lvaGetDesc(op1->AsLclVar());
+                op1IsBit31Clear   = varDsc->lvNormalizeOnStore() &&
+                                  ((varDsc->TypeGet() == TYP_UBYTE) || (varDsc->TypeGet() == TYP_USHORT));
+            }
+        }
+
+        const bool removableSigned =
