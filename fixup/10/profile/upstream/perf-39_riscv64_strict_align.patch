+//------------------------------------------------------------------------
+// Strict alignment support (JitRiscV64StrictAlign).
+//
+// RiscV64IsAddrKnownAligned: is `addr` provably a multiple of `align`?
+//
+// Object references are 8-byte aligned, so anything reached from one by a
+// constant offset (fields), a scaled index whose scale is a multiple of the
+// access width (array elements) or an address mode built from those is
+// aligned. Stack locals are pointer-aligned, handles (statics, string
+// literals, frozen objects) are at least pointer-aligned. Everything else -
+// byrefs out of spans, Unsafe.As reinterpretation, plain pointer arithmetic -
+// is unknown and reported as not aligned.
+//
+static bool RiscV64IsAddrKnownAligned(GenTree* addr, unsigned align)
+{
+    if (align <= 1)
+    {
+        return true;
+    }
+    if (addr->TypeIs(TYP_REF))
+    {
+        return true; // an object pointer: 8-byte aligned
+    }
+
+    switch (addr->OperGet())
+    {
+        case GT_LEA:
+        {
+            GenTreeAddrMode* lea = addr->AsAddrMode();
+            if (!lea->HasBase() || !RiscV64IsAddrKnownAligned(lea->Base(), align))
+            {
+                return false;
+            }
+            if (lea->HasIndex() && ((lea->GetScale() % align) != 0))
+            {
+                return false;
+            }
+            return (lea->Offset() % (int)align) == 0;
+        }
+
+        case GT_ADD:
+        {
+            GenTree* op1 = addr->gtGetOp1();
+            GenTree* op2 = addr->gtGetOp2();
+            if (op2->IsCnsIntOrI())
+            {
+                return RiscV64IsAddrKnownAligned(op1, align) && ((op2->AsIntCon()->IconValue() % (ssize_t)align) == 0);
+            }
+            if (op1->IsCnsIntOrI())
+            {
+                return RiscV64IsAddrKnownAligned(op2, align) && ((op1->AsIntCon()->IconValue() % (ssize_t)align) == 0);
+            }
+            // base + (index << n) / base + index * n, either order
+            for (int i = 0; i < 2; i++)
+            {
+                GenTree* base = (i == 0) ? op1 : op2;
+                GenTree* idx  = (i == 0) ? op2 : op1;
+                if (!RiscV64IsAddrKnownAligned(base, align))
+                {
+                    continue;
+                }
+                unsigned scale = 0;
+                if (idx->OperIs(GT_LSH) && idx->gtGetOp2()->IsCnsIntOrI())
+                {
+                    ssize_t sh = idx->gtGetOp2()->AsIntCon()->IconValue();
+                    scale      = ((sh >= 0) && (sh < 32)) ? (1u << sh) : 0;
+                }
+                else if (idx->OperIs(GT_MUL) && idx->gtGetOp2()->IsCnsIntOrI())
+                {
+                    ssize_t m = idx->gtGetOp2()->AsIntCon()->IconValue();
+                    scale     = ((m > 0) && (m < INT32_MAX)) ? (unsigned)m : 0;
+                }
+                if ((scale != 0) && ((scale % align) == 0))
