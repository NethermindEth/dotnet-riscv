+bool RiscV64LclByteWise(Compiler* comp, GenTreeLclVarCommon* lcl)
+{
+    if ((JitConfig.JitRiscV64StrictAlign() == 0) || (JitConfig.JitNoUnalignedAccess() == 0))
+    {
+        return false;
+    }
+    if (lcl->TypeIs(TYP_STRUCT))
+    {
+        return false;
+    }
+    unsigned size = genTypeSize(lcl->TypeGet());
+    if ((size != 2) && (size != 4) && (size != 8))
+    {
+        return false;
+    }
+    LclVarDsc* varDsc = comp->lvaGetDesc(lcl);
+    if (varDsc->lvIsRegCandidate())
+    {
+        return false;
+    }
+    unsigned offs = lcl->GetLclOffs();
+    if (varDsc->lvIsStructField)
+    {
+        offs += varDsc->lvFldOffset;
+    }
+    return (offs % size) != 0;
