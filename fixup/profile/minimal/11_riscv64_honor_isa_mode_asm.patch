@@ -14,6 +14,13 @@ LEAF_END_MARKED StubPrecodeCode
 LEAF_ENTRY FixupPrecodeCode
     auipc t2, 0x4
     ld t2, (FixupPrecodeData__Target)(t2)
+    // Honor the compiler's -march: with the C extension the tail jump is the
+    // 2-byte c.jr, so the second auipc lands at thunk offset 0xe and the data
+    // loads compensate with -0xe. Without C (e.g. -march=rv64ima) c.jr is not
+    // available; the base jr is 4 bytes, moving the second auipc to 0x10, so the
+    // loads use -0x10 instead. __riscv_compressed is predefined by the compiler
+    // from -march, so a single source assembles correctly either way.
+#ifdef __riscv_compressed
     c.jr t2
 
     fence r,rw
@@ -21,6 +28,15 @@ LEAF_ENTRY FixupPrecodeCode
     ld t1, (FixupPrecodeData__PrecodeFixupThunk - 0xe)(t2)
     ld t2, (FixupPrecodeData__MethodDesc - 0xe)(t2)
     jr t1
+#else
+    jr t2
+
+    fence r,rw
+    auipc t2, 0x4
+    ld t1, (FixupPrecodeData__PrecodeFixupThunk - 0x10)(t2)
+    ld t2, (FixupPrecodeData__MethodDesc - 0x10)(t2)
+    jr t1
+#endif
 LEAF_END_MARKED FixupPrecodeCode
 
