#!/bin/sh
# Pins the RISC-V ISA and ABI for target compilations.
#
# The Alpine rootfs we build against is compiled for rv64ima/lp64 (no F, D or C
# extension), while clang defaults to rv64gc/lp64d for the
# riscv64-alpine-linux-musl triple. Without these flags every link against the
# rootfs CRT fails with "cannot link object files with different floating-point
# ABI from Scrt1.o".
#
# They cannot be added from CMake: cmake links a test program at project() time,
# before any of the repo's compile options are applied. They have to be part of
# the compiler command itself, hence CLR_CC/CLR_CXX pointing here.
#
# The same CLR_CC is used for the host-arch cross components (the riscv64 JIT
# that runs on x64), so the flags are only injected when a riscv64 target is
# actually requested. --target= is emitted by eng/common/cross/toolchain.cmake
# and only for cross builds.

name=${0##*/}
dir=${CLANG_DIR:-/usr/local/bin}
real=$dir/$name-${CLANG_VERSION:-20}
[ -x "$real" ] || real=$dir/$name

# NativeAOT's object writer tags managed objects with EF_RISCV_FLOAT_ABI_DOUBLE,
# but everything else here (rootfs CRT, bootstrap aotsdk libs) is lp64 soft-float,
# and lld hard-errors on mixed float ABIs with no way to suppress the check. So
# before a riscv64 link, clear the float-ABI bits (e_flags & 0x6, byte at offset
# 0x30 of the ELF64 header) of every loose riscv64 .o on the command line. The
# FP instructions themselves are untouched — this only retags the calling-
# convention claim, the rv64imafd+lp64 combination.
fix_float_abi() {
    for f in "$@"; do
        case $f in
        *.o) [ -w "$f" ] || continue ;;
        *) continue ;;
        esac
        # ELF64 little-endian RISC-V (e_machine 0xf3) only.
        [ "$(od -An -tx1 -N5 "$f" 2>/dev/null | tr -d ' ')" = "7f454c4602" ] || continue
        [ "$(od -An -tx1 -j18 -N2 "$f" | tr -d ' ')" = "f300" ] || continue
        b=$(od -An -tu1 -j48 -N1 "$f" | tr -d ' ')
        nb=$((b & ~6))
        [ "$nb" = "$b" ] && continue
        printf "\\$(printf '%03o' "$nb")" | dd of="$f" bs=1 seek=48 conv=notrunc 2>/dev/null
    done
}

riscv=0
link=1
for arg in "$@"; do
    case $arg in
    --target=riscv64*) riscv=1 ;;
    -c|-S|-E|-M|-MM) link=0 ;;
    esac
done

if [ "$riscv" = 1 ]; then
    [ "$link" = 1 ] && fix_float_abi "$@"
    exec "$real" "$@" -march=rv64ima -mabi=lp64 -mno-relax -gdwarf-4 -fno-jump-tables
fi

exec "$real" "$@"
