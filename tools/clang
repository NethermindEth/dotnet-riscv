#!/bin/sh
# Pins the RISC-V ISA and ABI for target compilations.
#
# Only code that lands in the zkVM client must stay free of floating-point
# registers, atomic instructions and the C extension: the NativeAOT runtime
# tree — including the GC and llvm-libunwind objects it compiles — and the
# System.Native library family. Those are compiled with -march=rv64im, keeping
# __riscv_flen == 0 and __riscv_atomic undefined so the flen and atomic guards
# patched into the runtime's .S files take effect (llvm-libunwind handles
# flen == 0 upstream); C/C++ atomics lower to __atomic_* calls, satisfied by
# libatomic on the SDK side and by the zisk stack in the client. Client-bound
# compilations are recognized by path: NativeAOT objects are built under a
# nativeaot/ directory and System.Native sources live in src/native/libs.
#
# Everything else (CoreCLR PAL, the savannah libunwind it uses, corehost, ...)
# is SDK-side, never reaches the client, and compiles with the rootfs-native
# rv64imafd/lp64d — which also keeps the savannah libunwind's riscv port on
# its supported flen != 0 paths, no patching needed.
#
# The stock Alpine rootfs is lp64d and lld refuses to mix float ABIs, so every
# produced object is retagged to EF_RISCV_FLOAT_ABI_DOUBLE right after
# compilation (a no-op for the lp64d-compiled ones): the ABI claim then
# matches the rootfs CRT and the double-tagged managed objects everywhere.
# The final client binary's flags are rewritten downstream anyway.
#
# rv64im-compiled code references soft-fp builtins (__adddf3, ...) that the
# rootfs's hard-float libgcc does not provide, so links pull in the
# compiler-rt builtins archive from the rootfs's compiler-rt package.
#
# cmake's configure-time probes compile and link in one step, so their
# intermediate object cannot be retagged; they are compiled as rv64imafd/lp64d
# — only the probe's exit status matters, the binary is discarded.
#
# The flags cannot be added from CMake: cmake links a test program at project()
# time, before any of the repo's compile options are applied. They have to be
# part of the compiler command itself, hence CLR_CC/CLR_CXX pointing here.
#
# The same CLR_CC is used for the host-arch cross components (the riscv64 JIT
# that runs on x64), so the flags are only injected when a riscv64 target is
# actually requested. --target= is emitted by eng/common/cross/toolchain.cmake
# and only for cross builds.

name=${0##*/}
dir=${CLANG_DIR:-/usr/local/bin}
real=$dir/$name-${CLANG_VERSION:-20}
[ -x "$real" ] || real=$dir/$name

riscv=0
compile=0
src=0
out=
prev=
for arg in "$@"; do
    case $arg in
    --target=riscv64*) riscv=1 ;;
    -c|-S|-E) compile=1 ;;
    *.c|*.cc|*.cpp|*.cxx|*.S|*.s) src=1 ;;
    esac
    [ "$prev" = "-o" ] && out=$arg
    prev=$arg
done

[ "$riscv" = 1 ] || exec "$real" "$@"

if [ "$compile" = 0 ] && [ "$src" = 1 ]; then
    # Compile-and-link in one step: a cmake probe. See header comment.
    exec "$real" "$@" -march=rv64imafd -mabi=lp64d -mno-relax -gdwarf-4 -fno-jump-tables
fi

if [ "$compile" = 0 ]; then
    # Pure link: all inputs already carry the double-float tag. Append the
    # soft-fp builtins for the rv64im-compiled objects among them, and
    # libatomic for their __atomic_* calls (the builtins archive carries no
    # atomic helpers; not every link passes -latomic on its own).
    rootfs=${ROOTFS_DIR:-/crossrootfs/riscv64}
    rt=
    for f in "$rootfs"/usr/lib/llvm*/lib/clang/*/lib/riscv64-alpine-linux-musl/libclang_rt.builtins-riscv64.a; do
        [ -f "$f" ] && rt=$f && break
    done
    atomic=
    for f in "$rootfs"/usr/lib/libatomic.so*; do
        [ -e "$f" ] && atomic=-latomic && break
    done
    exec "$real" "$@" -march=rv64im -mabi=lp64 -mno-relax -gdwarf-4 -fno-jump-tables ${rt:+"$rt"} ${atomic:+"$atomic"}
fi

# Classify by the source file and the -o path only — never by -I/-D and other
# flag values: SDK-side compiles may carry -I.../src/native/libs/... include
# paths without being client-bound.
march="-march=rv64imafd -mabi=lp64d"
prev=
for arg in "$@"; do
    if [ "$prev" = "-o" ]; then
        # ninja passes object paths relative to the build root (nativeaot/...),
        # make passes them absolute (.../obj/.../nativeaot/...) — match both.
        case $arg in
        */nativeaot/*|nativeaot/*)
            client=1
            ;;
        esac
    else
        case $arg in
        -*) ;;
        *.c|*.cc|*.cpp|*.cxx|*.S|*.s)
            case $arg in
            */nativeaot/*|*/src/native/libs/*)
                client=1
                ;;
            esac
            ;;
        esac
    fi
    prev=$arg
done
if [ "${client:-0}" = 1 ]; then
    # -Wno-atomic-alignment: without the A extension every __atomic_* call is
    # "not lock-free" and clang warns; the nativeaot build compiles with
    # -Werror, which would turn that into a hard error.
    # -fno-use-cxa-atexit: static destructors register via plain atexit()
    # instead of __cxa_atexit(..., &__dso_handle). The zkVM guest link has no
    # crtbegin.o to define __dso_handle, so the weak reference resolves to
    # address 0 and the PC-relative access from ~0x80000000 overflows
    # R_RISCV_PCREL_HI20 (~-2 GiB). No dso ever unloads in the guest, so the
    # cxa registration protocol buys nothing there.
    march="-march=rv64im -mabi=lp64 -Wno-atomic-alignment -fno-use-cxa-atexit"
fi

"$real" "$@" $march -mno-relax -gdwarf-4 -fno-jump-tables
rc=$?

# Retag the produced object (ELF64 little-endian RISC-V only) to the
# double-float ABI: e_flags is at offset 0x30 of the ELF64 header, the float
# ABI lives in bits 1-2. Other e_flags bits are preserved.
if [ "$rc" = 0 ] && [ -n "$out" ] && [ -f "$out" ]; then
    if [ "$(od -An -tx1 -N5 "$out" 2>/dev/null | tr -d ' ')" = "7f454c4602" ] &&
       [ "$(od -An -tx1 -j18 -N2 "$out" | tr -d ' ')" = "f300" ]; then
        b=$(od -An -tu1 -j48 -N1 "$out" | tr -d ' ')
        nb=$(((b & ~6) | 4))
        [ "$nb" = "$b" ] || printf "\\$(printf '%03o' "$nb")" | dd of="$out" bs=1 seek=48 conv=notrunc 2>/dev/null
    fi
fi
exit $rc
