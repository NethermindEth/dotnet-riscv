#!/bin/sh
# Pins the RISC-V ISA and ABI for target compilations.
#
# Native code built here ends up in the zkVM client, which runs on a strict
# rv64ima core and must not touch floating-point registers. Compiling with
# -march=rv64ima keeps __riscv_flen == 0, which activates the flen guards the
# runtime patches add to the .S files and libunwind, and keeps the C
# (compressed) extension out of the generated code.
#
# The rootfs, however, is the stock lp64d Alpine one, and lld refuses to mix
# float ABIs. The userspace never reaches the zkVM client, so the ABI tag is
# only there to keep lld happy: every object produced here is retagged to
# EF_RISCV_FLOAT_ABI_DOUBLE right after compilation, matching the rootfs CRT
# and the double-tagged managed objects in both the SDK links and the final
# bflat links. The final binary's flags are rewritten downstream anyway.
#
# cmake's configure-time probes compile and link in one step, so their
# intermediate object cannot be retagged; they are compiled as rv64imafd/lp64d
# instead — only the probe's exit status matters, the binary is discarded.
#
# The flags cannot be added from CMake: cmake links a test program at project()
# time, before any of the repo's compile options are applied. They have to be
# part of the compiler command itself, hence CLR_CC/CLR_CXX pointing here.
#
# The same CLR_CC is used for the host-arch cross components (the riscv64 JIT
# that runs on x64), so the flags are only injected when a riscv64 target is
# actually requested. --target= is emitted by eng/common/cross/toolchain.cmake
# and only for cross builds.

name=${0##*/}
dir=${CLANG_DIR:-/usr/local/bin}
real=$dir/$name-${CLANG_VERSION:-20}
[ -x "$real" ] || real=$dir/$name

riscv=0
compile=0
src=0
out=
prev=
for arg in "$@"; do
    case $arg in
    --target=riscv64*) riscv=1 ;;
    -c|-S|-E) compile=1 ;;
    *.c|*.cc|*.cpp|*.cxx|*.S|*.s) src=1 ;;
    esac
    [ "$prev" = "-o" ] && out=$arg
    prev=$arg
done

[ "$riscv" = 1 ] || exec "$real" "$@"

if [ "$compile" = 0 ] && [ "$src" = 1 ]; then
    # Compile-and-link in one step: a cmake probe. See header comment.
    exec "$real" "$@" -march=rv64imafd -mabi=lp64d -mno-relax -gdwarf-4 -fno-jump-tables
fi

if [ "$compile" = 0 ]; then
    # Pure link: all inputs already carry the double-float tag.
    exec "$real" "$@" -march=rv64ima -mabi=lp64 -mno-relax -gdwarf-4 -fno-jump-tables
fi

"$real" "$@" -march=rv64ima -mabi=lp64 -mno-relax -gdwarf-4 -fno-jump-tables
rc=$?

# Retag the produced object (ELF64 little-endian RISC-V only) to the
# double-float ABI: e_flags is at offset 0x30 of the ELF64 header, the float
# ABI lives in bits 1-2. Other e_flags bits are preserved.
if [ "$rc" = 0 ] && [ -n "$out" ] && [ -f "$out" ]; then
    if [ "$(od -An -tx1 -N5 "$out" 2>/dev/null | tr -d ' ')" = "7f454c4602" ] &&
       [ "$(od -An -tx1 -j18 -N2 "$out" | tr -d ' ')" = "f300" ]; then
        b=$(od -An -tu1 -j48 -N1 "$out" | tr -d ' ')
        nb=$(((b & ~6) | 4))
        [ "$nb" = "$b" ] || printf "\\$(printf '%03o' "$nb")" | dd of="$out" bs=1 seek=48 conv=notrunc 2>/dev/null
    fi
fi
exit $rc
