<Project>

  <!--
    Purpose:
      Upstream computes FileVersion as: $(WilsonCurrentVersion).<yy>.<MMdd>
      Example: 8.0.0.70109 (70109 comes from yy=70, MMdd=109). The revision must be <= 65535 for
      AssemblyVersion/FileVersion attributes, otherwise C# compilation fails (CS7035).

    Strategy (for this external package only):
      - Derive AssemblyVersion from VersionPrefix (e.g. 8.0.0.0) so it is always valid and stable.
      - Clamp FileVersion's revision (4th part) to 65535 if it is 4 numeric parts.
      - Leave InformationalVersion untouched.
  -->

  <Target Name="_FixAssemblyAndFileVersionsForSourceBuild"
          BeforeTargets="GenerateAssemblyInfo;CoreCompile"
          Condition="'$(Language)' == 'C#'">

    <!-- Always use a safe AssemblyVersion derived from VersionPrefix when available -->
    <PropertyGroup Condition="'$(VersionPrefix)' != ''">
      <_VersionPrefix>$([MSBuild]::ValueOrDefault('$(VersionPrefix)', ''))</_VersionPrefix>
      <_VersionPrefixPartCount>$(_VersionPrefix.Split('.').Length)</_VersionPrefixPartCount>

      <AssemblyVersion Condition="'$(_VersionPrefixPartCount)' == '3'">$(_VersionPrefix).0</AssemblyVersion>
      <AssemblyVersion Condition="'$(_VersionPrefixPartCount)' == '4'">$(_VersionPrefix)</AssemblyVersion>
    </PropertyGroup>

    <!-- Clamp FileVersion revision -->
    <PropertyGroup Condition="'$(FileVersion)' != ''">
      <_FileVer>$([MSBuild]::ValueOrDefault('$(FileVersion)', ''))</_FileVer>
      <_FileVerPartCount>$(_FileVer.Split('.').Length)</_FileVerPartCount>

      <_FileVerMajor Condition="'$(_FileVerPartCount)' == '4'">$(_FileVer.Split('.')[0])</_FileVerMajor>
      <_FileVerMinor Condition="'$(_FileVerPartCount)' == '4'">$(_FileVer.Split('.')[1])</_FileVerMinor>
      <_FileVerBuild Condition="'$(_FileVerPartCount)' == '4'">$(_FileVer.Split('.')[2])</_FileVerBuild>
      <_FileVerRev   Condition="'$(_FileVerPartCount)' == '4'">$(_FileVer.Split('.')[3])</_FileVerRev>

      <_FileVerRevClamped Condition="'$(_FileVerPartCount)' == '4' and '$(_FileVerRev)' != ''">
        $([System.Math]::Min(65535, $([System.Int32]::Parse('$(_FileVerRev)'))))
      </_FileVerRevClamped>

      <FileVersion Condition="'$(_FileVerPartCount)' == '4' and '$(_FileVerRevClamped)' != ''">
        $(_FileVerMajor).$(_FileVerMinor).$(_FileVerBuild).$(_FileVerRevClamped)
      </FileVersion>
    </PropertyGroup>

  </Target>

</Project>
