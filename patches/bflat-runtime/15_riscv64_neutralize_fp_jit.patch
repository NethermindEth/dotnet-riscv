diff --git a/src/coreclr/jit/emitriscv64.cpp b/src/coreclr/jit/emitriscv64.cpp
index c0c80413a33..eeecde93822 100644
--- a/src/coreclr/jit/emitriscv64.cpp
+++ b/src/coreclr/jit/emitriscv64.cpp
@@ -2249,6 +2249,34 @@ unsigned emitter::emitOutput_Instr(BYTE* dst, code_t code) const
 {
     assert(dst != nullptr);
     static_assert(sizeof(code_t) == 4, "code_t must be 4 bytes");
+
+    // Soft-float target (rv64ima, no F/D extension), opted in via "--codegenopt
+    // RiscVSoftFloat=1": the JIT still allocates FP registers and emits hardware
+    // floating-point instructions, so neutralize each one at encoding time by
+    // replacing it with a canonical NOP (addi x0, x0, 0). Floating-point results are
+    // intentionally left incorrect, but no FP instruction ever reaches a core that
+    // lacks an FPU. RISC-V reserves these major opcodes exclusively for the F/D/Q
+    // extensions, so matching on the low 7 bits is exact and touches nothing integer.
+    // Same 32-bit width, so code offsets and relocations are unaffected. Off by
+    // default, so hard-float targets keep upstream behavior.
+    if (JitConfig.RiscVSoftFloat() != 0)
+    {
+        switch (code & 0x7F)
+        {
+            case 0x07: // LOAD-FP   (flw, fld)
+            case 0x27: // STORE-FP  (fsw, fsd)
+            case 0x43: // MADD      (fmadd)
+            case 0x47: // MSUB      (fmsub)
+            case 0x4B: // NMSUB     (fnmsub)
+            case 0x4F: // NMADD     (fnmadd)
+            case 0x53: // OP-FP     (fadd, fmul, fcvt, fcmp, fmv, ...)
+                code = 0x00000013; // addi x0, x0, 0 == nop
+                break;
+            default:
+                break;
+        }
+    }
+
     memcpy(dst + writeableOffset, &code, sizeof(code));
     return sizeof(code_t);
 }
