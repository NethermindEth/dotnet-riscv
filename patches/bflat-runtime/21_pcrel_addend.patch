+
+            // RISC-V64 paired PC-relative data relocations cannot round-trip
+            // addends through the auipc U-imm (it can only encode values
+            // aligned to 4 KiB). Carry the addend explicitly via the
+            // Relocation record instead of patching it into the instruction.
+            int relocAddend = 0;
+            if (relocType == RelocType.IMAGE_REL_BASED_RISCV64_PCREL_HI20 ||
+                relocType == RelocType.IMAGE_REL_BASED_RISCV64_PCREL_LO12_I)
+            {
+                relocAddend = relocDelta;
+            }
+            else
+            {
+                // relocDelta is stored as the value
