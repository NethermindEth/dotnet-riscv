@@ -5,6 +5,26 @@
 
 #include <errno.h>
 
+#if defined(HOST_RISCV64) && !defined(RISCV64_USE_REAL_ATOMICS)
+// Patch 36 (zkVM): the RISC-V A-extension is pure overhead on the single-
+// threaded, deterministic zkVM and is unsupported by some zkVM targets, so the
+// PalInterlocked* helpers below collapse to plain load/modify/store. Analog of
+// the JIT-side RiscV64NoAtomics knob (patch 34). These macros are scoped to
+// this header's inline helpers and #undef'd right after, so nothing else in the
+// translation unit is affected. Define RISCV64_USE_REAL_ATOMICS to restore
+// stock atomics (required on real multi-hart hardware).
+template<typename T> FORCEINLINE T BflatNoAtomicSwap(T volatile* p, T v) { T o = *p; *p = v; return o; }
+template<typename T, typename U> FORCEINLINE T BflatNoAtomicCas(T volatile* p, U c, T v) { T o = *p; if (o == (T)c) *p = v; return o; }
+#define __sync_synchronize()                  ((void)0)
+#define __sync_add_and_fetch(p, v)            (*(p) += (v))
+#define __sync_sub_and_fetch(p, v)            (*(p) -= (v))
+#define __sync_or_and_fetch(p, v)             (*(p) |= (v))
+#define __sync_and_and_fetch(p, v)            (*(p) &= (v))
+#define __sync_swap(p, v)                     BflatNoAtomicSwap((p), (v))
+#define __atomic_exchange_n(p, v, m)          BflatNoAtomicSwap((p), (v))
+#define __sync_val_compare_and_swap(p, c, v)  BflatNoAtomicCas((p), (c), (v))
+#endif // HOST_RISCV64 && !RISCV64_USE_REAL_ATOMICS
+
 FORCEINLINE void PalInterlockedOperationBarrier()
 {
 #if (defined(HOST_ARM64) && !defined(LSE_INSTRUCTIONS_ENABLED_BY_DEFAULT) && !defined(__clang__)) || defined(HOST_LOONGARCH64) || defined(HOST_RISCV64)
@@ -117,6 +137,18 @@ FORCEINLINE uint8_t PalInterlockedCompareExchange128(_Inout_ int64_t volatile *p
 }
 #endif // HOST_64BIT
 
+#if defined(HOST_RISCV64) && !defined(RISCV64_USE_REAL_ATOMICS)
+// Patch 36: end of the collapsed-atomics scope (see top of file).
+#undef __sync_synchronize
+#undef __sync_add_and_fetch
+#undef __sync_sub_and_fetch
+#undef __sync_or_and_fetch
+#undef __sync_and_and_fetch
+#undef __sync_swap
+#undef __atomic_exchange_n
+#undef __sync_val_compare_and_swap
+#endif // HOST_RISCV64 && !RISCV64_USE_REAL_ATOMICS
+
 #ifdef HOST_64BIT
 
 #define PalInterlockedExchangePointer(_pDst, _pValue) \
