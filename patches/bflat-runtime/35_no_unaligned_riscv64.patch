+//------------------------------------------------------------------------
+// "No unaligned access" support.
+//
+// Some targets require every memory access to be naturally aligned (the executor
+// asserts addr % width == 0). Like on any unaligned-tolerant ISA, RyuJIT otherwise
+// emits a single wide ld/sd for accesses the front end flagged unaligned (Unsafe.Read/
+// WriteUnaligned, the `unaligned.` IL prefix, unrolled cpblk/initblk). When
+// JitNoUnalignedAccess is set we expand those into byte-wise sequences instead. The
+// knob is off by default, so targets that tolerate unaligned access are unaffected.
+//
+static bool genRiscV64NoUnalignedAccess()
+{
+    return JitConfig.JitNoUnalignedAccess() != 0;
+}
+
+// True for a scalar (non-struct) load/store wider than one byte that is flagged
+// unaligned and so, in no-unaligned mode, must be lowered to a byte-wise sequence.
+static bool genRiscV64ByteWiseUnaligned(GenTreeIndir* indir)
+{
+    return genRiscV64NoUnalignedAccess() && indir->IsUnaligned() && !indir->TypeIs(TYP_STRUCT) &&
+           (genTypeSize(indir->TypeGet()) > 1);
+}
