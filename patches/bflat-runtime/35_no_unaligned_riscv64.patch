+//------------------------------------------------------------------------
+// genRiscV64ByteWiseLoad: Emit a byte-by-byte load of `type` from [addrReg] into
+//   dstReg so that every memory access is a naturally-aligned single byte.
+//
+// Arguments:
+//   emit    - the emitter
+//   type    - the scalar type being loaded; size must be 2, 4 or 8
+//   dstReg  - destination register (integer or float)
+//   addrReg - register holding the base address (accessed at offsets 0..size-1)
+//   intTmp  - integer scratch for the byte being merged in
+//   intAcc  - integer accumulator: for a float load it is built up and then moved
+//             into dstReg; for an integer load pass dstReg itself
+//
+static void genRiscV64ByteWiseLoad(
+    emitter* emit, var_types type, regNumber dstReg, regNumber addrReg, regNumber intTmp, regNumber intAcc)
+{
+    const unsigned size       = genTypeSize(type);
+    const bool     isFloat    = varTypeIsFloating(type);
+    const bool     isUnsigned = varTypeIsUnsigned(type);
+    assert((size == 2) || (size == 4) || (size == 8));
+    assert(intAcc != REG_NA);
 
+    // Low byte: always zero-extended; the OR chain fills the bytes above it.
+    emit->emitIns_R_R_I(INS_lbu, EA_PTRSIZE, intAcc, addrReg, 0);
+
+    for (unsigned i = 1; i < size; i++)
+    {
+        // The most-significant byte of a signed sub-word integer load is sign-extended
+        // so the value matches a native lh/lw; every other byte (and all bytes of an
+        // unsigned or float load) is zero-extended.
+        instruction lbIns = (!isFloat && !isUnsigned && (i == size - 1)) ? INS_lb : INS_lbu;
+        emit->emitIns_R_R_I(lbIns, EA_PTRSIZE, intTmp, addrReg, (int)i);
+        emit->emitIns_R_R_I(INS_slli, EA_PTRSIZE, intTmp, intTmp, (int)(i * 8));
+        emit->emitIns_R_R_R(INS_or, EA_PTRSIZE, intAcc, intAcc, intTmp);
+    }
+
+    if (isFloat)
+    {
+        emit->emitIns_R_R((size == 4) ? INS_fmv_w_x : INS_fmv_d_x, EA_ATTR(size), dstReg, intAcc);
+    }
+}
+
+//------------------------------------------------------------------------
+// genRiscV64ByteWiseStore: Emit a byte-by-byte store of `type` from dataReg to
+//   [addrReg] so that every memory access is a naturally-aligned single byte.
+//
+// Arguments:
+//   emit    - the emitter
+//   type    - the scalar type being stored; size must be 2, 4 or 8
+//   dataReg - source register holding the value (integer/float, or REG_R0 for a
+//             contained integer zero)
+//   addrReg - register holding the base address (accessed at offsets 0..size-1)
+//   intTmp  - integer scratch; for a float store it receives the bit pattern and is
+//             then shifted down in place
+//
+static void genRiscV64ByteWiseStore(
+    emitter* emit, var_types type, regNumber dataReg, regNumber addrReg, regNumber intTmp)
+{
+    const unsigned size    = genTypeSize(type);
+    const bool     isFloat = varTypeIsFloating(type);
+    assert((size == 2) || (size == 4) || (size == 8));
+
+    regNumber bits; // integer register whose low bytes are spilled one at a time
+    if (isFloat)
+    {
+        emit->emitIns_R_R((size == 4) ? INS_fmv_x_w : INS_fmv_x_d, EA_ATTR(size), intTmp, dataReg);
+        bits = intTmp; // a private copy: safe to shift down in place
+    }
+    else
+    {
+        bits = dataReg; // a live operand: must not be clobbered, so shift into intTmp
+    }
+
+    emit->emitIns_R_R_I(INS_sb, EA_PTRSIZE, bits, addrReg, 0);
+    for (unsigned i = 1; i < size; i++)
+    {
+        if (isFloat)
+        {
+            emit->emitIns_R_R_I(INS_srli, EA_PTRSIZE, bits, bits, 8);
+            emit->emitIns_R_R_I(INS_sb, EA_PTRSIZE, bits, addrReg, (int)i);
+        }
+        else
+        {
+            emit->emitIns_R_R_I(INS_srli, EA_PTRSIZE, intTmp, bits, (int)(i * 8));
+            emit->emitIns_R_R_I(INS_sb, EA_PTRSIZE, intTmp, addrReg, (int)i);
+        }
+    }
+}
