+using System.Runtime.InteropServices;
+using System.Runtime.CompilerServices;
+
+namespace System.Runtime
+{
+    /// <summary>
+    /// Reliable logging for GVM debugging that works in all build configurations.
+    /// Uses direct P/Invoke to fprintf from __Internal - guaranteed to never be optimized away.
+    /// </summary>
+    internal static class GvmDebugLog
+    {
+        // Direct P/Invoke to fprintf from __Internal
+        // __Internal is a special library name that refers to symbols in the current executable
+        // fprintf is provided by libc and linked into every binary
+        [DllImport("__Internal", EntryPoint = "fprintf", CallingConvention = CallingConvention.Cdecl)]
+        private static extern int fprintf(int fd, string format, string message);
+
+        // stderr file descriptor = 2
+        private const int STDERR_FILENO = 2;
+
+        /// <summary>
+        /// Log a simple message to stderr
+        /// </summary>
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        public static void Log(string message)
+        {
+            try
+            {
+                fprintf(STDERR_FILENO, "%s\n", message);
+            }
+            catch
+            {
+                // Ignore any errors - we're in a critical logging path
+            }
+        }
+
+        /// <summary>
+        /// Log a formatted message with one argument
+        /// </summary>
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        public static void Log(string format, object arg1)
+        {
+            try
+            {
+                string message = string.Format(format, arg1);
+                fprintf(STDERR_FILENO, "%s\n", message);
+            }
+            catch
+            {
+                // Ignore any errors
+            }
+        }
+
+        /// <summary>
+        /// Log a formatted message with two arguments
+        /// </summary>
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        public static void Log(string format, object arg1, object arg2)
+        {
+            try
+            {
+                string message = string.Format(format, arg1, arg2);
+                fprintf(STDERR_FILENO, "%s\n", message);
+            }
+            catch
+            {
+                // Ignore any errors
+            }
+        }
+
+        /// <summary>
+        /// Log a formatted message with three arguments
+        /// </summary>
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        public static void Log(string format, object arg1, object arg2, object arg3)
+        {
+            try
+            {
+                string message = string.Format(format, arg1, arg2, arg3);
+                fprintf(STDERR_FILENO, "%s\n", message);
+            }
+            catch
+            {
+                // Ignore any errors
+            }
+        }
+
+        /// <summary>
+        /// Log a formatted message with four arguments
+        /// </summary>
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        public static void Log(string format, object arg1, object arg2, object arg3, object arg4)
+        {
+            try
+            {
+                string message = string.Format(format, arg1, arg2, arg3, arg4);
+                fprintf(STDERR_FILENO, "%s\n", message);
+            }
+            catch
+            {
+                // Ignore any errors
+            }
+        }
+
+        /// <summary>
+        /// Log a formatted message with variable arguments
+        /// </summary>
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        public static void Log(string format, params object[] args)
+        {
+            try
+            {
+                string message = string.Format(format, args);
+                fprintf(STDERR_FILENO, "%s\n", message);
+            }
+            catch
+            {
+                // Ignore any errors
+            }
+        }
+
+        /// <summary>
+        /// Convenience method for logging with hex address
+        /// </summary>
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        public static void LogAddress(string prefix, IntPtr address)
+        {
+            try
+            {
+                string message = $"{prefix}0x{address.ToInt64():X}";
+                fprintf(STDERR_FILENO, "%s\n", message);
+            }
+            catch
+            {
+                // Ignore any errors
+            }
+        }
+
+        /// <summary>
+        /// Convenience method for logging with two hex addresses
+        /// </summary>
+        [MethodImpl(MethodImplOptions.AggressiveInlining)]
+        public static void LogAddresses(string prefix, IntPtr addr1, IntPtr addr2)
+        {
+            try
+            {
+                string message = $"{prefix}0x{addr1.ToInt64():X}, 0x{addr2.ToInt64():X}";
+                fprintf(STDERR_FILENO, "%s\n", message);
+            }
+            catch
+            {
+                // Ignore any errors
+            }
+        }
+    }
+}
