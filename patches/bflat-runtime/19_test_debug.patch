+                        GvmDebugLog.Log($"[GVMLookupSlow]   Context (MethodTable)=0x{context:X}");
+                        GvmDebugLog.Log($"[GVMLookupSlow]   Signature (Slot)=0x{signature:X}");
+
+                        IntPtr result = RuntimeAugments.TypeLoaderCallbacks.ResolveGenericVirtualMethodTarget(
+                            new RuntimeTypeHandle((MethodTable*)context),
