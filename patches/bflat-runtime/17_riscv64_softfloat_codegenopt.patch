       <IlcArg Condition="$(Optimize) == 'true' and $(OptimizationPreference) == 'Speed'" Include="--Ot" />
       <IlcArg Condition="'$(_linuxLibcFlavor)' == 'bionic'" Include="--noinlinetls" />
       <IlcArg Condition="$(IlcInstructionSet) != ''" Include="--instruction-set:$(IlcInstructionSet)" />
+      <!-- Soft-float RISC-V toolchain (rv64ima, no FPU): tag output with the soft-float
+           ABI and neutralize emitted FP instructions. Gated on the target arch so other
+           architectures are untouched; the JIT/object-writer knob itself is off by
+           default upstream, so this only takes effect in this soft-float toolchain. -->
+      <IlcArg Condition="'$(_targetArchitecture)' == 'riscv64'" Include="--codegenopt:RiscVSoftFloat=1" />
       <IlcArg Condition="$(IlcMaxVectorTBitWidth) != ''" Include="--max-vectort-bitwidth:$(IlcMaxVectorTBitWidth)" />
